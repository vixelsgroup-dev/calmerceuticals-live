    "section_press_XDkeQa": {
      "type": "section-press",
      "blocks": {
        "press_K4qJrW": {
          "type": "press",
          "settings": {
            "text": "<p>Shoppers are racing to buy Aussie collagen brand Calmerceuticals that sells one every minute</p>",
            "link": "",
            "press_logo": "shopify://shop_images/7NEWS_Logo.webp",
            "logo_width": 140
          }
        },
        "press_iEwcUz": {
          "type": "press",
          "settings": {
            "text": "<p>Calmerceuticals Marine Collagen Peptides set a new standard in beauty supplements! The results are actually amazing! </p>",
            "link": "",
            "press_logo": "shopify://shop_images/vogue-logo_4147a4fa-cb88-4ae0-b381-f072300da313.png",
            "logo_width": 140
          }
        },
        "press_WFkrjF": {
          "type": "press",
          "settings": {
            "text": "<p>Proudly Australian-made, this clinically proven marine hydrolysed liquid collagen is formulated to enhance skin, reduce wrinkles, and strengthen hair and nails for visible results.</p>",
            "link": "https://7news.com.au/best-picks/shoppers-are-racing-to-buy-aussie-collagen-brand-calmerceuticals-that-sells-one-every-minute-c-19098450",
            "press_logo": "shopify://shop_images/womans_day.webp",
            "logo_width": 140
          }
        },
        "press_NUBDJT": {
          "type": "press",
          "settings": {
            "text": "<p>Calmerceuticals impressed us with its advanced collagen formula. The results speak for themselves.</p>",
            "link": "https://www.marieclaire.com.au/beauty/calmerceuticals-liquid-collagen/",
            "press_logo": "shopify://shop_images/marie_claire-logo.png",
            "logo_width": 140
          }
        },
        "press_jBBUbP": {
          "type": "press",
          "settings": {
            "text": "<p>The supplement industry didn’t see her coming: Now they’re scrambling to catch up!</p>",
            "link": "https://www.forbes.com.au/brand-voice/brandvoice/rose-rayner-of-calmerceuticals-on-changing-the-future-of-beauty/",
            "press_logo": "shopify://shop_images/forbes-logo-calmerceuticals-collab.png",
            "logo_width": 140
          }
        },
        "press_PdCY3b": {
          "type": "press",
          "settings": {
            "text": "<p>Calmerceuticals was founded with the goal of bridging the gap between scientific research and natural wellness</p>",
            "link": "https://retailbeauty.com.au/pericalm-by-calmerceuticals/",
            "press_logo": "shopify://shop_images/retail_beauty_Logo_RED_RGB.webp",
            "logo_width": 140
          }
        },
        "press_zXtTNH": {
          "type": "press",
          "settings": {
            "text": "<p>Calmerceuticals brings a luxurious touch to wellness, with a collagen formula that leaves skin radiant and rejuvenated.</p>",
            "link": "",
            "press_logo": "shopify://shop_images/vanity_fair-logo.png",
            "logo_width": 140
          }
        }
