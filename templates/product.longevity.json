    "magic_science_g69gE4": {
      "type": "magic-science",
      "blocks": {
        "body_block_rANjpC": {
          "type": "body_block",
          "disabled": true,
          "settings": {
            "bold_line": "Ageing is driven by a process called Inflammageing.",
            "body_text": "<p>When our bodies are under constant stress, they produce chronic, low-grade inflammation that never fully turns off.</p><p>That \"biological fire\" is largely responsible for the cognitive dullness, metabolic resistance, and persistent fatigue we often mistake for \"just getting older\".</p>"
          }
        },
        "accent_line_iqtpxw": {
          "type": "accent_line",
          "settings": {
            "text": "Ageing is driven by a process called Inflammageing.",
            "accordion_body": "<p>When our bodies are under constant stress, they produce chronic, low-grade inflammation that never fully turns off.</p><p>That \"biological fire\" is largely responsible for the cognitive dullness, metabolic resistance, and persistent fatigue we often mistake for \"just getting older\".</p>"
          }
        },
        "accent_line_tbrUgJ": {
          "type": "accent_line",
          "settings": {
            "text": "Ageing cells suffer from Mitochondrial Decay.",
            "accordion_body": "<p>As these \"cellular batteries\" wear out, they stop producing energy and start producing \"cellular rust\" (oxidative stress). This decay is the primary reason your \"Health Span\" feels shorter than your actual years, leading to a body that performs below its potential.</p>"
          }
        },
        "accent_line_Ffkf68": {
          "type": "accent_line",
          "settings": {
            "text": "Persistent low energy is a byproduct of Metabolic Ageing.",
            "accordion_body": "<p>A \"metabolically old\" system accumulates specific markers like BCAAs and Lysine, which are linked to systemic resistance and inflammation. By lowering these metabolic signatures and doubling your production of Short-Chain Fatty Acids (SCFAs), we provide the clean cellular fuel required for the sustained vitality of a younger body.</p>"
          }
        }
      },
