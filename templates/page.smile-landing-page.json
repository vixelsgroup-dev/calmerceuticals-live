    "section_custom_html_GMniA8": {
      "type": "section-custom-html",
      "disabled": true,
      "custom_css": [],
      "name": "Custom code",
      "settings": {
        "custom_code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>VIP Rewards Tier Structure</title>\n    <!-- Load Tailwind CSS -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Define the custom color variable for easy use */\n        .header-bg {\n            background-color: #610C27; /* Dark Maroon/Burgundy */\n        }\n        /* Custom dot color updated to the requested dark maroon */\n        .perk-dot {\n            color: #610C27; /* Requested dark maroon color */\n            font-size: 0.8rem; /* Reduced size */\n            line-height: 1;\n        }\n        .text-custom-white {\n            color: #ffffff;\n        }\n        /* Removed rounded corners for sharp edges */\n        .sharp-corners {\n            border-radius: 0; \n        }\n    </style>\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Inter', 'sans-serif'],\n                    },\n                }\n            }\n        }\n    </script>\n</head>\n<body class=\"bg-gray-50 p-4 sm:p-8 font-sans\">\n\n    <div class=\"max-w-6xl mx-auto bg-white shadow-2xl overflow-hidden sharp-corners\">\n        <!-- Main Responsive Table -->\n        <!-- The overflow-x-auto wrapper ensures horizontal scrolling on mobile, keeping all columns visible -->\n        <div class=\"overflow-x-auto\">\n            <table class=\"min-w-full divide-y divide-gray-200 border-collapse sharp-corners\">\n                <!-- Table Header (Tier Names and Spend Requirements) -->\n                <thead class=\"header-bg text-custom-white\">\n                    <tr>\n                        <!-- Corner cell - NOW CONTAINS THE TEXT \"PERK\" -->\n                        <th class=\"py-4 px-3 sm:px-6 sharp-corners text-center text-sm font-extrabold uppercase tracking-wider bg-transparent\">\n                            <div class=\"text-lg\">PERK</div>\n                        </th>\n\n                        <!-- Bronze Tier -->\n                        <th class=\"py-4 px-3 sm:px-6 text-center text-sm font-extrabold uppercase tracking-wider sharp-corners\">\n                            <div class=\"text-lg\">BRONZE</div>\n                            <div class=\"text-xs font-bold opacity-80 mt-1\">Account Holders</div>\n                        </th>\n\n                        <!-- Silver Tier -->\n                        <th class=\"py-4 px-3 sm:px-6 text-center text-sm font-extrabold uppercase tracking-wider sharp-corners\">\n                            <div class=\"text-lg\">SILVER</div>\n                            <div class=\"text-xs font-bold opacity-80 mt-1\">Spend $200 - $499</div>\n                        </th>\n\n                        <!-- Gold Tier -->\n                        <th class=\"py-4 px-3 sm:px-6 text-center text-sm font-extrabold uppercase tracking-wider sharp-corners\">\n                            <div class=\"text-lg\">GOLD</div>\n                            <div class=\"text-xs font-bold opacity-80 mt-1\">Spend $500 - $999</div>\n                        </th>\n\n                        <!-- Platinum Tier -->\n                        <th class=\"py-4 px-3 sm:px-6 text-center text-sm font-extrabold uppercase tracking-wider sharp-corners\">\n                            <div class=\"text-lg\">PLATINUM (VIP)</div>\n                            <div class=\"text-xs font-bold opacity-80 mt-1\">Spend $1000+</div>\n                        </th>\n                    </tr>\n                </thead>\n                \n                <!-- Table Body (The Rewards/Multipliers) -->\n                <tbody class=\"bg-white divide-y divide-gray-100\">\n                    <!-- Row 1: Points Multiplier (content is bold) -->\n                    <tr class=\"hover:bg-gray-50 transition duration-150\">\n                        <!-- Perk Name Column -->\n                        <td class=\"py-4 px-3 sm:px-6 font-bold text-gray-800 whitespace-nowrap text-center\">POINTS MULTIPLIER</td>\n                        \n                        <!-- Tier Content -->\n                        <td class=\"py-4 px-3 sm:px-6 text-center text-gray-600 whitespace-nowrap font-bold\">1x</td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center text-gray-600 whitespace-nowrap font-bold\">1x</td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center text-gray-600 whitespace-nowrap font-bold\">2x</td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center text-gray-600 whitespace-nowrap font-bold\">2x</td>\n                    </tr>\n                    \n                    <!-- Row 2: Birthday Bonus (title is bold) -->\n                    <tr class=\"bg-gray-50 hover:bg-gray-100 transition duration-150\">\n                        <!-- Perk Name Column -->\n                        <td class=\"py-4 px-3 sm:px-6 font-bold text-gray-800 whitespace-nowrap text-center\">BIRTHDAY BONUS</td>\n                        \n                        <!-- Tier Content -->\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                    </tr>\n\n                    <!-- Row 3: Early Access to Sales (title is bold) -->\n                    <tr class=\"hover:bg-gray-50 transition duration-150\">\n                        <!-- Perk Name Column -->\n                        <td class=\"py-4 px-3 sm:px-6 font-bold text-gray-800 whitespace-nowrap text-center\">EARLY ACCESS TO SALES</td>\n                        \n                        <!-- Tier Content -->\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                    </tr>\n\n                    <!-- Row 4: Complementary Samples (title is bold) -->\n                    <tr class=\"bg-gray-50 hover:bg-gray-100 transition duration-150\">\n                        <!-- Perk Name Column -->\n                        <td class=\"py-4 px-3 sm:px-6 font-bold text-gray-800 whitespace-nowrap text-center\">COMPLEMENTARY SAMPLES</td>\n                        \n                        <!-- Tier Content -->\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                    </tr>\n\n                    <!-- Row 5: Complementary Gifts (title is bold) -->\n                    <tr class=\"hover:bg-gray-50 transition duration-150\">\n                        <!-- Perk Name Column -->\n                        <td class=\"py-4 px-3 sm:px-6 font-bold text-gray-800 whitespace-nowrap text-center\">COMPLEMENTARY GIFTS</td>\n                        \n                        <!-- Tier Content -->\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                    </tr>\n\n                    <!-- Row 6: Exclusive Launches (title is bold) -->\n                    <tr class=\"bg-gray-50 hover:bg-gray-100 transition duration-150\">\n                        <!-- Perk Name Column -->\n                        <td class=\"py-4 px-3 sm:px-6 font-bold text-gray-800 whitespace-nowrap text-center\">EXCLUSIVE LAUNCHES</td>\n                        \n                        <!-- Tier Content -->\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"></td>\n                        <td class=\"py-4 px-3 sm:px-6 text-center\"><span class=\"perk-dot\">&#9899;</span></td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </div>\n</body>\n</html>",
        "width": "wrapper",
        "padding_top": 60,
        "padding_bottom": 60
      }
    },
