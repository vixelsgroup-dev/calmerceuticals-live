          "type": "product_accordion",
          "settings": {
            "show_description": false,
            "show_read_more": true,
            "open_by_default": false,
            "enable_full_width": false,
            "tabs_bg_color": "",
            "show_accordion_divider": false,
            "line_thickness": "normal",
            "accordion_heading": "How To Use",
            "heading_style": "font-heading",
            "accordion_text": "<p><strong>Step 1: Open the Packet</strong><br/>Tear open the sachet and remove the mask. Carefully peel off the protective film.</p><p><strong>Step 2: Apply the Mask</strong><br/>Place the textured side onto your face, aligning it with your eyes and mouth. Smooth the mask to ensure it fits snugly and evenly across your skin.</p><p><strong>Step 3: Relax and Absorb</strong><br/>Leave the mask on for up to 60 minutes. As the active ingredients absorb, the mask will gradually turn transparent, indicating its full effect.</p><p><strong>Step 4: Remove and Glow</strong><br/>Once the mask is fully transparent, gently peel it off. No need to rinse, simply follow with your usual skincare routine for a hydrated, radiant finish.</p>",
            "accordion_page": "",
            "padding_bottom": 20
          }
        },
