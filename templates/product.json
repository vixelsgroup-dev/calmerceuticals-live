    "section_accordions_cDQjAT": {
      "type": "section-accordions",
      "blocks": {
        "text_64LGnk": {
          "type": "text",
          "settings": {
            "title": "How long does it take to see results?",
            "text": "<p>Most men notice improved focus and energy within a few weeks. Clinically measured results on testosterone, stamina, and libido are typically seen after 12 weeks of consistent use.<br/><br/><br/><br/></p>"
          }
        },
        "text_iMKncn": {
          "type": "text",
          "settings": {
            "title": "Can I take Ultra Performance with other supplements or pre-workouts?",
            "text": "<p>Yes - it’s designed to complement most daily vitamins and fitness supplements. If you’re on prescription medication or under medical supervision, consult your healthcare professional first.</p>"
          }
        },
        "text_3NW7Ac": {
          "type": "text",
          "settings": {
            "title": "Is it safe for everyday use?",
            "text": "<p>Absolutely. Ultra Performance uses clinically validated ingredients at safe, effective doses and contains no synthetic hormones or banned substances.</p>"
          }
        },
        "text_dEdMFM": {
          "type": "text",
          "settings": {
            "title": "Who is Ultra Performance for?",
            "text": "<p>It’s made for men who want to increase energy, stamina, and mental focus, improve recovery, and support long-term performance and vitality - whether for the gym, work, or everyday life.<br/><br/></p>"
          }
        },
        "text_bpXTYm": {
          "type": "text",
          "settings": {
            "title": "What makes Ultra Performance different from other supplements?",
            "text": "<p>Unlike pills or injectables that target only one area, Ultra Performance is a precision-engineered vitality system. It works on a cellular level to support real biological change - improving testosterone balance, energy, focus, and recovery without synthetic hormones.<br/><br/></p>"
          }
        },
        "text_bjYVMr": {
          "type": "text",
          "settings": {
            "title": "Does Ultra Performance contain caffeine or stimulants?",
            "text": "<p>It includes a small amount of natural caffeine from green coffee and guarana extracts - enough to enhance focus and energy without jitters or crashes.<br/><br/></p>"
          }
        }
      },
