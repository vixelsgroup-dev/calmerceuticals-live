            "show_accordion_divider": false,
            "line_thickness": "normal",
            "accordion_heading": "How To Use",
            "heading_style": "font-heading",
            "accordion_text": "<h3><strong>Recommended Usage</strong></h3><p><strong>Take whenever:</strong> One sachet every day is all you need!<br/><br/><strong>Consistency Matters:</strong> It is recommended to stick to minimum 4-6 weeks and continue with daily use to experience Verisol enhanced benefits.</p>",
            "accordion_page": "",
