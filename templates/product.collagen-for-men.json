    "reviews_grid_8H66nA": {
      "type": "reviews-grid",
      "blocks": {
        "review_Qecwhm": {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "<p>“I’ll admit I was a bit hesitant about the ‘liquid’ format at first, but it’s way more convenient than dealing with clumpy powders. After about three weeks, I actually noticed my face looks less ‘tired’ in the mornings. It’s become a part of my gym routine now.”</p>",
            "name": "Mark T. (Austin, TX)"
          }
        },
        "review_EDmF7D": {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "<p>“I’ve tried a few collagen brands to help with my hair thinning, but this is the first one where I’ve actually seen a difference in the thickness. The mango/mandarin flavor is surprisingly good—no weird fishy aftertaste at all. Definitely worth the subscription.”</p>",
            "name": "Neil (San Francisco, CA)"
          }
        },
        "review_tM4fXk": {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "<p>“As someone who spends a lot of time outdoors, my skin was starting to look pretty weathered. A friend recommended Calmerceuticals, and the hydration boost is real. My skin feels smoother, and even some of the deeper lines around my eyes seem less noticeable. Highly recommend.”</p>",
            "name": "Chris R. (San Diego, CA)"
          }
        },
        "review_t6GmRM": {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "<p>“Finally, a supplement that doesn’t feel like a chore to take. I just grab a sachet on my way out the door. I’ve noticed my recovery after workouts feels a bit better, and my nails are growing like crazy. It’s a premium price, but the results actually back it up.”</p>",
            "name": "Jason M. (Miami, FL)"
          }
        }
      },
      "block_order": [
        "review_Qecwhm",
        "review_EDmF7D",
        "review_tM4fXk",
        "review_t6GmRM"
      ],
