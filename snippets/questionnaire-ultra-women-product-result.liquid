{%- comment -%}
  Ultra Performance (Women) — gut-axis path. CTA URL: JS matches gender answer to `data-gender-product-url-ultra` on the gender step (same pattern as collagen + `data-option-url`).
{%- endcomment -%}
<article
  class="questionnaire__screen questionnaire__screen--product-result questionnaire__screen--product-result-ultra-women"
  data-questionnaire-screen
  data-screen-type="product_result"
  data-default-url="{{ shop_now_url | escape }}"
  {% if branch_parent != blank %}
    data-branch-parent="{{ branch_parent | escape }}"
  {% endif %}
  {% if branch_trigger != blank %}
    data-branch-trigger="{{ branch_trigger | escape }}"
  {% endif %}
>
  <div class="questionnaire__product-stage questionnaire__product-stage--ultra-women">
    <div class="questionnaire__product-card questionnaire__product-card--ultra-women">
      <div class="questionnaire__product-badge questionnaire__product-badge--ultra-women">Recommended for you</div>

      <div class="questionnaire__product-media questionnaire__product-media--ultra-women">
        <img
          class="questionnaire__product-img questionnaire__product-img--ultra-women"
          src="{{ 'questionnaire-ultra-performance-product.png' | asset_url }}"
          alt="Ultra Performance for Women"
          width="460"
          height="460"
          decoding="async"
          fetchpriority="high"
          loading="eager"
        >
      </div>

      <div class="questionnaire__product-banner questionnaire__product-banner--ultra-women">
        <div class="questionnaire__product-banner-text questionnaire__product-banner-text--ultra-women">
          <p class="questionnaire__product-banner-primary questionnaire__product-banner-primary--ultra-women">
            See results in 180 days
          </p>
          <p class="questionnaire__product-banner-secondary questionnaire__product-banner-secondary--ultra-women">
            or your money back
          </p>
        </div>
      </div>

      <div class="questionnaire__product-body questionnaire__product-body--ultra-women">
        <div class="questionnaire__product-body-inner questionnaire__product-body-inner--ultra-women">
          <h2 class="questionnaire__product-title questionnaire__product-title--ultra-women">
            Ultra Performance for Women
          </h2>

          <div class="questionnaire__product-lead questionnaire__product-lead--ultra-women">
            <p>
              Based on your concern about low energy and stamina, here is the formula for smooth, sustained energy every
              day.
            </p>
          </div>

          <p class="questionnaire__product-detail questionnaire__product-detail--ultra-women">
            Formulated with Cultavit® B-Complex + Shilajit to support energy metabolism at a cellular level, with
            L-Theanine for calm, composed focus. Clinically studied to reduce fatigue by 26% in 28 days. Supports steady
            all-day energy without stimulants. Liquid sachet — no water, no pills.
          </p>
        </div>
      </div>

      <div class="questionnaire__product-price-row questionnaire__product-price-row--ultra-women">
        <span class="questionnaire__product-plan questionnaire__product-plan--ultra-women"
          >12-Week Performance Reset</span
        >
        <div class="questionnaire__product-prices questionnaire__product-prices--ultra-women">
          <span class="questionnaire__product-price-compare questionnaire__product-price-compare--ultra-women"
            >$686.00</span
          >
          <span class="questionnaire__product-price-sale questionnaire__product-price-sale--ultra-women">$447.00</span>
        </div>
      </div>

      <div class="questionnaire__product-cta-wrap questionnaire__product-cta-wrap--ultra-women">
        <a
          class="questionnaire__product-cta questionnaire__product-cta--ultra-women"
          href="{{ shop_now_url | escape }}"
          data-questionnaire-product-cta
          >SHOP NOW</a
        >
      </div>
    </div>
  </div>
</article>
