<div class="video-section-header">
  <h3 class="program-cards__heading">See It In Action</h3>
</div>

<div class="product-video-slider">
  <div class="swiper videoSwiper">
    <div class="swiper-wrapper">
      {% for inner_block in section.blocks %}
        {% if inner_block.type == 'product_video' %}
          {% assign p = all_products[inner_block.settings.product] %}

          <div class="swiper-slide">
            <div
              class="video-item"
              data-video="{{ inner_block.settings.video.sources[0].url }}"
              data-title="{{ p.title }}"
              data-price="{{ p.price | money }}"
              data-image="{{ p.featured_image | image_url: width: 400 }}"
              data-url="{{ p.url }}"
            >
              <div class="video-card">
                {{ inner_block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
              </div>
            </div>
          </div>

        {% endif %}
      {% endfor %}
    </div>

    <div class="swiper-button-next">
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true"><path d="M7.797 16.664.648 9.204A1.071 1.071 0 0 1 .375 8.5c0-.195.078-.43.234-.625L7.758.415a.932.932 0 0 1 1.328-.04c.39.352.39.938.039 1.328L2.602 8.5l6.562 6.875a.932.932 0 0 1-.039 1.328.932.932 0 0 1-1.328-.039Z" fill="#090A0B"></path></svg>
    </div>
    <div class="swiper-button-prev">
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true"><path d="M7.797 16.664.648 9.204A1.071 1.071 0 0 1 .375 8.5c0-.195.078-.43.234-.625L7.758.415a.932.932 0 0 1 1.328-.04c.39.352.39.938.039 1.328L2.602 8.5l6.562 6.875a.932.932 0 0 1-.039 1.328.932.932 0 0 1-1.328-.039Z" fill="#090A0B"></path></svg>
    </div>
  </div>
</div>

<div id="videoDrawer" class="video-drawer">
  <div class="drawer-inner">
    <div class="drawer-close">✕</div>

    <video id="drawerVideo" autoplay playsinline muted loop></video>

    <div class="mute-btn" id="muteToggle">🔊</div>

    <div class="product-overlay">
      <div class="product-card">
        <img id="drawerImage" />
        <div class="product-info">
          <h4 id="drawerTitle"></h4>
          <p id="drawerPrice"></p>
          <a id="drawerLink" class="shop-btn">Shop Now</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .product-video-slider .swiper-slide{
        max-width: max-content;
  }
.video-section-header {
  margin-bottom: 18px;
}

.video-section-header p {
  font-size: 14px;
  color: #666;
  margin-top: 6px;
}

.video-card {
  position: relative;
  width: 100%;
  aspect-ratio: 2/3;
  border-radius: 16px;
  overflow: hidden;
  background: #000;
  cursor: pointer;
}

.video-card video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
}

.video-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.25), transparent 40%);
}

.swiper-button-next,
.swiper-button-prev {
  color: #111;
  transform: scale(0.8);
}

.video-drawer {
  position: fixed;
  bottom: 30px;
  right: -100%;
  width: 369px;
  height: 100%;
  max-height: 66vh;
  background: #000;
  z-index: 9999;
  border-radius: 10px;
  overflow: hidden;
  transition: all 0.4s ease;
  box-shadow: 0 20px 60px rgba(0,0,0,0.4);
}

.video-drawer.active {
  right: 30px;
}

#drawerVideo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  z-index: 1;
}

.drawer-close {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 36px;
  height: 36px;
 background: rgba(255, 255, 255, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  cursor: pointer;
  z-index: 3;
  backdrop-filter: blur(6px);
}

.mute-btn {
  position: absolute;
  bottom: 140px;
  right: 14px;
  background: rgba(255, 255, 255, 0.55);
  color: #fff;
  padding: 10px;
  border-radius: 50%;
  cursor: pointer;
  z-index: 3;
  backdrop-filter: blur(6px);
      display: flex;
}

.product-overlay {
  position: absolute;
  bottom: 18px;
  left: 50%;
  transform: translateX(-50%);
  width: 92%;
  z-index: 3;
}

.product-card {
  display: flex;
  gap: 12px;
  padding: 0px;
  border-radius: 10px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(5px);
  box-shadow: 0 8px 30px rgba(0,0,0,0.2);
}

.product-card img {
  width: 64px;
  height: auto;
  object-fit: cover;
}

.product-info {
  flex: 1;
      padding: 16px 6px;
}

.product-info h4 {
  font-size: 14px;
  font-weight: 600;
  margin: 0;
  color: #111;
}

.product-info p {
  font-size: 13px;
  margin: 4px 0 6px;
  color: #555;
}

.shop-btn {
    position: absolute;
    bottom: 10px;
    right: 10px;
    z-index: 1;
  display: inline-block;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 8px;
  background: #111;
  color: #fff;
  text-decoration: none;
}
.product-video-slider {
    margin-bottom: 24px;
}
.video-item {
    border: 1px solid black;
    border-radius: 16px;
    padding: 2px;
}
.swiper-button-next:after, .swiper-rtl .swiper-button-prev:after,
.swiper-button-prev:after, .swiper-rtl .swiper-button-next:after{
    display: none !important;
}
.swiper-button-next svg {
    transform: rotate(180deg);
}
#muteToggle svg {
    width: 22px;
    height: 22px;
}
@media (max-width: 768px) {
  .video-drawer {
    width: 100%;
    max-height: 80vh;
    right: -100%;
    bottom: 10px;
  }

  .video-drawer.active {
    right: 0%;
  }

  .video-section-header h2 {
    font-size: 22px;
  }
}
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  // Initialize Swiper
  const swiper = new Swiper('.videoSwiper', {
    slidesPerView: 6.2,
    spaceBetween: 12,
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    breakpoints: {
      0: { slidesPerView: 3.2 },
      768: { slidesPerView: 4.2 },
      1024: { slidesPerView: 6.2 }
    },
    on: {
      slideChange: stopAllVideos
    }
  });

  // Drawer elements
  const drawer = document.getElementById('videoDrawer');
  const drawerVideo = document.getElementById('drawerVideo');
  const title = document.getElementById('drawerTitle');
  const price = document.getElementById('drawerPrice');
  const image = document.getElementById('drawerImage');
  const link = document.getElementById('drawerLink');
  const muteBtn = document.getElementById('muteToggle');

  // SVG icons for mute/unmute
  const muteSVG = `<svg xmlns="http://www.w3.org/2000/svg" fill="#000000" width="800px" height="800px" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 3.75a.75.75 0 00-1.255-.555L5.46 8H2.75A1.75 1.75 0 001 9.75v4.5c0 .966.784 1.75 1.75 1.75h2.71l5.285 4.805A.75.75 0 0012 20.25V3.75zM6.255 9.305l4.245-3.86v13.11l-4.245-3.86a.75.75 0 00-.505-.195h-3a.25.25 0 01-.25-.25v-4.5a.25.25 0 01.25-.25h3a.75.75 0 00.505-.195z"/><path d="M16.28 8.22a.75.75 0 10-1.06 1.06L17.94 12l-2.72 2.72a.75.75 0 101.06 1.06L19 13.06l2.72 2.72a.75.75 0 101.06-1.06L20.06 12l2.72-2.72a.75.75 0 00-1.06-1.06L19 10.94l-2.72-2.72z"/></svg>`;

  const unmuteSVG = `<svg xmlns="http://www.w3.org/2000/svg" fill="#000000" width="800px" height="800px" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M11.553 3.064A.75.75 0 0112 3.75v16.5a.75.75 0 01-1.255.555L5.46 16H2.75A1.75 1.75 0 011 14.25v-4.5C1 8.784 1.784 8 2.75 8h2.71l5.285-4.805a.75.75 0 01.808-.13zM10.5 5.445l-4.245 3.86a.75.75 0 01-.505.195h-3a.25.25 0 00-.25.25v4.5c0 .138.112.25.25.25h3a.75.75 0 01.505.195l4.245 3.86V5.445z"/><path d="M18.718 4.222a.75.75 0 011.06 0c4.296 4.296 4.296 11.26 0 15.556a.75.75 0 01-1.06-1.06 9.5 9.5 0 000-13.436.75.75 0 010-1.06z"/><path d="M16.243 7.757a.75.75 0 10-1.061 1.061 4.5 4.5 0 010 6.364.75.75 0 001.06 1.06 6 6 0 000-8.485z"/></svg>`;

  // Set initial mute icon
  muteBtn.innerHTML = muteSVG;

  // Function to stop all videos in the slider
  function stopAllVideos() {
    document.querySelectorAll('.video-card video').forEach(v => {
      v.pause();
      v.currentTime = 0;
    });
  }

  // Click on video to open drawer
  document.querySelectorAll('.video-item').forEach((item) => {
    item.addEventListener('click', function () {

      stopAllVideos();

      drawerVideo.src = this.dataset.video;
      drawerVideo.muted = true;
      drawerVideo.play();

      title.innerText = this.dataset.title;
      price.innerText = this.dataset.price;
      image.src = this.dataset.image;
      link.href = this.dataset.url;

      drawer.classList.add('active');

      // Set mute icon
      muteBtn.innerHTML = muteSVG;
    });
  });

  // Close drawer
  document.querySelector('.drawer-close').addEventListener('click', () => {
    drawer.classList.remove('active');
    drawerVideo.pause();
    drawerVideo.src = '';
  });

  // Mute/unmute toggle
  muteBtn.addEventListener('click', () => {
    drawerVideo.muted = !drawerVideo.muted;
    muteBtn.innerHTML = drawerVideo.muted ? muteSVG : unmuteSVG;
  });

  // IntersectionObserver for autoplay/pause on visibility
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const video = entry.target.querySelector('video');
      if (!video) return;

      if (entry.isIntersecting) {
        stopAllVideos();
        video.play();
      } else {
        video.pause();
        video.currentTime = 0;
      }
    });
  }, { threshold: 0.6 });

  document.querySelectorAll('.swiper-slide').forEach(slide => {
    observer.observe(slide);
  });

});
</script>