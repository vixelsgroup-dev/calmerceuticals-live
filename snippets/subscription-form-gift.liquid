<script>
  let allowOneTimePriceUpdate = false;
  
  window.selectVariantViaSwatch = function(variantId) {
    if (!variantId || !window.variantOptions) return;
    variantId = String(variantId);
    var vOpts = window.variantOptions[variantId];
    if (!vOpts) return;

    // Iterate through each option (option1, option2, option3)
    ['option1', 'option2', 'option3'].forEach(function(key, index) {
      var value = vOpts[key];
      if (!value) return; // If the variant doesn't have this option, skip

      var optionIndex = 'option' + (index + 1); // "option1", "option2", ...

      // Check if we are using the radio buttons
      var radioInput = document.querySelector(
        `form.product__form input[data-single-option-selector][data-index="${optionIndex}"][value="${value}"],` +
        `form.shopify-product-form input[data-single-option-selector][data-index="${optionIndex}"][value="${value}"]`
      );

      if (radioInput) {
        // If radio input is found, select it and trigger the change event
        radioInput.checked = true;
        radioInput.dispatchEvent(new Event('change')); // Dispatch the change event
      } else {
        // If radio input is not found, check for popout-select option
        var hiddenInput = document.querySelector(
          `form.product__form [data-single-option-selector][data-index="${optionIndex}"],` +
          `form.shopify-product-form [data-single-option-selector][data-index="${optionIndex}"]`
        );

        if (hiddenInput) {
          // Go up to the popout-select wrapper
          var popout = hiddenInput.closest('popout-select, .select-popout');
          if (!popout) return;

          // Find the matching popout option link
          var link = popout.querySelector(
            `.select-popout__option[data-popout-option][data-value="${CSS.escape(value)}"]`
          );

          if (link) {
            // This will trigger popupOptionsClick and all theme logic
            link.click();
          }
        }
      }
    });
  };
  function getVariantIdFromCard(card) {
    // Assuming each card has data attributes or a structure to map to the variant ID
    const planRadio = card.querySelector('input[name="selling_plan"]');
    const planId = planRadio ? planRadio.value : null;

    if (!planId) return null;
    // You can fetch the corresponding variant ID from the global `variantSellingPlans` map
    const variantSellingPlans = window.variantSellingPlans || {};
    for (let variantId in variantSellingPlans) {
      if (variantSellingPlans[variantId].includes(planId)) {
        return variantId;
      }
    }
    return null; // Return null if no matching variant is found
  }
  function formatMoney(cents) {
    if (window.Shopify && typeof Shopify.formatMoney === 'function') {
      return Shopify.formatMoney(
        cents,
        window.theme && window.theme.moneyFormat ? window.theme.moneyFormat : '${{amount}}'
      );
    }
    return (cents / 100).toFixed(2);
  }
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.program-card').forEach(function (card) {
      const radio = card.querySelector('.program-card__radio');

      // Automatically select and activate the correct program-card based on the selected variant on page load
      if (radio && radio.checked) {
          const variantId = getVariantIdFromCard(card);
          if (variantId) {
              window.selectVariantViaSwatch(variantId);
              card.classList.add('program-card--active');
              
              const subscriptionType = radio.getAttribute('data-subscription-type');
              const correspondingCardInfo = document.querySelector(`.card-info[data-subscription-type="${subscriptionType}"]`);
              if (correspondingCardInfo) {
                  correspondingCardInfo.classList.remove('hidden');
              }
          }
      }

      // Listen for click events on the card
      card.addEventListener('click', function (e) {
        const tag = e.target.tagName.toLowerCase();
        if (tag === 'select' || tag === 'input' || tag === 'button') return;

        const subscriptionType = radio.getAttribute('data-subscription-type');

        // Handle variant selection BEFORE clicking the radio to ensure correct variant is set
        if (subscriptionType === 'one-time-variant') {
          const supplyAmount = radio.getAttribute('data-supply-amount');
          if (supplyAmount) {
            // Get currently selected flavor (option1)
            const flavorInput = document.querySelector('input[data-single-option-selector][data-index="option1"]:checked');
            const flavorValue = flavorInput ? flavorInput.value : null;

            // Find variant that matches both flavor and supply amount
            if (flavorValue && window.variantOptions) {
              let matchingVariantId = null;
              for (const variantId in window.variantOptions) {
                const opts = window.variantOptions[variantId];
                if (opts.option1 === flavorValue && opts.option2 === supplyAmount) {
                  matchingVariantId = variantId;
                  break;
                }
              }

              if (matchingVariantId) {
                console.log('Selecting one-time variant:', matchingVariantId, 'for supply amount:', supplyAmount);
                window.selectVariantViaSwatch(matchingVariantId);

                // Also directly update the form's hidden variant input as a fallback
                const productForm = document.querySelector('form.product__form, form[data-product-form]');
                if (productForm) {
                  const variantInput = productForm.querySelector('input[name="id"][data-product-select]');
                  if (variantInput) {
                    variantInput.value = matchingVariantId;
                    console.log('Updated form variant input to:', matchingVariantId);
                  }
                }
              } else {
                console.warn('No matching variant found for flavor:', flavorValue, 'and supply amount:', supplyAmount);
              }
            }
          }
        } else {
          // For subscription cards, use the existing logic
          const variantId = getVariantIdFromCard(card);
          if (variantId) {
            console.log('Selecting subscription variant:', variantId);
            window.selectVariantViaSwatch(variantId);

            // Also directly update the form's hidden variant input as a fallback
            const productForm = document.querySelector('form.product__form, form[data-product-form]');
            if (productForm) {
              const variantInput = productForm.querySelector('input[name="id"][data-product-select]');
              if (variantInput) {
                variantInput.value = variantId;
                console.log('Updated form variant input to:', variantId);
              }
            }
          }
        }

        // Click the radio AFTER variant is selected
        if (radio) {
          radio.click();
        }

        document.querySelectorAll('.program-card').forEach(function (c) {
          c.classList.remove('program-card--active');
        });

        card.classList.add('program-card--active');

        const correspondingCardInfo = document.querySelector(`.card-info[data-subscription-type="${subscriptionType}"]`);

        if (correspondingCardInfo) {
          correspondingCardInfo.classList.remove('hidden');
        }

        document.querySelectorAll('.card-info').forEach(function (cardInfo) {
          if (cardInfo !== correspondingCardInfo) {
              cardInfo.classList.add('hidden');
          }
        });
      });
    });

    const oneTimeRadios = document.querySelectorAll(
      '.card-info[data-subscription-type="one-time-variant"] .radio__input'
    );

    oneTimeRadios.forEach(function (radio) {
      radio.addEventListener('change', function () {
        allowOneTimePriceUpdate = true;
      });
    });

    // Update one-time card prices when flavor changes
    function updateOneTimeCardPrices() {
      const flavorInput = document.querySelector('input[data-single-option-selector][data-index="option1"]:checked');
      const flavorValue = flavorInput ? flavorInput.value : null;

      if (!flavorValue || !window.variantOptions || !window.variantPricing) return;

      // Update each one-time card
      document.querySelectorAll('.program-card--one-time').forEach(function(card) {
        const supplyAmount = card.getAttribute('data-supply-amount');
        if (!supplyAmount) return;

        // Find variant matching current flavor + this supply amount
        let matchingVariantId = null;
        for (const variantId in window.variantOptions) {
          const opts = window.variantOptions[variantId];
          if (opts.option1 === flavorValue && opts.option2 === supplyAmount) {
            matchingVariantId = variantId;
            break;
          }
        }

        if (matchingVariantId && window.variantPricing[matchingVariantId]) {
          const pricing = window.variantPricing[matchingVariantId].one_time;
          const priceEl = card.querySelector('.program-card__price');
          const compareEl = card.querySelector('.program-card__price--compare');
          const discountBadge = card.querySelector('.discount-badge');

          if (priceEl) {
            priceEl.textContent = formatMoney(pricing.price);
          }

          if (compareEl) {
            if (pricing.compare_price && pricing.compare_price > pricing.price) {
              compareEl.textContent = formatMoney(pricing.compare_price);
              compareEl.style.display = '';
            } else {
              compareEl.style.display = 'none';
            }
          }

          if (discountBadge) {
            if (pricing.compare_price && pricing.compare_price > pricing.price) {
              const discount = Math.round((pricing.compare_price - pricing.price) * 100 / pricing.compare_price);
              const discountSpan = discountBadge.querySelector('.subscription-save-amount');
              if (discountSpan) {
                discountSpan.textContent = discount;
              }
              discountBadge.style.display = '';
            } else {
              discountBadge.style.display = 'none';
            }
          }
        }
      });

      // If a one-time card is active, reselect the variant for the new flavor
      const activeOneTimeCard = document.querySelector('.program-card--one-time.program-card--active');
      if (activeOneTimeCard) {
        const supplyAmount = activeOneTimeCard.getAttribute('data-supply-amount');
        if (supplyAmount) {
          let matchingVariantId = null;
          for (const variantId in window.variantOptions) {
            const opts = window.variantOptions[variantId];
            if (opts.option1 === flavorValue && opts.option2 === supplyAmount) {
              matchingVariantId = variantId;
              break;
            }
          }

          if (matchingVariantId) {
            window.selectVariantViaSwatch(matchingVariantId);
          }
        }
      }
    }

    // Listen for flavor (option1) changes
    const flavorInputs = document.querySelectorAll('input[data-single-option-selector][data-index="option1"]');
    flavorInputs.forEach(function(input) {
      input.addEventListener('change', function() {
        updateOneTimeCardPrices();
      });
    });

    // Also listen for popout select changes (if using dropdowns instead of radios)
    const flavorSelect = document.querySelector('[data-single-option-selector][data-index="option1"]');
    if (flavorSelect && flavorSelect.tagName === 'INPUT' && flavorSelect.type === 'hidden') {
      const observer = new MutationObserver(function() {
        updateOneTimeCardPrices();
      });
      observer.observe(flavorSelect, { attributes: true, attributeFilter: ['value'] });
    }

    // Initialize prices on page load
    updateOneTimeCardPrices();

  });
  
  // Listen for the variantChanged event globally
  document.addEventListener('variantChanged', function(event) {
    const variant = event.detail.variant;
    const variantId = variant.id;
    const sellingPlanGroupId = variant.selling_plan_group_id;

    if (!allowOneTimePriceUpdate) {
      return;
    }

    const oneTimeCard = document.querySelector('.program-card--one-time.program-card--active');
    if (!oneTimeCard || !variant) return;

    const priceEl   = oneTimeCard.querySelector('.program-card__price');
    const compareEl = oneTimeCard.querySelector('.program-card__price--compare');
    if (priceEl) {
      priceEl.textContent = formatMoney(variant.price);
    }

    if (compareEl) {
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        compareEl.textContent = formatMoney(variant.compare_at_price);
        compareEl.style.display = '';
      } else {
        compareEl.style.display = 'none';
      }
    }
  });
</script>