<!-- Subscription Form -->
{% assign isfortnighly = false %}

{% for tag in product.tags %}
  {% if tag == 'fortnightly' %}
    {% assign isfortnighly = true %}
  {% endif %}
{% endfor %}
<!-- DEBUG isfortnighly = {{ isfortnighly }} -->
<div class="flavor-guarantee">
  <div class="flavor-icon">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
<path d="M5.928 10.8836L7.95581 9.65344L9.98363 10.8836L9.44569 8.57738L11.2442 7.02694L8.87738 6.828L7.95581 4.653L7.03425 6.828L4.66744 7.02694L6.46594 8.57738L5.928 10.8836ZM7.95581 15.9116L5.60194 13.5808H2.33081V10.3097L0 7.95581L2.33081 5.60194V2.33081H5.60194L7.95581 0L10.3097 2.33081H13.5808V5.60194L15.9116 7.95581L13.5808 10.3097V13.5808H10.3097L7.95581 15.9116ZM7.95581 14.3308L9.83081 12.4558H12.4558V9.83081L14.3308 7.95581L12.4558 6.08081V3.45581H9.83081L7.95581 1.58081L6.08081 3.45581H3.45581V6.08081L1.58081 7.95581L3.45581 9.83081V12.4558H6.08081L7.95581 14.3308Z" fill="#610C27"/>
</svg>
  </div>
  <div class="flavor-content">
    <h4>{{ 'subscriptions.flavors.title' | t }}</h4>
    <p>{{ 'subscriptions.flavors.description' | t }}</p>
  </div>
</div>
<div
  id="product__subs__wrap-main"
  class="product__subs__wrap"
  {% if animations_enabled %}
    data-aos="hero"
    data-aos-anchor="{{ animation_anchor }}"
    data-aos-order="{{ animation_order }}"
  {% endif %}>
  <h3 class="program-cards__heading">Subscribe & Save:</h3>
  <fieldset class="program-cards" data-subscription-selectors>
    <legend class="visually-hidden">Subscriptions</legend>
    {% assign current_variant_highest_price = product.variants | sort: 'price' | last %}


    {%- comment -%}
      === REGULAR SUBSCRIPTION CARD ===
    {%- endcomment -%}
    {% unless product.requires_selling_plan %}
      <div class="program-card program-card--regular-subscriptions-general">
        <input
          type="radio"
          class="program-card__radio"
          name="selling-plan-group"
          value=""
          data-toggles-group
          data-subscription-type="regular-subscriptions"
        >
        <label class="program-card__inner">
          <span class="radio-element"></span>
          <div class="program-card__content">
            <div class="program-card__content-inner">
              <span class="program-card__ribbon badge-1"
                ><span>{{ 'subscriptions.regular.badge_html' | t }}</span></span
              >

              {%- comment -%} ── CALCULATION MOVED UP HERE — must happen before any HTML uses these values ── {%- endcomment -%}
              {% assign allocation = null %}
              {% assign lowest_price = null %}
              {% assign lowest_discount_price = null %}
              {% assign lowest_discount_percentage = 0 %}

              {% assign allowed_selling_plan_group_ids = product.selling_plan_groups | where: 'app_id', 'SKIO' %}
              {% for selling_plan_group in allowed_selling_plan_group_ids %}
                {% unless selling_plan_group.name contains 'Prepaid' %}
                  {% for regular_plan in selling_plan_group.selling_plans %}
                    {% for variant in product.variants %}
                      {% for spa in variant.selling_plan_allocations %}
                        {% if spa.selling_plan.id == regular_plan.id %}
                          {% assign allocation = spa %}
                          {% break %}
                        {% endif %}
                      {% endfor %}
                      {% if allocation %}
                        {% assign total_price = allocation.price %}
                        {% assign compare_price = allocation.compare_at_price %}
                        {% assign per_delivery = allocation.per_delivery_price %}

                        {% if compare_price > total_price and compare_price > 0 %}
                          {% assign discount_percentage = compare_price
                            | minus: total_price
                            | times: 100.00
                            | divided_by: compare_price
                          %}
                        {% else %}
                          {% assign discount_percentage = 0 %}
                        {% endif %}

                        <!-- Compare and store the lowest price -->
                        {% if lowest_price == null or total_price < lowest_price %}
                          {% assign lowest_price = total_price %}
                          {% assign lowest_discount_price = compare_price %}
                          {% assign lowest_discount_percentage = discount_percentage %}
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                {% endunless %}
              {% endfor %}
              {%- comment -%} ── END CALCULATION ── {%- endcomment -%}

              <div class="program-card__info">
                <div class="program-card__title-wrapper title-flex_wrapper">
                  <h4 class="program-card__title">{{ 'subscriptions.regular.title' | t }}</h4>
                  {%- comment -%} Desktop badge — now works because calculation already ran above {%- endcomment -%}
                  {% if lowest_discount_percentage > 0 %}
                    <div class="discount-badge badge mobile-hidden">
                      Save
                      <span class="subscription-save-amount-main"
                        ><span class="subscription-save-amount">{{ lowest_discount_percentage | round }}</span>%</span
                      >
                    </div>
                  {% endif %}
                </div>

                <div class="program-name">{{ 'subscriptions.regular.sub_title_html' | t }}</div>
              </div>

              <!-- Display the lowest price and discount -->
              <div class="price-area">
                <div class="program-card__price-wrap">
                  <div class="prices">
                    {% if lowest_discount_price > lowest_price %}
                      <s class="program-card__price--compare">{{ lowest_discount_price | money }}</s>
                    {% endif %}
                    <span class="program-card__price">{{ lowest_price | money }}</span>
                  </div>
                </div>

                {%- comment -%} Mobile badge — was already working, still works {%- endcomment -%}
                {% if lowest_discount_percentage > 0 %}
                  <div class="discount-badge badge desktop-hidden">
                    Save
                    <span class="subscription-save-amount-main"
                      ><span class="subscription-save-amount">{{ lowest_discount_percentage | round }}</span>%</span
                    >
                  </div>
                {% endif %}
              </div>

            </div>
          </div>
        </label>
      </div>
    {% endunless %}


    {%- comment -%}
      === ONE-TIME / SAMPLE CARD ===
    {%- endcomment -%}
    {% unless product.requires_selling_plan %}
      <div class="program-card program-card--one-time">
        <input
          type="radio"
          class="program-card__radio"
          name="selling-plan-group"
          value=""
          data-toggles-group
          data-subscription-type="supply-amount"
        >
        <label class="program-card__inner">
          <span class="radio-element"></span>
          <div class="program-card__content">
            <div class="program-card__content-inner">
              <div class="program-card__info">
                <div class="program__title-container flex-program_title">
                     <h4 class="program-card__title">{{ 'subscriptions.one_time.title' | t }}</h4>
                      
                </div>
                <div class="program-name">{{ 'subscriptions.one_time.sub_title_html' | t }}</div>
              </div>
              <div class="price-area">
                <div class="program-card__price-wrap">
                  <div class="prices">
                    {% if product.compare_at_price_min > product.price_min %}
                      <s class="program-card__price--compare">{{ product.compare_at_price_min | money }}</s>
                    {% endif %}
                    <span class="program-card__price">{{ product.price_min | money }}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </label>
      </div>
    {% endunless %}

    {%- comment -%}
      === 12 WEEKS PROGRAMMES CARD ===
    {%- endcomment -%}

    {% comment %} edited by Skio {% endcomment %}
    {% assign allowed_selling_plan_group_ids = product.selling_plan_groups | where: 'app_id', 'SKIO' %}
    {% for selling_plan_group in allowed_selling_plan_group_ids %}
      {% if selling_plan_group.name contains 'Prepaid' %}
        <div
          class="program-card twelve-weeks-card program-card--standard{% if forloop.index == 1 %} program-card--active{% endif %}"
          data-selling-plan-group-id="{{ selling_plan_group.id }}"
         >
          {%- comment -%}
            This is the ORIGINAL group radio the theme JS listens to.
          {%- endcomment -%}
          <input
            type="radio"
            class="program-card__radio"
            data-toggles-group
            name="selling-plan-group"
            value="{{ selling_plan_group.id }}"
            {% if forloop.index == 1 %}
              checked
            {% endif %}
            data-subscription-type="12-weeks"
          >
          <label class="program-card__inner">
            <span class="radio-element"></span>
            <div class="program-card__content">
              <div class="program-card__content-inner">
                {%- assign allocation = null -%}
                {%- assign plan = selling_plan_group.selling_plans.first -%}
                {%- assign variant_for_allocation = current_variant_highest_price -%}
                {%- for spa in variant_for_allocation.selling_plan_allocations -%}
                  {%- if spa.selling_plan.id == plan.id -%}
                    {%- assign allocation = spa -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if allocation -%}
                  {%- assign total_price = allocation.price -%}
                  {%- assign compare_price = product.metafields.custom.twelve_week_comp_price | times: 100 -%}
                  {%- assign per_delivery = allocation.per_delivery_price -%}

                  {%- if compare_price > total_price and compare_price > 0 -%}
                    {%- assign discount_percentage = compare_price
                      | minus: total_price
                      | times: 100
                      | divided_by: compare_price
                      | round
                    -%}
                  {%- else -%}
                    {%- assign discount_percentage = 0 -%}
                  {%- endif -%}
                {%- else -%}
                  {%- assign discount_percentage = 0 -%}
                {%- endif -%}
                <span class="program-card__ribbon badge-1"
                  ><span>{{ 'subscriptions.twelve_weeks.badge' | t }}</span></span
                >
                <div class="program-card__info">
                  <div class="program-card__title-wrapper title-flex_wrapper">
                    <h4 class="program-card__title 12-week-program-card-title">{{ 'subscriptions.twelve_weeks.title' | t }}</h4>
                   
                      {% if discount_percentage > 0 %}
                        <div class="discount-badge badge mobile-hidden">
                          Save
                          <span class="subscription-save-amount-main"
                            ><span class="subscription-save-amount">{{ discount_percentage }}</span>%</span
                          >
                        </div>
                      {% endif %}
                  </div>

                  
                  {%- comment -%}
                    Duration selector built from group's plans.
                  {%- endcomment -%}
                  {% if selling_plan_group.selling_plans.size > 1 %}
                    <div class="program-card__duration">
                      <label class="program-card__duration-label hidden">Duration</label>
                      <select
                        class="program-card__duration-select"
                        data-selling-plan-select="{{ selling_plan_group.id }}"
                      >
                        {% for plan in selling_plan_group.selling_plans %}
                          <option
                            value="{{ plan.id }}"
                            data-discount-percentage-val="{{ plan.price_adjustments[0].value }}"
                            {% if plan.selected %}
                              selected
                            {% endif %}
                          >
                            Every {{ plan.name }}
                          </option>
                        {% endfor %}
                      </select>
                    </div>
                  {% else %}
                    <div class="program-name">{{ 'subscriptions.twelve_weeks.sub_title_html' | t }}</div>
                  {% endif %}
                  {% if product.metafields.custom.twelve_week_offer_text != blank %}
                    <h4 class="twelve_offer_text" style="font-weight:600;color:#610C27;">
                      {{ product.metafields.custom.twelve_week_offer_text }}
                    </h4>
                  {% endif %}
                </div>
                <div class="price-area">
                  {%- if allocation -%}
                    {%- assign deliveries = 1 -%}
                    {%- if per_delivery and per_delivery > 0 -%}
                      {%- assign deliveries = total_price | divided_by: per_delivery -%}
                    {%- endif -%}
                    <div class="program-card__price-wrap">
                      {% if isfortnighly %}
                        <div class="prices">
                          <s class="program-card__price--compare">
                            {% if product.metafields.custom.twelve_week_comp_price != blank %}
                              {{ product.metafields.custom.twelve_week_comp_price | times: 100.00 | money }}
                            {% else %}
                              {{ compare_price | money }}
                            {% endif %}
                          </s>

                          <span class="program-card__price">
                            {{ product.metafields.custom['12_week_fortnightly_total_cost'] }}
                          </span>
                        </div>
                      {% else %}
                        <div class="prices">
                          
                            <s class="program-card__price--compare">
                              {% if product.metafields.custom.twelve_week_comp_price != blank %}
                                {{ product.metafields.custom.twelve_week_comp_price | times: 100.00 | money }}
                              {% else %}
                                {{ compare_price | money }}
                              {% endif %}
                            </s>
                          
                          <span class="program-card__price">
                            {{ total_price | money }}
                          </span>
                        </div>
                      {% endif %}

                      {% if deliveries > 1 %}

                        <div class="price-per-delivery-wrapper hidden">
                          <small class="price-per-delivery">
                            {%- comment -%}
                              12-week programme = 84 days = 6 x 14-day periods (fortnights)
                            {%- endcomment -%}
                            {%- assign fortnight_count = 6 -%}
                            {%- assign fortnight_price = total_price | divided_by: fortnight_count -%}
                            ({{ fortnight_price | money }} per 14 fortnight)
                            <!-- DEBUG fortnight_price = {{ fortnight_price }} -->
                          </small>
                        </div>
                      {% endif %}
                    </div>
                  {%- else -%}
                    <div class="program-card__price-wrap">
                      <div class="prices">
                        {% if isfortnighly %}
                        <div class="program-card__price">
                          {{ product.metafields.custom['12_week_fortnightly_total_cost'] | times: 100.00 | money }} fortnightly
                        </div>
                      {% else %}
                        <div class="program-card__price">
                          {{ product.selected_or_first_available_variant.price | money }}
                        </div>
                      {% endif %}
                      </div>
                    </div>
                  {%- endif -%}
                  {% if isfortnighly %}
                    <div class="discount-badge badge">
                      Save
                      <span class="subscription-save-amount-main">
                        {% if product.metafields.custom.twelve_week_discount != blank %}
                          <span class="subscription-save-amount">
                            {{- product.metafields.custom.twelve_week_discount -}}</span
                          >%
                        {% else %}
                          <span class="subscription-save-amount">{{ discount_percentage }}</span>%
                        {% endif %}
                      </span>
                    </div>
                  {% endif %}
                  {% if discount_percentage > 0 %}
                    <div class="discount-badge badge desktop-hidden">
                      Save
                      <span class="subscription-save-amount-main">
                        {% if product.metafields.custom.twelve_week_discount != blank %}
                          <span class="subscription-save-amount">
                            {{- product.metafields.custom.twelve_week_discount -}}</span
                          >%
                        {% else %}
                          <span class="subscription-save-amount">{{ discount_percentage }}</span>%
                        {% endif %}
                      </span>
                    </div>
                  {% endif %}
                </div>
              </div>
              {% if product.metafields.custom.twelve_week_extra_info != blank %}
                {{ product.metafields.custom.twelve_week_extra_info }}
              {% endif %}
            </div>
          </label>
          {%- comment -%}
            ORIGINAL plan radios – kept for the theme JS, just hidden.
          {%- endcomment -%}
          <div class="product__subs__plans visually-hidden" data-group-toggle="{{ selling_plan_group.id }}">
            {% for plan in selling_plan_group.selling_plans %}
              <label class="product__subs__option">
                <input
                  type="radio"
                  name="selling_plan"
                  value="{{ plan.id }}"
                  {% if forloop.index == 1 %}
                    checked
                  {% endif %}
                >
                <span>{{ plan.name }}</span>
              </label>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
    <div class="twelve-weeks-info card-info hidden" data-subscription-type="12-weeks">
      <div class="twelve-weeks-info-content">
        <div class="list">
          <div class="list-item">
            {{ images['12-week-1.svg'] | image_url: width: 25 | image_tag }}
            Supports joint comfort and mobility improvements over continued use
          </div>
          <div class="list-item">
            {{ images['12-week-2.svg'] | image_url: width: 25 | image_tag }}
            Vitality and recovery gains strengthen across consistent weeks
          </div>
          <div class="list-item">
            {{ images['12-week-3.svg'] | image_url: width: 25 | image_tag }}
            Connective-tissue support compounds over the full programme
          </div>
          <div class="list-item">
            {{ images['12-week-4.svg'] | image_url: width: 25 | image_tag }}
            Results typically begin around Week 4-6 and progress through Week 12 and beyond
          </div>
          <div class="list-item">
            {{ images['12-week-5.svg'] | image_url: width: 25 | image_tag }}
            84-sachet programme foundation
          </div>
          <div class="list-item">
            {{ images['12-week-6.svg'] | image_url: width: 25 | image_tag }}
            39 percent programme discount
          </div>
        </div>
      </div>
    </div>
    <div class="regular-subscriptions-main card-info hidden" data-subscription-type="regular-subscriptions">
      <h3 class="program-cards__heading">Delivery Schedule:</h3>
      {% comment %} edited by Skio {% endcomment %}
      {% assign allowed_selling_plan_group_ids = product.selling_plan_groups | where: 'app_id', 'SKIO' %}
      {% for selling_plan_group in allowed_selling_plan_group_ids %}
        {% unless selling_plan_group.name contains 'Prepaid' %}
          {% assign sorted_plans = selling_plan_group.selling_plans | sort: 'name' %}
          {% for current_plan in sorted_plans %}
            {% assign allocation = null %}
            {% for variant in product.variants %}
              {% for spa in variant.selling_plan_allocations %}
                {% if spa.selling_plan.id == current_plan.id %}
                  {% assign allocation = spa %}
                  {% break %}
                {% endif %}
              {% endfor %}
              {% if allocation %}
                {% break %}
              {% endif %}
            {% endfor %}

            {% if allocation %}
              {% assign total_price = allocation.price %}
              {% assign compare_price = allocation.compare_at_price %}
              {% assign per_delivery = allocation.per_delivery_price %}
              {% if compare_price > total_price and compare_price > 0 %}
                {% assign discount_percentage = compare_price
                  | minus: total_price
                  | times: 100
                  | divided_by: compare_price
                %}
              {% else %}
                {% assign discount_percentage = 0 %}
              {% endif %}
            {% else %}
              {% assign discount_percentage = 0 %}
            {% endif %}
            <div class="program-card program-card--standard" data-selling-plan-group-id="{{ selling_plan_group.id }}">
              <label class="program-card__inner">
                <input
                  type="radio"
                  class="selling_plan_program-card__radio"
                  data-toggles-group
                  name="selling-plan-group-regular"
                  value="{{ current_plan.id }}"
                  data-card-compare-price="{{ compare_price }}"
                  data-card-price="{{ total_price }}"
                >
                <span class="radio-element"></span>
                <div class="program-card__content">
                  <div class="program-card__content-inner">
                    <div class="program-card__info">
                      <h4 class="program-card__title">
                        {% comment %} <svg xmlns="http://www.w3.org/2000/svg" width="20" height="16" viewBox="0 0 20 16" fill="none">
                          <g clip-path="url(#clip0_2091_2810)"> <path d="M19.5 11H19V7.62187C19 7.225 18.8406 6.84375 18.5594 6.5625L15.4375 3.44062C15.1562 3.15937 14.775 3 14.3781 3H13V1.5C13 0.671875 12.3281 0 11.5 0H3.5C2.67188 0 2 0.671875 2 1.5V3H0.25C0.1125 3 0 3.1125 0 3.25V3.75C0 3.8875 0.1125 4 0.25 4H8.75C8.8875 4 9 4.1125 9 4.25V4.75C9 4.8875 8.8875 5 8.75 5H1.25C1.1125 5 1 5.1125 1 5.25V5.75C1 5.8875 1.1125 6 1.25 6H7.75C7.8875 6 8 6.1125 8 6.25V6.75C8 6.8875 7.8875 7 7.75 7H0.25C0.1125 7 0 7.1125 0 7.25V7.75C0 7.8875 0.1125 8 0.25 8H6.75C6.8875 8 7 8.1125 7 8.25V8.75C7 8.8875 6.8875 9 6.75 9H2V13C2 14.6562 3.34375 16 5 16C6.65625 16 8 14.6562 8 13H12C12 14.6562 13.3438 16 15 16C16.6562 16 18 14.6562 18 13H19.5C19.775 13 20 12.775 20 12.5V11.5C20 11.225 19.775 11 19.5 11ZM5 14.5C4.17188 14.5 3.5 13.8281 3.5 13C3.5 12.1719 4.17188 11.5 5 11.5C5.82812 11.5 6.5 12.1719 6.5 13C6.5 13.8281 5.82812 14.5 5 14.5ZM15 14.5C14.1719 14.5 13.5 13.8281 13.5 13C13.5 12.1719 14.1719 11.5 15 11.5C15.8281 11.5 16.5 12.1719 16.5 13C16.5 13.8281 15.8281 14.5 15 14.5ZM17.5 8H13V4.5H14.3781L17.5 7.62187V8Z" fill="#0B0B0B"/> </g> <defs> <clipPath id="clip0_2091_2810"> <rect width="20" height="16" fill="white"/> </clipPath> </defs>
                        </svg> {% endcomment %}
                        {{ current_plan.name | replace: 'Every ', '' }} Delivery
                      </h4>
                    </div>
                    {% assign current_plan_downcase = current_plan.name | downcase %}
                    <div class="delivery-msg">
                      {% assign delivery_sachet = 14 %}
                      {% if current_plan_downcase contains 'four' or current_plan_downcase contains '4' %}
                        {% assign delivery_sachet = 28 %}
                      {% endif %}
                      <span>Get {{ delivery_sachet }} sachets {{ current_plan.name }}</span>
                    </div>
                    <div class="price-area hidden">
                      {% if allocation %}
                        <div class="program-card__price-wrap">
                          <div class="prices">
                            {% if compare_price and compare_price > total_price %}
                              <s class="program-card__price--compare">{{ compare_price | money }}</s>
                            {% endif %}
                            <span class="program-card__price">{{ total_price | money }}</span>
                          </div>
                        </div>
                      {% else %}
                        <div class="program-card__price-wrap">
                          <div class="prices">
                            <div class="program-card__price">{{ product.selected_or_first_available_variant.price | money }}</div>
                          </div>
                        </div>
                      {% endif %}

                      {% if discount_percentage > 0 %}
                        <div class="discount-badge badge">
                          Save
                          <span class="subscription-save-amount-main"
                            ><span class="subscription-save-amount">{{ discount_percentage }}</span>%</span
                          >
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
            </label>
            {%- comment -%}
              ORIGINAL plan radios – kept for the theme JS, just hidden.
              Each card represents one plan, so we include only that plan.
            {%- endcomment -%}
            <div class="product__subs__plans visually-hidden" data-group-toggle="{{ current_plan.id }}">
              <label class="product__subs__option">
                <input
                  type="radio"
                  name="selling_plan"
                  value="{{ current_plan.id }}"
                >
                <span>{{ current_plan.name }}</span>
              </label>
            </div>
          </div>
          {% endfor %}
        {% endunless %}
      {% endfor %}
    </div>
    <div class="card-info hidden" data-subscription-type="supply-amount">
      {%- for option in product.options_with_values -%}
        {% assign option_name = option.name | handleize %}
        {%- assign current_option_position = option.position | prepend: 'option' -%}
        {% if option_name == 'supply-amount' %}
          <div
            class="selector-wrapper selector-wrapper--boxes"
            data-selector-wrapper
            data-option-name="{{ option_name }}"
            data-option-position="{{ option.position }}"
          >
            {%- if settings.variants_style == 'boxes' or settings.variants_style == 'auto' -%}
              {%- liquid
                assign current_value = current_variant.options[forloop.index0]

                capture radio_fieldset_class
                  echo 'radio__fieldset'
                  echo ' radio__fieldset--' | append: settings.color_swatches_product_style

                  if show_size_guide_as_label
                    echo ' radio__fieldset--sizeguide'
                  endif

                  if has_variant_option_image
                    echo ' radio__fieldset--variant-option-image'

                    if settings.variant_image_style == 'stacked'
                      echo ' radio__fieldset--variant-option-image-stacked'
                    else
                      echo ' radio__fieldset--variant-option-image-inline'
                    endif
                  endif
                endcapture

                assign option_name_label = option.name | escape_once
                if label_text_caps
                  assign option_name_label = option_name_label | replace: 'ß', '<span style="text-transform: lowercase;">ß</span>'
                endif
              -%}

              <fieldset
                class="{{ radio_fieldset_class }}"
                {% if is_swatch_option or is_native_swatch_option %}
                  {%- unless color_swatch_variant_image and show_variant_image %}
                    data-swatches-container
                  {%- endunless -%}
                {% endif %}
              >
                <legend
                  class="radio__legend"
                  {% if is_swatch_option or is_native_swatch_option %}
                    {%- unless color_swatch_variant_image and show_variant_image %} data-swatches-label{% endunless -%}
                  {% endif %}
                >
                  <span class="radio__legend__label h3">{{ option_name_label }}:</span>
                  {%- if show_size_guide_as_label -%}{{- size_chart_button -}}{%- endif -%}
                </legend>
                <div class="radio__buttons" data-variant-buttons>
                  {%- for value in option.values -%}
                    {%- capture input_id -%}{{ unique }}-{{ product.id }}-{{ option.name | escape_once }}-{{ value | handle }}{%- endcapture -%}
                    {%- capture options_markup -%}
                      {% comment %} radio button {% endcomment %}
                      <span 
                        class="radio__button
                        {% if value == '12-Weeks' or value == '12 Weeks' or value == '12-Weeks Programme' or value == '12 Weeks Programme' %}hidden{% endif %}"
                        {% if has_variant_option_image %} data-variant-option-image{% endif %}>
                        <input
                          type="radio"
                          class="radio__input"
                          data-single-option-selector
                          data-index="{{ current_option_position }}"
                          name="options[{{ option.name | escape_once }}]"
                          value="{{ value | escape_once }}" id="{{ input_id | handle }}"
                          {% if value == current_value %}checked{% endif %}>

                        <label for="{{ input_id | handle }}" class="radio__label">
                          <span class="radio-element"></span>
                          {%- if has_variant_option_image -%}
                            <span class="option-image"{{ option_image_border_radius }}>
                              {%- assign variant_option_image_translation = 'products.product.variant_option_image' | t | handle -%}
                              {%- assign option_name = option.name | handle -%}

                              {%- if option_name == variant_option_image_translation -%}
                                {%- assign option_image_found = false -%}

                                {%- for variant in product.variants -%}
                                  {%- for option in variant.options -%}
                                    {%- if option == value -%}
                                      {%- assign variant_option_image = variant.featured_media.preview_image -%}

                                      {%- if variant_option_image -%}
                                        {%- capture srcset -%}
                                          {%- render 'image-srcset', image: variant_option_image, widths: '60, 90, 120, 150, 180' -%}
                                        {%- endcapture -%}

                                        {{ variant_option_image | image_url: height: 60 | image_tag: srcset: srcset, sizes: '180px' }}
                                      {%- else -%}

                                      {{- 'product-1' | placeholder_svg_tag: 'placeholder-svg-filled' -}}
                                      {%- endif -%}

                                      {%- assign option_image_found = true -%}
                                    {%- endif -%}

                                    {%- if option_image_found -%}
                                      {%- break -%}
                                    {%- endif -%}
                                  {%- endfor -%}

                                  {%- if option_image_found -%}
                                    {%- break -%}
                                  {%- endif -%}
                                {%- endfor -%}
                              {%- endif -%}
                            </span>
                          {%- endif -%}

                          <span class="option-title">{{ value | escape_once }}</span>
                        </label>
                      </span>
                    {%- endcapture -%}

                    {%- if is_swatch_option or is_native_swatch_option -%}
                      {%- liquid
                        assign current_option_variants = product | map: 'variants' | where: current_option_position, value
                        assign current_option_variants_id = current_option_variants | map: 'id' | join: ','

                        unless show_variant_image and color_swatch_variant_image
                          if is_native_swatch_option
                            if value.swatch.image
                              assign image_url = value.swatch.image | image_url: width: 96
                              assign swatch_value = 'url(' | append: image_url | append: ')'
                            elsif value.swatch.color
                              assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                            else
                              assign swatch_value = null
                            endif
                          else
                            assign swatch_value = value | handle
                          endif

                          capture swatch_style
                            if is_swatch_option
                              echo '--swatch: var(--' | append: swatch_value | append: ');'
                            elsif is_native_swatch_option
                              echo '--swatch: ' | append: swatch_value
                            endif
                          endcapture
                        endunless
                      -%}

                      {%- if show_variant_image and color_swatch_variant_image -%}
                        {{ options_markup }}
                      {%- else -%}
                        <tooltip-component
                          class="swatches swatch__button swatch__button--{{ settings.color_swatches_product_style }}"
                          data-swatches-button
                        >
                          <input
                            type="radio"
                            class="swatch__input"
                            data-single-option-selector
                            data-index="{{ current_option_position }}"
                            name="options[{{ option.name | escape_once }}]"
                            value="{{ value | escape_once }}"
                            id="{{ input_id }}"
                            {% if value == current_value %}
                              checked
                            {% endif %}
                          >
                          <label
                            for="{{ input_id }}"
                            class="swatch__label"
                            data-swatch="{{ value | escape_once }}"
                            data-tooltip="{{ value | escape_once }}"
                            data-swatch-variant="{{ current_option_variants_id }}"
                            style="{{ swatch_style }}"
                          >
                            <span class="visually-hidden">{{ value | escape_once }}</span>
                            <span class="icon icon-check"></span>
                          </label>
                        </tooltip-component>
                      {%- endif -%}
                    {%- else -%}
                      {{ options_markup }}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </fieldset>
              {%- if is_swatch_option or is_native_swatch_option -%}
                <button
                  type="button"
                  class="btn btn--text swatch__more"
                  aria-expanded="false"
                  aria-controls="CollectionFilterActions--product-type"
                  data-swatches-more
                >
                  <span>{{ 'products.product.show_more' | t }}</span>
                  <span>{{ 'products.product.show_less' | t }}</span>
                </button>
              {%- endif -%}
            {%- else -%}
              {%- assign selects_counter = selects_counter | plus: 1 -%}
              <div class="select__fieldset">
                {%- capture input_id -%}{{ unique }}-{{ product.id }}-option-{{ option.position }}{%- endcapture -%}
                <div class="select__label h3" id="{{ unique }}-select-{{ option.name | handle }}-label">
                  {%- liquid
                    if show_size_guide_as_label
                      echo size_chart_button
                    else
                      assign option_name_label = option.name | escape_once
                      if label_text_caps
                        assign option_name_label = option_name_label | replace: 'ß', '<span style="text-transform: lowercase;">ß</span>'
                      endif
                      echo option_name_label
                    endif
                  -%}
                </div>
                <popout-select class="select-popout" data-popout-prevent="true">
                  <button
                    type="button"
                    class="select-popout__toggle"
                    aria-expanded="false"
                    aria-controls="{{ unique }}-select-{{ option.name | handle }}"
                    aria-labelledby="{{ unique }}-select-{{ option.name | handle }}-label"
                    data-popout-toggle
                  >
                    <span class="select-popout__value" data-popout-text>{{ option.selected_value }}</span>
                    {%- render 'icon-select' -%}
                  </button>
                  <div id="{{ unique }}-select-{{ option.name | handle }}" class="select-popout__list" data-popout-list>
                    <ul class="select-popout__list__scroll">
                      {%- for value in option.values -%}
                        <li class="select-popout__item {% if option.selected_value == value %}select-popout__item--current{% endif %}">
                          <a
                            class="select-popout__option"
                            href="#"
                            {% if option.selected_value == value %}
                              aria-current="true"
                            {% endif %}
                            data-value="{{ value | escape_once }}"
                            data-popout-option
                          >
                            <span>
                              {{ value | escape_once }}
                            </span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                  <input
                    type="hidden"
                    name="options[{{ option.name | escape_once }}]"
                    id="{{ input_id }}"
                    value="{{ option.selected_value | escape_once }}"
                    data-popout-input
                    data-single-option-selector
                    data-index="option{{ option.position }}"
                  >
                </popout-select>
              </div>
            {%- endif -%}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </fieldset>
</div>

<script>
  // Export selling plan availability per variant
  window.variantSellingPlans = window.variantSellingPlans || {};
  {% comment %} edited by Skio {% endcomment %}
  {% assign allowed_selling_plan_group_ids = product.selling_plan_groups | where: 'app_id', 'SKIO' | map: 'id' %}
  {% for variant in product.variants %}
    window.variantSellingPlans["{{ variant.id }}"] = [
      {% for spa in variant.selling_plan_allocations %}
        {% if allowed_selling_plan_group_ids contains spa.selling_plan_group_id %}
          "{{ spa.selling_plan.id }}"{% unless forloop.last %},{% endunless %}
        {% endif %}
      {% endfor %}
    ];
  {% endfor %}

  // Export pricing for each variant (one-time and subscription)
  window.variantPricing = window.variantPricing || {};
  {% comment %} edited by Skio {% endcomment %}
  {% assign allowed_selling_plan_group_ids = product.selling_plan_groups | where: 'app_id', 'SKIO' | map: 'id' %}
  {% for variant in product.variants %}
    window.variantPricing["{{ variant.id }}"] = {
      one_time: {
        price: {{ variant.price | default: 0 }},
        compare_price: {{ variant.compare_at_price | default: 0 }},
        price_formatted: "{{ variant.price | money | strip_newlines }}",
        compare_price_formatted: "{{ variant.compare_at_price | money | strip_newlines }}"
      },
      selling_plans: {
        {% for spa in variant.selling_plan_allocations %}
          {% comment %} edited by Skio {% endcomment %}
          {% if allowed_selling_plan_group_ids contains spa.selling_plan_group_id %}
          "{{ spa.selling_plan.id }}": {
            price: {{ spa.price | default: 0 }},
            compare_price: {{ spa.compare_at_price | default: 0 }},
              price_formatted: "{{ spa.price | money | strip_newlines }}",
              compare_price_formatted: "{{ spa.compare_at_price | money | strip_newlines }}"
            }{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      }
    };
  {% endfor %}
</script>

<script>
  // Map variantId -> option values (option1/2/3)
  window.variantOptions = window.variantOptions || {};
  {% for variant in product.variants %}
    window.variantOptions["{{ variant.id }}"] = {
      option1: {{ variant.option1 | json }},
      option2: {{ variant.option2 | json }},
      option3: {{ variant.option3 | json }}
    };
  {% endfor %}
</script>

