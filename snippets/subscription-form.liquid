<script>
  let allowOneTimePriceUpdate = false;

  window.selectVariantViaSwatch = function (variantId) {
    if (!variantId || !window.variantOptions) return;
    variantId = String(variantId);
    var vOpts = window.variantOptions[variantId];
    if (!vOpts) return;

    // Iterate through each option (option1, option2, option3)
    ['option1', 'option2', 'option3'].forEach(function (key, index) {
      var value = vOpts[key];
      if (!value) return; // If the variant doesn't have this option, skip

      var optionIndex = 'option' + (index + 1); // "option1", "option2", ...

      // Check if we are using the radio buttons
      var radioInput = document.querySelector(
        `form.product__form input[data-single-option-selector][data-index="${optionIndex}"][value="${value}"],` +
          `form.shopify-product-form input[data-single-option-selector][data-index="${optionIndex}"][value="${value}"]`
      );

      if (radioInput) {
        // If radio input is found, select it and trigger the change event
        radioInput.checked = true;
        radioInput.dispatchEvent(new Event('change')); // Dispatch the change event
      } else {
        // If radio input is not found, check for popout-select option
        var hiddenInput = document.querySelector(
          `form.product__form [data-single-option-selector][data-index="${optionIndex}"],` +
            `form.shopify-product-form [data-single-option-selector][data-index="${optionIndex}"]`
        );

        if (hiddenInput) {
          // Go up to the popout-select wrapper
          var popout = hiddenInput.closest('popout-select, .select-popout');
          if (!popout) return;

          // Find the matching popout option link
          var link = popout.querySelector(
            `.select-popout__option[data-popout-option][data-value="${CSS.escape(value)}"]`
          );

          if (link) {
            // This will trigger popupOptionsClick and all theme logic
            link.click();
          }
        }
      }
    });
  };
  function getVariantIdFromCard(card) {
    // Assuming each card has data attributes or a structure to map to the variant ID
    const planRadio = card.querySelector('input[name="selling_plan"]');
    const planId = planRadio ? planRadio.value : null;

    if (!planId) return null;
    // You can fetch the corresponding variant ID from the global `variantSellingPlans` map
    const variantSellingPlans = window.variantSellingPlans || {};
    for (let variantId in variantSellingPlans) {
      if (variantSellingPlans[variantId].includes(planId)) {
        return variantId;
      }
    }
    return null; // Return null if no matching variant is found
  }
  function formatMoney(cents) {
    if (window.Shopify && typeof Shopify.formatMoney === 'function') {
      return Shopify.formatMoney(
        cents,
        window.theme && window.theme.moneyFormat ? window.theme.moneyFormat : '${{amount}}'
      );
    }
    return (cents / 100).toFixed(2);
  }
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.program-card').forEach(function (card) {
      const radio = card.querySelector('.program-card__radio');

      // Automatically select and activate the correct program-card based on the selected variant on page load
      if (radio && radio.checked) {
        const variantId = getVariantIdFromCard(card);
        if (variantId) {
          window.selectVariantViaSwatch(variantId);
          card.classList.add('program-card--active');

          const subscriptionType = radio.getAttribute('data-subscription-type');
          const correspondingCardInfo = document.querySelector(
            `.card-info[data-subscription-type="${subscriptionType}"]`
          );
          if (correspondingCardInfo) {
            correspondingCardInfo.classList.remove('hidden');
          }
        }
      }

      // Listen for click events on the card
      card.addEventListener('click', function (e) {
        const tag = e.target.tagName.toLowerCase();
        if (tag === 'select' || tag === 'input' || tag === 'button') return;

        if (radio) {
          radio.click();
        }

        const variantId = getVariantIdFromCard(card);
        if (variantId) {
          window.selectVariantViaSwatch(variantId);
        }

        document.querySelectorAll('.program-card').forEach(function (c) {
          c.classList.remove('program-card--active');
        });

        card.classList.add('program-card--active');

        const subscriptionType = radio.getAttribute('data-subscription-type');
        const correspondingCardInfo = document.querySelector(
          `.card-info[data-subscription-type="${subscriptionType}"]`
        );

        if (correspondingCardInfo) {
          correspondingCardInfo.classList.remove('hidden');
        }

        document.querySelectorAll('.card-info').forEach(function (cardInfo) {
          if (cardInfo !== correspondingCardInfo) {
            cardInfo.classList.add('hidden');
          }
        });

        // Trigger the first subscription if it's a "regular-subscriptions" type
        if (subscriptionType === 'regular-subscriptions') {
          // Directly find the radio input inside the regular subscriptions card-info
          const regularSubscriptionRadio = document.querySelector(
            '.regular-subscriptions-main input[name="selling-plan-group-regular"]'
          );
          const regularSubscriptionCard = regularSubscriptionRadio.closest('.program-card');
          if (regularSubscriptionRadio) {
            regularSubscriptionRadio.checked = true;
            const variantId = getVariantIdFromCard(regularSubscriptionCard);
            if (variantId) {
              window.selectVariantViaSwatch(variantId);
            }
            regularSubscriptionRadio.dispatchEvent(new Event('change')); // Trigger the change event
          }
        }
        // If the subscription type is "supply-amount", trigger the first variant under card-info
        if (subscriptionType === 'supply-amount') {
          const supplyAmountCardInfo = document.querySelector('.card-info[data-subscription-type="supply-amount"]');
          if (supplyAmountCardInfo) {
            const firstRadioInput = supplyAmountCardInfo.querySelector('.radio__input');
            if (firstRadioInput) {
              // Check the first radio input
              firstRadioInput.checked = true;

              // Trigger the variant selection associated with the radio input
              const variantId = getVariantIdFromCard(card);
              if (variantId) {
                window.selectVariantViaSwatch(variantId);
              }

              // Dispatch the change event
              firstRadioInput.dispatchEvent(new Event('change'));
            }
          }
        }
      });
      const regularSubRadios = document.querySelectorAll(
        '.card-info[data-subscription-type="supply-amount"] .radio__input'
      );

      regularSubRadios.forEach(function (radio) {
        radio.addEventListener('change', function () {
          allowOneTimePriceUpdate = true;
        });
      });
    });

    // Handle regular subscription prices
    function updateRegularSubscriptionMainCard(radio) {
      if (!radio) return;

      var priceCents = parseInt(radio.dataset.cardPrice || '0', 10);
      var compareCents = parseInt(radio.dataset.cardComparePrice || '0', 10);

      var mainCard = document.querySelector('.program-card--regular-subscriptions-general');
      if (!mainCard) return;

      var priceEl = mainCard.querySelector('.program-card__price');
      var compareEl = mainCard.querySelector('.program-card__price--compare');
      var discountBadge = mainCard.querySelector('.discount-badge');
      var discountSpan = discountBadge ? discountBadge.querySelector('.subscription-save-amount') : null;

      // Update main price
      if (priceEl) {
        priceEl.textContent = formatMoney(priceCents);
      }

      // Update compare-at price
      if (compareEl) {
        if (compareCents && compareCents > priceCents) {
          compareEl.textContent = formatMoney(compareCents);
          compareEl.style.display = '';
        } else {
          compareEl.style.display = 'none';
        }
      }

      // Update discount badge
      if (discountBadge && discountSpan) {
        if (compareCents && compareCents > priceCents) {
          var discount = Math.round(((compareCents - priceCents) * 100) / compareCents);
          discountSpan.textContent = discount;
          discountBadge.style.display = '';
        } else {
          discountBadge.style.display = 'none';
        }
      }
    }

    // Listen for changes on the regular subscription plan radios
    var regularPlanRadios = document.querySelectorAll('.selling_plan_program-card__radio');

    regularPlanRadios.forEach(function (radio) {
      radio.addEventListener('change', function () {
        updateRegularSubscriptionMainCard(radio);
      });
    });

    // Initialize on page load with the currently checked radio (if any)
    var initiallyChecked = document.querySelector('.selling_plan_program-card__radio:checked');
    if (initiallyChecked) {
      updateRegularSubscriptionMainCard(initiallyChecked);
    }
  });

  // Listen for the variantChanged event globally
  document.addEventListener('variantChanged', function (event) {
    const variant = event.detail.variant;
    const variantId = variant.id;
    const sellingPlanGroupId = variant.selling_plan_group_id;

    if (!allowOneTimePriceUpdate) {
      return;
    }

    const oneTimeCard = document.querySelector('.program-card--one-time.program-card--active');
    if (!oneTimeCard || !variant) return;

    const priceEl = oneTimeCard.querySelector('.program-card__price');
    const compareEl = oneTimeCard.querySelector('.program-card__price--compare');
    if (priceEl) {
      priceEl.textContent = formatMoney(variant.price);
    }

    if (compareEl) {
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        compareEl.textContent = formatMoney(variant.compare_at_price);
        compareEl.style.display = '';
      } else {
        compareEl.style.display = 'none';
      }
    }
  });
</script>