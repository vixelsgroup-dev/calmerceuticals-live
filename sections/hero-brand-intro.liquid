<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;1,9..40,400&family=Inter:wght@400&family=Lexend:wght@400&display=swap"
>
<link rel="stylesheet" href="{{ 'hero-brand-intro.css' | asset_url }}">

{% liquid
  assign show_founder = false
  if section.settings.show_founder_message != false
    if section.settings.founder_video != blank or section.settings.founder_image != blank
      assign show_founder = true
    endif
  endif
  assign has_hero_ctas = false
  if section.settings.button_label != blank or section.settings.formula_button_label != blank
    assign has_hero_ctas = true
  endif

  assign hero_video_mobile_url = section.settings.hero_video_mobile_url | strip
  assign has_mobile_hero_shopify = false
  if section.settings.hero_video_mobile != blank
    assign has_mobile_hero_shopify = true
  endif
  assign has_mobile_hero_url = false
  if hero_video_mobile_url != blank
    assign has_mobile_hero_url = true
  endif
  assign has_separate_mobile_hero_video = false
  if has_mobile_hero_shopify or has_mobile_hero_url
    assign has_separate_mobile_hero_video = true
  endif
  assign use_mobile_video_hero_layout = false
  if section.settings.hero_video != blank
    assign use_mobile_video_hero_layout = true
  endif

  assign lcp_poster_desktop_url = ''
  assign lcp_poster_mobile_url = ''
  assign lcp_poster_two_images = false
  if section.settings.hero_video != blank
    if section.settings.hero_lcp_poster_desktop != blank
      assign lcp_poster_desktop_url = section.settings.hero_lcp_poster_desktop | image_url: width: 1800
    elsif section.settings.hero_image != blank
      assign lcp_poster_desktop_url = section.settings.hero_image | image_url: width: 1800
    elsif section.settings.hero_video.preview_image != blank
      assign lcp_poster_desktop_url = section.settings.hero_video.preview_image | image_url: width: 1800
    endif

    if section.settings.hero_lcp_poster_mobile != blank
      assign lcp_poster_mobile_url = section.settings.hero_lcp_poster_mobile | image_url: width: 1200
    elsif lcp_poster_desktop_url != blank
      assign lcp_poster_mobile_url = lcp_poster_desktop_url
    endif

    if section.settings.hero_lcp_poster_mobile != blank and lcp_poster_mobile_url != lcp_poster_desktop_url
      assign lcp_poster_two_images = true
    endif
  endif
%}

<section
  id="HeroBrandIntro-{{ section.id }}"
  class="hero-brand-intro{% if use_mobile_video_hero_layout %} hero-brand-intro--has-hero-video{% endif %}"
  style="--hbi-section-bg: {{ section.settings.background_color | default: '#f5f5f5' }};"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}Hero{% endif %}"
  {{ section.shopify_attributes }}
>
  {% liquid
    assign hero_alt = section.settings.hero_image.alt | default: section.settings.heading | strip_html | escape
    if hero_alt == blank
      assign hero_alt = 'Hero' | escape
    endif
  %}

  <div class="hero-brand-intro__inner">
    <div class="hero-brand-intro__media">
      {% if section.settings.hero_video != blank and lcp_poster_desktop_url != blank %}
        {% if lcp_poster_two_images %}
          {% if section.settings.hero_lcp_poster_desktop != blank %}
            {{
              section.settings.hero_lcp_poster_desktop
              | image_url: width: 1800
              | image_tag:
                class: 'hero-brand-intro__lcp-poster hero-brand-intro__lcp-poster--desktop',
                loading: 'eager',
                fetchpriority: 'high',
                decoding: 'async',
                sizes: '100vw',
                widths: '450, 900, 1200, 1500, 1800',
                alt: ''
            }}
          {% elsif section.settings.hero_image != blank %}
            {{
              section.settings.hero_image
              | image_url: width: 1800
              | image_tag:
                class: 'hero-brand-intro__lcp-poster hero-brand-intro__lcp-poster--desktop',
                loading: 'eager',
                fetchpriority: 'high',
                decoding: 'async',
                sizes: '100vw',
                widths: '450, 900, 1200, 1500, 1800',
                alt: ''
            }}
          {% elsif section.settings.hero_video.preview_image != blank %}
            {{
              section.settings.hero_video.preview_image
              | image_url: width: 1800
              | image_tag:
                class: 'hero-brand-intro__lcp-poster hero-brand-intro__lcp-poster--desktop',
                loading: 'eager',
                fetchpriority: 'high',
                decoding: 'async',
                sizes: '100vw',
                widths: '450, 900, 1200, 1500, 1800',
                alt: ''
            }}
          {% endif %}
          {{
            section.settings.hero_lcp_poster_mobile
            | image_url: width: 1200
            | image_tag:
              class: 'hero-brand-intro__lcp-poster hero-brand-intro__lcp-poster--mobile',
              loading: 'eager',
              fetchpriority: 'high',
              decoding: 'async',
              sizes: '100vw',
              widths: '400, 600, 800, 1000, 1200',
              alt: ''
          }}
        {% elsif section.settings.hero_lcp_poster_desktop != blank %}
          {{
            section.settings.hero_lcp_poster_desktop
            | image_url: width: 1800
            | image_tag:
              class: 'hero-brand-intro__lcp-poster',
              loading: 'eager',
              fetchpriority: 'high',
              decoding: 'async',
              sizes: '100vw',
              widths: '450, 900, 1200, 1500, 1800',
              alt: ''
          }}
        {% elsif section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              class: 'hero-brand-intro__lcp-poster',
              loading: 'eager',
              fetchpriority: 'high',
              decoding: 'async',
              sizes: '100vw',
              widths: '450, 900, 1200, 1500, 1800',
              alt: ''
          }}
        {% elsif section.settings.hero_video.preview_image != blank %}
          {{
            section.settings.hero_video.preview_image
            | image_url: width: 1800
            | image_tag:
              class: 'hero-brand-intro__lcp-poster',
              loading: 'eager',
              fetchpriority: 'high',
              decoding: 'async',
              sizes: '100vw',
              widths: '450, 900, 1200, 1500, 1800',
              alt: ''
          }}
        {% endif %}
      {% endif %}
      {% if section.settings.hero_video != blank %}
        {% if has_separate_mobile_hero_video %}
          {% if lcp_poster_desktop_url != blank %}
            {{
              section.settings.hero_video
              | video_tag:
                class: 'hero-brand-intro__img hero-brand-intro__video--desktop-only',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                poster: lcp_poster_desktop_url,
                preload: 'metadata'
            }}
          {% else %}
            {{
              section.settings.hero_video
              | video_tag:
                class: 'hero-brand-intro__img hero-brand-intro__video--desktop-only',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                preload: 'metadata'
            }}
          {% endif %}
          {% if has_mobile_hero_shopify %}
            {% if lcp_poster_mobile_url != blank %}
              {{
                section.settings.hero_video_mobile
                | video_tag:
                  class: 'hero-brand-intro__img hero-brand-intro__video--mobile-only',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  poster: lcp_poster_mobile_url,
                  preload: 'metadata'
              }}
            {% else %}
              {{
                section.settings.hero_video_mobile
                | video_tag:
                  class: 'hero-brand-intro__img hero-brand-intro__video--mobile-only',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'metadata'
              }}
            {% endif %}
          {% elsif has_mobile_hero_url %}
            <video
              class="hero-brand-intro__img hero-brand-intro__video--mobile-only"
              src="{{ hero_video_mobile_url }}"
              {% if lcp_poster_mobile_url != blank %}
                poster="{{ lcp_poster_mobile_url | escape }}"
              {% endif %}
              autoplay
              muted
              loop
              playsinline
              webkit-playsinline
              preload="metadata"
            ></video>
          {% endif %}
        {% else %}
          {% if lcp_poster_desktop_url != blank %}
            {{
              section.settings.hero_video
              | video_tag:
                class: 'hero-brand-intro__img',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                poster: lcp_poster_desktop_url,
                preload: 'metadata'
            }}
          {% else %}
            {{
              section.settings.hero_video
              | video_tag:
                class: 'hero-brand-intro__img',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                preload: 'metadata'
            }}
          {% endif %}
        {% endif %}
      {% elsif section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'hero-brand-intro__img',
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(max-width: 749px) calc(100vw - 36px), (max-width: 1199px) 45vw, 42vw',
            widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400',
            alt: hero_alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: class: 'hero-brand-intro__img hero-brand-intro__placeholder-svg' }}
      {% endif %}
    </div>

    <div class="hero-brand-intro__layout wrapper{% unless has_hero_ctas %} hero-brand-intro__layout--no-cta{% endunless %}">
      <div class="hero-brand-intro__copy">
        <div class="hero-brand-intro__heading-block">
          {% if section.settings.tagline_lead != blank
            or section.settings.badge_text != blank
            or section.settings.tagline_trail != blank
          %}
            <div class="hero-brand-intro__tagline">
              {% if section.settings.tagline_lead != blank or section.settings.badge_text != blank %}
                <div class="hero-brand-intro__tagline-line1">
                  {% if section.settings.tagline_lead != blank %}
                    <span class="hero-brand-intro__tagline-text">{{ section.settings.tagline_lead | escape }}</span>
                  {% endif %}
                  {% if section.settings.badge_text != blank %}
                    <span class="hero-brand-intro__badge">{{ section.settings.badge_text | escape }}</span>
                  {% endif %}
                </div>
              {% endif %}
              {% if section.settings.tagline_trail != blank %}
                <p class="hero-brand-intro__tagline-text hero-brand-intro__tagline-trail">
                  {{ section.settings.tagline_trail | escape }}
                </p>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h1 class="hero-brand-intro__heading">{{ section.settings.heading | escape }}</h1>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <p class="hero-brand-intro__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>

        {% if section.settings.button_label != blank or section.settings.formula_button_label != blank %}
          <div class="hero-brand-intro__actions hero-brand-intro__actions--desktop-only">
            {% if section.settings.button_label != blank %}
              <a
                href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
                class="hero-brand-intro__cta"
              >
                <span class="hero-brand-intro__cta-shine" aria-hidden="true"></span>
                <span class="hero-brand-intro__cta-avatar" aria-hidden="true">
                  {% render 'hero-brand-intro-cta-avatar', cta_avatar: section.settings.cta_avatar %}
                </span>
                <span class="hero-brand-intro__cta-label">{{ section.settings.button_label | escape }}</span>
              </a>
            {% endif %}

            {% if section.settings.formula_button_label != blank %}
              <a
                href="{% if section.settings.formula_button_link != blank %}{{ section.settings.formula_button_link }}{% else %}{{ routes.root_url }}{% endif %}"
                class="hero-brand-intro__second-cta"
              >
                <span class="hero-brand-intro__second-cta-inner">
                  <span class="hero-brand-intro__second-cta-row">
                    <span class="hero-brand-intro__second-cta-label">
                      {{- section.settings.formula_button_label | escape -}}
                    </span>
                    <span class="hero-brand-intro__second-cta-icon" aria-hidden="true">
                      {% render 'icon-arrow-up-right' %}
                    </span>
                  </span>
                  <span class="hero-brand-intro__second-cta-rule"></span>
                </span>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank or section.settings.formula_button_label != blank %}
        <div class="hero-brand-intro__actions hero-brand-intro__actions--mobile-only">
          {% if section.settings.button_label != blank %}
            <a
              href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
              class="hero-brand-intro__cta"
            >
              <span class="hero-brand-intro__cta-shine" aria-hidden="true"></span>
              <span class="hero-brand-intro__cta-avatar" aria-hidden="true">
                {% render 'hero-brand-intro-cta-avatar', cta_avatar: section.settings.cta_avatar %}
              </span>
              <span class="hero-brand-intro__cta-label">{{ section.settings.button_label | escape }}</span>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if show_founder %}
      <div
        class="hero-brand-intro__founder-row"
        data-hero-founder-row
        tabindex="0"
        role="group"
        aria-expanded="false"
        aria-label="{{ section.settings.founder_label | default: 'Founder message' | escape }}"
      >
        <button
          type="button"
          class="hero-brand-intro__founder-close"
          data-hero-founder-close
          aria-label="{{ 'general.accessibility.close' | t }}"
        >
          <span class="hero-brand-intro__founder-close-icon" aria-hidden="true">
            {% render 'icon-close' %}
          </span>
        </button>
        <div class="hero-brand-intro__founder">
          <div class="hero-brand-intro__founder-visual">
            {% if section.settings.founder_video != blank %}
              {% liquid
                assign founder_poster = ''
                if section.settings.founder_image != blank
                  assign founder_poster = section.settings.founder_image | image_url: width: 800
                endif
              %}
              {% if founder_poster != blank %}
                {{
                  section.settings.founder_video
                  | video_tag:
                    class: 'hero-brand-intro__founder-video',
                    autoplay: true,
                    muted: true,
                    loop: true,
                    controls: false,
                    playsinline: true,
                    poster: founder_poster
                }}
              {% else %}
                {{
                  section.settings.founder_video
                  | video_tag:
                    class: 'hero-brand-intro__founder-video',
                    autoplay: true,
                    muted: true,
                    loop: true,
                    controls: false,
                    playsinline: true
                }}
              {% endif %}
            {% elsif section.settings.founder_image != blank %}
              {% liquid
                assign founder_img_alt = section.settings.founder_image.alt | default: section.settings.founder_label | strip_html | escape
                if founder_img_alt == blank
                  assign founder_img_alt = 'Founder' | escape
                endif
              %}
              {{
                section.settings.founder_image
                | image_url: width: 800
                | image_tag: class: 'hero-brand-intro__founder-img', loading: 'lazy', alt: founder_img_alt
              }}
            {% endif %}
          </div>
          {% if section.settings.founder_label != blank %}
            <p class="hero-brand-intro__founder-caption">{{ section.settings.founder_label | escape }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script src="{{ 'hero-brand-intro.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hero — brand intro",
  "tag": "section",
  "class": "section-hero-brand-intro",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f5f5f5",
      "info": "Shows behind the hero image (e.g. while loading) and in any letterboxing."
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero Video"
    },
    {
      "type": "video",
      "id": "hero_video_mobile",
      "label": "Hero video (mobile)",
      "info": "Optional. When set, narrow screens use this clip instead of the main hero video."
    },
    {
      "type": "text",
      "id": "hero_video_mobile_url",
      "label": "Hero video URL (mobile)",
      "default": "https://cdn.shopify.com/videos/c/o/v/8bc46b0bde37487e931f3b94a565947d.mp4",
      "info": "Optional direct MP4 link for mobile. Used when no mobile hero video is uploaded above. If both are empty, mobile uses the main hero video."
    },
    {
      "type": "header",
      "content": "Video posters (LCP)"
    },
    {
      "type": "image_picker",
      "id": "hero_lcp_poster_desktop",
      "label": "Poster image (desktop)",
      "info": "Shown full-width behind the hero until the desktop video plays. If empty, falls back to Hero image, then the main video preview."
    },
    {
      "type": "image_picker",
      "id": "hero_lcp_poster_mobile",
      "label": "Poster image (mobile)",
      "info": "Shown until the mobile hero video plays. If empty, uses the desktop poster (or Hero image / video preview). Upload a different file here only when you need a separate mobile crop."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Without a hero video: main hero visual. With a video: fallback for desktop/mobile posters when the poster pickers above are empty."
    },
    {
      "type": "text",
      "id": "tagline_lead",
      "label": "Tagline (before badge)",
      "default": "Australia's"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "#1 Collagen"
    },
    {
      "type": "text",
      "id": "tagline_trail",
      "label": "Tagline (after badge)",
      "default": "— Proven, Trusted, Certified"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collagen, Reinvented"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We utilize advanced hydrolysed technology that delivers visible benefits from within, setting an entirely new standard in beauty supplements."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "cta_avatar",
      "label": "Button avatar image",
      "info": "Circular mark left of the CTA. A Shopify placeholder is used if empty."
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "formula_button_label",
      "label": "Label",
      "default": "Find Formula"
    },
    {
      "type": "url",
      "id": "formula_button_link",
      "label": "Link",
      "info": "e.g. quiz or collections page"
    },
    {
      "type": "header",
      "content": "Founder message"
    },
    {
      "type": "checkbox",
      "id": "show_founder_message",
      "label": "Show founder message",
      "default": true,
      "info": "Turn off to hide the expandable founder video or image below the hero."
    },
    {
      "type": "video",
      "id": "founder_video",
      "label": "Founder video",
      "info": "Portrait clip (autoplay, muted, loop). Shown below the hero."
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder image or GIF",
      "info": "If no video: shown in the frame. If video is set: optional poster (first frame) while the video loads."
    },
    {
      "type": "text",
      "id": "founder_label",
      "label": "Caption under video",
      "default": "Founder Message"
    }
  ],
  "presets": [
    {
      "name": "Hero — brand intro"
    }
  ]
}
{% endschema %}
