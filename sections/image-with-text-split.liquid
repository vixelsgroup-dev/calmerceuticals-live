{% comment %}
  Image Text Split Section — Fixed
  - Grid is always on the inner wrapper, never on .wrapper class
  - Image left or right toggle
  - Checklist blocks + Numbered step blocks
  - All fields optional / blank-safe
{% endcomment %}

<style>
    #shopify-section-{{ section.id }} .its-section {
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top }}px !important;
      padding-bottom: {{ section.settings.padding_bottom }}px !important;
    }

    /* .wrapper only handles max-width, never grid */
    #shopify-section-{{ section.id }} .its-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.gap }}px;
      align-items: center;
    }

    /* Image right = swap order */
    #shopify-section-{{ section.id }} .its-inner.its-img-right .its-image-col { order: 2; }
    #shopify-section-{{ section.id }} .its-inner.its-img-right .its-text-col  { order: 1; }

    /* Image column */
    #shopify-section-{{ section.id }} .its-image-col {
      width: 100%;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .its-image-col img {
      width: 100%;
      height: {{ section.settings.image_height }}px;
      object-fit: cover;
      border-radius: {{ section.settings.image_border_radius }}px;
      object-position: {{section.settings.object_position }};
    }

    #shopify-section-{{ section.id }} .its-image-placeholder {
      width: 100%;
      height: {{ section.settings.image_height }}px;
      background: #f0e8e0;
      border-radius: {{ section.settings.image_border_radius }}px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #b89280;
      font-family: "Jost", sans-serif;
      font-size: 14px;
    }

    /* Text column */
    #shopify-section-{{ section.id }} .its-text-col {
      display: flex;
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .heading-col {
      margin-bottom : 24px;
  }
   #shopify-section-{{ section.id }} .heading-col > * {
      font-family: "Jost", sans-serif;
      font-size: {{ section.settings.heading_font_size }}px;
      color: {{ section.settings.heading_color }};
      font-weight: 500;
      margin: 0;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .its-richtext strong{color : #610C27; font-size: 32px; font-weight: 600;}

    #shopify-section-{{ section.id }} .its-richtext p { margin: 0 0 16px; font-family: "Jost", sans-serif; font-size: {{ section.settings.text_font_size }}px; color: {{ section.settings.text_color }}; font-weight: 400; line-height: 1.65;  }
    #shopify-section-{{ section.id }} .its-richtext p:last-child { margin-bottom: 0; }

    /* Checklist */
    #shopify-section-{{ section.id }} .its-checklist {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .its-checklist li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-family: "Jost", sans-serif;
      font-size: {{ section.settings.text_font_size }}px;
      color: {{ section.settings.text_color }};
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .its-checklist li svg {
      flex-shrink: 0;
      margin-top: 2px;
    }

    /* Numbered Steps */
    #shopify-section-{{ section.id }} .its-steps {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    #shopify-section-{{ section.id }} .its-step-heading {
      font-family: "Jost", sans-serif;
      font-size: {{ section.settings.step_heading_size }}px;
      color: {{ section.settings.heading_color }};
      font-weight: 600;
      margin: 0 0 5px;
      line-height: 1.3;
    }

    #shopify-section-{{ section.id }} .its-step-text {
      font-family: "Jost", sans-serif;
      font-size: {{ section.settings.text_font_size }}px;
      color: {{ section.settings.text_color }};
      margin: 0;
      line-height: 1.65;
    }
    /* Mobile/Desktop image switching */
    #shopify-section-{{ section.id }} .its-img-mobile {
      display: none;
    }
    #shopify-section-{{ section.id }} .its-img-desktop {
      display: block;
    }
    @media screen and (min-width: 768px){
      #shopify-section-{{ section.id }} .its-text-col.text-center-width{
        max-width: 500px;
        margin: 0 auto;
      }
    }

    /* Mobile */
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .text-center-mobile{text-align: center;}
      #shopify-section-{{ section.id }} .its-section {
        padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
        padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
      }
      #shopify-section-{{ section.id }} .its-section .wrapper{
        padding: 0;
      }
      #shopify-section-{{ section.id }} .its-inner {
        grid-template-columns: 1fr !important;
        gap: 24px;
      }

      #shopify-section-{{ section.id }} .its-inner .its-image-col { order: 1 !important; }
      #shopify-section-{{ section.id }} .its-inner .its-text-col  { order: 2 !important; padding: 0 var(--gutter-mobile); margin: 96px 0; }
      #shopify-section-{{ section.id }} .its-image-col img{height: auto !important;}
      #shopify-section-{{ section.id }} .its-img-mobile {
        display: block;
      }
      #shopify-section-{{ section.id }} .its-img-desktop {
        display: none;
      }
    }
</style>

<section class="its-section">
  {% if section.settings.container_width %}<div class="wrapper">{% endif %}

  <div class="its-inner{% if section.settings.image_position == 'right' %} its-img-right{% endif %}">
    {%- comment -%} Image Column {%- endcomment -%}
    <div class="its-image-col">
      {% if section.settings.image != blank %}
        {% assign display_image = section.settings.image %}
        {% if section.settings.image_mobile != blank %}
          <img
            src="{{ section.settings.image_mobile | img_url: '900x' }}"
            alt="{{ section.settings.image_mobile.alt | default: section.settings.image.alt }}"
            loading="lazy"
            width="900"
            class="its-img-mobile"
          >
          <img
            src="{{ section.settings.image | img_url: '900x' }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading }}"
            loading="lazy"
            width="900"
            class="its-img-desktop"
          >
        {% else %}
          <img
            src="{{ section.settings.image | img_url: '900x' }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading }}"
            loading="lazy"
            width="900"
          >
        {% endif %}
      {% else %}
        <div class="its-image-placeholder">Select an image</div>
      {% endif %}
    </div>

    {%- comment -%} Text Column {%- endcomment -%}
    <div class="its-text-col {% if section.settings.text_center_richtext %} text-center-width {% endif %}">
      <div class="heading-col {%  if section.settings.text_center_mobile %} text-center-mobile {% endif %}">
        {{ section.settings.heading }}
      </div>

      {% if section.settings.description != blank %}
        <div class="its-richtext">{{ section.settings.description }}</div>
      {% endif %}

      {%- comment -%} Checklist blocks {%- endcomment -%}
      {% assign checklist_blocks = section.blocks | where: 'type', 'checklist_item' %}
      {% if checklist_blocks.size > 0 %}
        <ul class="its-checklist">
          {% for block in checklist_blocks %}
            {% if block.settings.text != blank %}
              <li {{ block.shopify_attributes }}>
                <img
                  src="https://cdn.shopify.com/s/files/1/0657/6907/8877/files/tick_Calmer.svg?v=1757587368"
                  fetchpriority="low"
                  decoding="async"
                  loading="lazy"
                >
                {{ block.settings.text }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {%- comment -%} Numbered step blocks {%- endcomment -%}
      {% assign step_blocks = section.blocks | where: 'type', 'step' %}
      {% if step_blocks.size > 0 %}
        <ol class="its-steps">
          {% for block in step_blocks %}
            <li {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <p class="its-step-heading">{{ forloop.index }}. {{ block.settings.heading }}</p>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="its-step-text">{{ block.settings.text }}</p>
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      {% endif %}
    </div>
  </div>

  {% if section.settings.container_width %}</div>{% endif %}
</section>

{% schema %}
{
  "name": "Image + Text Split",
  "tag": "section",
  "class": "its-wrapper",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "container_width",
      "label": "Use Container Width",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Image Left, Text Right" },
        { "value": "right", "label": "Image Right, Text Left" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap Between Columns",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (Mobile)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 200,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Image Height (desktop)",
      "default": 690
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Corner Radius",
      "default": 0
    },
    {
      "type": "select",
      "id": "object_position",
      "label": "Object Position",
      "options": [
        { "value": "top center", "label": "Top Center" },
        { "value": "center center", "label": "Center Center" },
        { "value": "bottom center", "label": "Bottom Center" }
      ]
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "checkbox",
      "id": "text_center_richtext",
      "label": "Text Center With Max Width In Desktop",
      "default": false
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Ideal for women who want to :</p>"
    },
    {
      "type": "checkbox",
      "id": "text_center_mobile",
      "label": "Text Center In Mobile",
      "default": false
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description (optional)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Checkmark Color",
      "default": "#c0505a"
    },
    {
      "type": "header",
      "content": "Font Sizes"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "step_heading_size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Step Heading Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_font_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Body Text Size",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "checklist_item",
      "name": "✓ Checklist Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Support natural hormone balance and resilience"
        }
      ]
    },
    {
      "type": "step",
      "name": "Numbered Step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Step Heading",
          "default": "Target the Foundation"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step Description",
          "default": "We go beyond surface-level energy. Our formula works at the root to balance hormones and reduce the internal fatigue that holds you back."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image + Text (Checklist)",
      "settings": {
        "image_position": "left",
        "heading": "<p>Ideal for women who want to :</p>"
      },
      "blocks": [
        { "type": "checklist_item", "settings": { "text": "Support natural hormone balance and resilience" } },
        { "type": "checklist_item", "settings": { "text": "Sustain energy and focus throughout the day" } },
        { "type": "checklist_item", "settings": { "text": "Enhance mood, clarity, and overall performance" } },
        { "type": "checklist_item", "settings": { "text": "Promote strength, recovery, and inner vitality" } },
        { "type": "checklist_item", "settings": { "text": "Feel centred, confident, and in control — every day" } }
      ]
    },
    {
      "name": "Image + Text (How it Works)",
      "settings": {
        "image_position": "right",
        "heading": "<p>How it works</p>"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "Target the Foundation",
            "text": "We go beyond surface-level energy. Our formula works at the root to balance hormones and reduce the internal fatigue that holds you back, preparing your body for a total reset."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Elevate Your Daily Performance",
            "text": "Feel the shift in real-time. By fueling your cells with activated B vitamins and L-Theanine, Ultra Performance provides the calm focus and physical endurance needed to dominate your work and workouts."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Results You Can See and Feel",
            "text": "This is a compounding system. Within weeks, the synergy of collagen and adaptogens manifests as radiant skin, improved libido, and a consistent, high-energy state that feels entirely natural."
          }
        }
      ]
    }
  ]
}
{% endschema %}
