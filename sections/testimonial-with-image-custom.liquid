      "label": "Highlighted word(s)",
      "info": "This part appears in the accent color (e.g. 'Calmerceuticals')",
      "default": "Calmerceuticals"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading (rest of text)",
