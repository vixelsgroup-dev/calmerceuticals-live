{%- liquid
  assign unique = section.id
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign gradient = section.settings.gradient | default: 'none'
  assign section_width = section.settings.width
  assign equalize_height = section.settings.equalize_height
  assign columns = section.settings.columns
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign layout_desktop = section.settings.layout_desktop
  assign layout_mobile = section.settings.layout_mobile
  assign heading_size = section.settings.heading_size | times: 0.01
  assign show_borders = section.settings.show_borders
  assign desktop_aspect_ratio = section.settings.desktop_aspect_ratio | times: 100
  assign mobile_aspect_ratio = section.settings.mobile_aspect_ratio | times: 100
  assign color_borders = section.settings.color_borders
  assign id = 'SectionColumns--' | append: section.id
  assign selector_id = '#' | append: id
  assign animation_anchor = selector_id
  assign animations_enabled = settings.animations_enabled
  assign animation_delay = 150
  assign is_slider = false

  case layout_desktop
    when 'grid'
      assign layout_class = 'grid__container'
      assign item_class = ' grid__item'
      assign container_tag = 'div'
      assign container_class = 'grid'
    when 'carousel'
      assign layout_class = 'carousel__container'
      assign item_class = ' carousel__item'
      assign is_slider = true
      assign container_tag = 'columns-slider'
      assign container_class = 'carousel'
  endcase

  case layout_mobile
    when 'grid'
      assign mobile_width = 'mobile--one-half'
      assign mobile_class = ' grid--mobile'
    when 'stacked'
      assign mobile_width = 'mobile--one-whole'
      assign mobile_class = ' stacked--mobile'
    when 'carousel'
      assign mobile_class = ' carousel--mobile carousel--mobile--' | append: section.id

      case columns_mobile
        when 1
          assign mobile_width = 'mobile--one-whole'
        when 2
          assign mobile_width = 'mobile--one-half'
      endcase
  endcase

  case columns
    when 2
      assign item_width = 'one-half'
    when 3
      assign item_width = 'one-third'
    else
      assign item_width = 'one-quarter'
  endcase
-%}

<link
  href="{{ 'section-columns.css' | asset_url }}"
  rel="preload"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'"
>

{%- style -%}
  {{ selector_id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    {% if color_borders != 'rgba(0,0,0,0)' and color_borders != '' -%}
      --border: {{ color_borders }};
    {%- endif %}

    {% unless columns == 3 -%}
      --grid-tablet: repeat(2, minmax(0, 1fr));
    {%- endunless %}
  }

  {{ selector_id }} .section__heading { --adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ heading_size }}); }

  {% if columns_mobile > 1 -%}
    @media screen and (max-width: 767px) {
      {{ selector_id }} .carousel--mobile{display:block;--item-width-mobile: calc(100% / {{ columns_mobile }} - var(--grid-gutter));overflow:hidden;scroll-snap-type:none;}
      {{ selector_id }} .carousel--mobile .column-item{margin-right:var(--grid-gutter);}
    }
  {%- endif %}

  /* ── Full-bleed slider overrides ── */
  #shopify-section-{{ section.id }} {
    overflow: hidden;
  }

  /* Section header: heading left, arrows right — all inside padded wrapper */
  #shopify-section-{{ section.id }} .section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 60px;
    padding-right: 60px;
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .section__heading {
    margin: 0;
  }

  /* Arrow buttons */
  #shopify-section-{{ section.id }} .vl2-arrows {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .vl2-arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
  }

  #shopify-section-{{ section.id }} .vl2-arrow:hover {
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .vl2-arrow:hover svg {
    stroke: var(--bg, #fff);
  }

  #shopify-section-{{ section.id }} .vl2-arrow svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Full-bleed slider wrapper: overflow visible so cards bleed right */
  #shopify-section-{{ section.id }} .section-columns__wrapper {
    overflow: visible !important;
    padding-left: 60px; /* align first card with heading */
  }

  #shopify-section-{{ section.id }} columns-slider {
    overflow: visible !important;
  }

  /* Each card */
  #shopify-section-{{ section.id }} .column-item {
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .video {
    display: flex;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .video .play-icon {
    position: absolute;
    top: 0; right: 0; bottom: 0; left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0.15);
    cursor: pointer;
    transition: background 0.2s;
  }

  #shopify-section-{{ section.id }} .video .play-icon:hover {
    background-color: rgba(0,0,0,0.25);
  }

  #shopify-section-{{ section.id }} .video .play-icon svg { fill: #fff; }

  #shopify-section-{{ section.id }} video {
    width: 100%;
    aspect-ratio: 400 / 650;
    object-fit: cover;
    display: block;
  }

  /* Caption area below each card */
  #shopify-section-{{ section.id }} .column-item__caption {
    padding: 14px 4px 4px;
  }

  #shopify-section-{{ section.id }} .column-item__caption .caption-quote {
    font-size: 0.9em;
    font-style: italic;
    margin: 0 0 4px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .column-item__caption .caption-name {
    font-size: 0.8em;
    opacity: 0.65;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots {
    display: flex;
    justify-content: center;
    position: static;
    margin-top: 20px;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots .dot { width: 100%; }

  @media screen and (min-width: 1024px) {
    {{ selector_id }} {
      --grid: repeat({{ columns }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .section__header {
      padding-left: 20px;
      padding-right: 20px;
    }
    #shopify-section-{{ section.id }} .section-columns__wrapper {
      padding-left: 20px;
    }
  }
{%- endstyle -%}

<div
  id="{{ id }}"
  class="section-padding {{ color_scheme }} section-columns {{ section.settings.align_text }}"
  data-section-id="{{ unique }}"
  data-section-type="columns-with-image"
>
    <div class="">
  {%- if section.settings.title != '' -%}
    <div class="section__header">
      <h2
        class="section__heading h2"
        data-aos="fade-up"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-delay="{{ animation_delay }}"
        {%- assign animation_delay = animation_delay | plus: 150 -%}
      >
        {{ section.settings.title | newline_to_br }}
      </h2>

      {%- if layout_desktop == 'carousel' -%}
        <div class="vl2-arrows" aria-label="Slider controls">
          <button class="vl2-arrow vl2-arrow--prev" id="vl2-prev-{{ section.id }}" aria-label="Previous">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="vl2-arrow vl2-arrow--next" id="vl2-next-{{ section.id }}" aria-label="Next">
            <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="section-columns__wrapper {{ layout_class }}">
    {%- if section.blocks.size > 0 -%}
      {%- if layout_desktop == 'carousel' -%}
        <script src="{{ 'columns-with-image.js' | asset_url }}" defer></script>
      {%- endif -%}

      {%- if request.design_mode and is_slider -%}
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            if (window.sectionColumnsBlockSelectHandlerAttached) return;
            window.sectionColumnsBlockSelectHandlerAttached = true;

            document.addEventListener('shopify:block:select', (event) => {
              const target = event.target;
              const slider = target.closest('columns-slider');
              const flkty = (window.theme.Flickity && window.theme.Flickity.data(slider)) || null;
              if (!slider) return;

              if (flkty !== null && flkty.isActive) {
                const index = parseInt([...target.parentNode.children].indexOf(target));
                const slidesPerPage = parseInt(flkty.slides[0].cells.length);
                const groupIndex = Math.floor(index / slidesPerPage);

                if (!event.detail.load) {
                  flkty.select(groupIndex);
                  return;
                }

                const onTransitionEnd = () => {
                  requestAnimationFrame(() => {
                    flkty.select(groupIndex);
                    if (typeof slider.setSliderArrowsPosition === 'function') {
                      slider.setSliderArrowsPosition(slider);
                    }
                  });
                  flkty.viewport.removeEventListener('transitionend', onTransitionEnd);
                };

                flkty.viewport.addEventListener('transitionend', onTransitionEnd);
              } else {
                const sliderStyle = slider.currentStyle || window.getComputedStyle(slider);
                const sliderPadding = parseInt(sliderStyle.paddingLeft);
                const blockPositionLeft = target.offsetLeft - sliderPadding;
                slider.scrollTo({ top: 0, left: blockPositionLeft, behavior: 'smooth' });
              }
            });
          });
        </script>
      {%- endif -%}

      <{{ container_tag }} class="section-columns__slider {{ container_class }} {{ mobile_class }}" role="group" id="vl2-slider-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign unique = block.id

            if equalize_height == false
              assign desktop_aspect_ratio = 0.67 | times: 100
            endif

            if section_width == 'wrapper--full-padded'
              assign wrapper_width_lg = '(100vw - 120px)'
            endif
            if section_width == 'wrapper'
              assign wrapper_width_lg = '(1440px - 120px)'
            endif
          -%}

          <div
            id="columnItem--{{ block.id }}"
            class="column-item {{ item_class }} {{ item_width }} {{ mobile_width }}{% if show_borders %} column-item--border{% endif %}"
            {{ block.shopify_attributes }}
            data-slider-item
            {% if animations_enabled %}
              data-aos="fade"
              data-aos-delay="0"
              data-aos-duration="0"
              data-aos-anchor="{{ animation_anchor }}"
            {% endif %}
          >
            {%- style -%}
              #columnItem--{{ block.id }} .column-item__heading { --adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ heading_size }}); }

              #columnItemImage--{{ block.id }} {
                --aspect-ratio: {{ desktop_aspect_ratio }}%;
              }

              {% if equalize_height %}
                @media screen and (max-width: 767px) {
                  #columnItemImage--{{ block.id }} {
                    --aspect-ratio: {{ mobile_aspect_ratio }}%;
                  }
                }
              {% endif %}
            {%- endstyle -%}

            <div class="column-item__inner">
              <div
                id="columnItemImage--{{ block.id }}"
                class="column-item__image-wrapper"
                data-media-container
                {% if animations_enabled %}
                  data-aos="fade-up"
                  data-aos-anchor="{{ animation_anchor }}"
                  data-aos-delay="{{ animation_delay }}"
                  {%- assign animation_delay = animation_delay | plus: 150 -%}
                {% endif %}
              >
                <div class="video">
                  {% if block.settings.video != blank %}
                    {% assign poster_image = block.settings.thumbnail | image_url: width: 800 %}
                    {{ block.settings.video | video_tag:
                        controls: false,
                        autoplay: section.settings.autoplay,
                        loop: false,
                        muted: false,
                        playsinline: true,
                        poster: poster_image
                    }}
                  {% endif %}
                  {% unless section.settings.autoplay %}
                    <div id="play-{{ block.id }}" class="play-icon">
                      {%- render 'icon-play' -%}
                    </div>
                  {% endunless %}
                </div>
              </div>

              {%- if block.settings.caption_quote != blank or block.settings.caption_name != blank -%}
                <div class="column-item__caption">
                  {%- if block.settings.caption_quote != blank -%}
                    <p class="caption-quote">"{{ block.settings.caption_quote }}"</p>
                  {%- endif -%}
                  {%- if block.settings.caption_name != blank -%}
                    <p class="caption-name">- {{ block.settings.caption_name }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </{{ container_tag }}>
    {%- endif -%}

    {%- if section.blocks.size == 0 -%}
      {%- render 'no-blocks' -%}
    {%- endif -%}
  </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const sectionId = '{{ section.id }}';
  const container = document.querySelector('#vl2-slider-' + sectionId);

  if (!container) return;

  // ── Play / pause logic ──
  container.addEventListener('click', (event) => {
    const playIcon = event.target.closest('.play-icon');
    const videoWrapper = event.target.closest('.video');

    if (playIcon) {
      const video = playIcon.parentElement.querySelector('video');
      if (!video) return;
      video.play();
      playIcon.style.opacity = "0";
      playIcon.style.pointerEvents = "none";
      return;
    }

    if (videoWrapper && event.target.tagName.toLowerCase() === "video") {
      const video = event.target;
      const icon = videoWrapper.querySelector('.play-icon');
      if (video.paused) {
        video.play();
        if (icon) { icon.style.opacity = "0"; icon.style.pointerEvents = "none"; }
      } else {
        video.pause();
        if (icon) { icon.style.opacity = "1"; icon.style.pointerEvents = "auto"; }
      }
    }
  });

  container.querySelectorAll('.video video').forEach(video => {
    video.addEventListener('ended', () => {
      const icon = video.parentElement.querySelector('.play-icon');
      if (icon) { icon.style.opacity = "1"; icon.style.pointerEvents = "auto"; }
    });
  });

  // ── Custom prev/next arrows wired to Flickity ──
  const prevBtn = document.getElementById('vl2-prev-' + sectionId);
  const nextBtn = document.getElementById('vl2-next-' + sectionId);

  function getFlkty() {
    return (window.theme && window.theme.Flickity) ? window.theme.Flickity.data(container) : null;
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      const flkty = getFlkty();
      if (flkty) { flkty.previous(); } else { container.scrollBy({ left: -300, behavior: 'smooth' }); }
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      const flkty = getFlkty();
      if (flkty) { flkty.next(); } else { container.scrollBy({ left: 300, behavior: 'smooth' }); }
    });
  }
});

!function() {
  "use strict";
  document.addEventListener('DOMContentLoaded', function () {
    if (window.innerWidth <= 767) {
      const slider = document.querySelector('.carousel--mobile--{{ section.id }}');
      if (slider) {
        let flkty = window.theme.Flickity.data(slider);
        if (!flkty) {
          flkty = new window.theme.Flickity(slider, {
            cellAlign: 'left',
            contain: true,
            pageDots: true,
            prevNextButtons: false,
            wrapAround: true
          });
        }
      }
    }
  });
}();
</script>

{% schema %}
{
  "name": "Video list #3",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "default": 120,
      "min": 70,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Type",
      "default": "carousel",
      "options": [
        {"value": "grid", "label": "Grid"},
        {"value": "carousel", "label": "Carousel"}
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay"
    },
    {
      "type": "select",
      "id": "align_text",
      "label": "Text alignment",
      "default": "text-left",
      "options": [
        {"value": "text-left", "label": "Left"},
        {"value": "text-center", "label": "Centered"}
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns per row on desktop",
      "default": 3,
      "min": 2,
      "max": 4,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show borders",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Type",
      "default": "carousel",
      "options": [
        {"value": "grid", "label": "Grid"},
        {"value": "stacked", "label": "Stacked"},
        {"value": "carousel", "label": "Slider"}
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "visible_if": "{{ section.settings.layout_mobile == 'carousel' }}",
      "label": "Columns per slide on mobile",
      "default": "1",
      "options": [
        {"label": "1", "value": "1"},
        {"label": "2", "value": "2"}
      ]
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "checkbox",
      "id": "equalize_height",
      "label": "Equalize image heights",
      "default": true,
      "info": "This setting will overwrite image widths"
    },
    {
      "type": "range",
      "id": "desktop_aspect_ratio",
      "min": 0.5,
      "max": 1.5,
      "step": 0.1,
      "unit": ":1",
      "label": "Desktop height",
      "info": "Wide to tall",
      "default": 0.8
    },
    {
      "type": "range",
      "id": "mobile_aspect_ratio",
      "min": 0.5,
      "max": 1.5,
      "step": 0.1,
      "unit": ":1",
      "label": "Mobile height",
      "info": "Wide to tall",
      "default": 0.8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "color_borders",
      "label": "Borders",
      "default": "#000",
      "alpha": true
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Page width"}
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video_block",
      "name": "Column",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Video cover image"
        },
        {
          "type": "text",
          "id": "caption_quote",
          "label": "Caption quote",
          "info": "e.g. After trying it once I was hooked"
        },
        {
          "type": "text",
          "id": "caption_name",
          "label": "Caption name",
          "info": "e.g. Jordyn H."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video list #3",
      "category": "Storytelling",
      "blocks": [
        {
          "type": "video_block"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside"]
  }
}
{% endschema %}
