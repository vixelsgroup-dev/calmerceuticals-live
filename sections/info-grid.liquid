{% comment %}
  Generic Info Grid Section with Background Image + Cross Divider
{% endcomment %}

<section id="section-{{ section.id }}" class="info-grid-section">
  <div class="info-grid-container">
    <div class="info-grid-wrapper">
      {% for block in section.blocks %}
        <div class="info-grid-card" {{ block.shopify_attributes }}>
          {% if block.settings.icon %}
            <div class="info-grid-icon">
                {{ block.settings.icon | image_url: width: 120 | image_tag: alt: block.settings.title, loading: 'lazy'  }}
            </div>
          {% endif %}

          {% if block.settings.title %}
            <h3 class="info-grid-title">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text %}
            <p class="info-grid-text">{{ block.settings.text | newline_to_br }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

<style>
.info-grid-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
}

.info-grid-container {
    background: {{ section.settings.bg_gradient }};
    max-width: 1250px;
    margin: 0 auto;
    border-radius: 12px;
    padding: 60px 20px;
}

.info-grid-wrapper {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat({{ section.settings.num_of_cols }}, 1fr);
    background: rgba(255, 255, 255, 0.0);
}

.info-grid-card {
    text-align: center;
    padding: 40px 30px;
    background: rgba(255, 255, 255, 0.67);
    backdrop-filter: blur(5.400000095367432px);
}

.info-grid-icon img {
    max-width: 70px;
    height: auto;
    margin: 0 auto 18px;
}

.info-grid-title {
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 6px;
}

.info-grid-text {
    font-size: 14px;
    margin: 0;
    line-height: 1.5;
}

/* Mobile */
@media (max-width: 767px) {
    .info-grid-wrapper {
    grid-template-columns: 1fr;
    }

    .info-grid-card {
    border-right: none !important;
    border-bottom: 1px solid {{ section.settings.divider_color }};
    }

    .info-grid-card:last-child {
    border-bottom: none !important;
    }
}
</style>
</section>

{% schema %}
{
  "name": "Info Grid",
  "settings": [
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient"
    },
    {
      "type": "select",
      "id": "num_of_cols",
      "label": "Number of columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "2"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Line Color",
      "default": "#b46a7b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],

  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],

  "max_blocks": 4,

  "presets": [
    {
      "name": "Info Grid",
      "blocks": []
    }
  ]
}
{% endschema %}
