    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Top Center — Title & Subtitle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Before & After"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Based on 12 Weeks daily use."
    },
    {
      "type": "header",
      "content": "Middle Left — Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Left Heading",
      "default": "Real Men. Real Results."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Left Body Text",
      "default": "Don't just take our word for it. See the visible difference achieved with just 12 weeks of consistent daily use. Backed by clinical trials, our high-potency liquid collagen goes to work from within to noticeably reduce deep wrinkles, restore skin elasticity, and support thicker, healthier hair."
    },
    {
      "type": "header",
      "content": "Middle Right — Comparison Images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "text",
      "id": "before_caption",
      "label": "Before Caption",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    {
      "type": "text",
      "id": "after_caption",
      "label": "After Caption",
      "default": "After"
    },
    {
      "type": "header",
      "content": "Bottom Center — Buttons & Footnote"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary Button Label",
      "default": "START YOUR 12-WEEK TRANSFORMATION"
    },
    {
      "type": "url",
      "id": "btn_primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary Button Label",
      "default": "TRY IT ONCE"
    },
    {
      "type": "url",
      "id": "btn_secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote Text",
      "default": "Formulated with clinically researched bio-fermented polyphenols and triple-biotic synergy."
    },
    {
      "type": "header",
      "content": "Font Sizes"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Main Title Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle / Footnote Size",
      "default": 15
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 60,
      "step": 2,
