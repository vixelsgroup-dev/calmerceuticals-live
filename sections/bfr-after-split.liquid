      "label": "Left Heading Size",
      "default": 34
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Body / Button Size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Main Title Color",
      "default": "#5c1a3a"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "heading_color",
