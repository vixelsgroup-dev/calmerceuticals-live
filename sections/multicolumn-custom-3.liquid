<div class="multicolumn-custom">
    <div class="multicolumn-custom-inner wrapper">
        <div class="section__header text-center">
            {% if section.settings.heading != blank %}
                <h2 class="section__heading h2">
                    {{- section.settings.heading -}}
                </h2>
            {% endif %}
            {% if section.settings.subheading != blank %}
                <div class="text__content">
                    {{- section.settings.subheading -}}
                </div>
            {% endif %}
        </div>
        <div id="multi-items-{{ section.id }}" class="multi-items text-center" data-aos-intersection="0.3">
            <div class="multi-items-inner cols-{{ section.settings.desktop_columns }} multi-items-inner--slider-{{ section.id }}">
                {% for block in section.blocks %}
                    <div 
                        class="multi-item block-{{ block.id }}">
                        <div class="top">
                            {% if block.settings.title != blank %}
                                <div class="title">{{ block.settings.title }}</div>
                            {% endif %}
                            {% if block.settings.image != blank %}
                                <div class="image">{{ block.settings.image | image_url: width: 200 | image_tag }}</div>
                            {% endif %}
                        </div>
                        <div class="bottom">
                            {% if block.settings.text != blank %}
                                <div class="text text-{{ section.id }}">{{ block.settings.text }}</div>
                            {% endif %}
                            {% if block.settings.accordion != blank %}
                                <collapsible-elements class="product__full-width-blocks" data-collapsible-single>
                                    {% assign accordion_text = block.settings.accordion | newline_to_br | split: '<br />' %}
                                    {% for text in accordion_text %}
                                        {% assign pair = text | split: "---" %}
                                        <div class="product__accordion" data-collapsible>
                                            <button class="product__accordion__title" aria-controls="ProductAccordion--page-{{ pair[0] | handle }}--{{ section.id }}--{{ block.id }}" data-collapsible-trigger aria-expanded="false">
                                                {{ pair[0] }}
                                                {%- render 'icon-toggle-plus' -%}
                                                {%- render 'icon-toggle-minus' -%}
                                            </button>
                                            <div class="product__accordion__content" id="ProductAccordion--page-{{ pair[0] | handle }}--{{ section.id }}--{{ block.id }}" data-collapsible-container>
                                                <div class="product__accordion__inner rte" data-collapsible-content>
                                                    {%- render 'toggle-ellipsis', content: pair[1], show_read_more: false -%}
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </collapsible-elements>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
<style>
    #shopify-section-{{ section.id }} collapsible-elements{display:none!important;}
    #shopify-section-{{ section.id }} .multicolumn-custom{background-image:url({{ section.settings.bg_image | image_url: width: 2000 }});background-repeat:no-repeat;background-size:cover;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;}
    #shopify-section-{{ section.id }} h2{--adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ section.settings.heading_size | times: 0.01 }});}
    #shopify-section-{{ section.id }} .multi-items-inner .multi-item{width:calc(50% - 7.5px);display: flex; flex-direction: column;gap:20px;border-radius: 42px;box-shadow: 0 4px 13.9px 0 #D9D9D9;padding:25px 15px;}
    #shopify-section-{{ section.id }} .multi-items-inner .multi-item .image{display: flex; justify-content: center; width: 100px; height: 100px; margin-left: auto; margin-right: auto;}
    #shopify-section-{{ section.id }} .multi-items-inner .multi-item .image img{transition:all 1s ease;height:auto;object-fit:contain;}
    #shopify-section-{{ section.id }} .multi-items-inner .multi-item .image:hover img{transform:scale(1.1);}
    #shopify-section-{{ section.id }} .bottom .cta{margin-top:10px;}
    #shopify-section-{{ section.id }} .product__accordion{border-radius:0;border-bottom:1px solid;}
    #shopify-section-{{ section.id }} .product__accordion__title .icon{width:12px;}
    #shopify-section-{{ section.id }} .flickity-page-dots{display:flex;justify-content:center;position:static;margin-top:20px;}
    #shopify-section-{{ section.id }} .flickity-page-dots .dot{width:100%;}
    @media (min-width: 768px) {
        #shopify-section-{{ section.id }} .multi-items-inner{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;gap:30px;}
        #shopify-section-{{ section.id }} .multi-items-inner .multi-item{gap:30px;padding:45px 30px;}
        #shopify-section-{{ section.id }} .cols-6 .multi-item{width:calc(16.6667% - 30px);}
        #shopify-section-{{ section.id }} .cols-5 .multi-item{width:calc(20% - 30px);}
        #shopify-section-{{ section.id }} .cols-4 .multi-item{width:calc(25% - 30px);}
        #shopify-section-{{ section.id }} .cols-3 .multi-item{width:calc(33.3333% - 30px);}
        #shopify-section-{{ section.id }} .cols-2 .multi-item{width:calc(50% - 30px);}
        #shopify-section-{{ section.id }} .cols-1 .multi-item{width:calc(100% - 30px);}
    }
    @media (max-width: 767px) {
        #shopify-section-{{ section.id }}{overflow:hidden;}
        #shopify-section-{{ section.id }} .flickity-viewport{overflow:initial;}
        #shopify-section-{{ section.id }} .multi-items-inner .multi-item{margin-right:15px;}
        #shopify-section-{{ section.id }} .product__accordion__title{padding:5px 20px 5px 0;}
    }
</style>
<script>
    function equalizeBottomHeight() {
        const bottoms = document.querySelectorAll(
            '.multi-item .bottom .text-{{ section.id }}'
        );
        let maxHeight = 0;

        bottoms.forEach(el => {
            el.style.height = 'auto';
        });

        bottoms.forEach(el => {
            if (el.offsetHeight > maxHeight) {
            maxHeight = el.offsetHeight;
            }
        });

        bottoms.forEach(el => {
            el.style.height = maxHeight + 'px';
        });
    }

    window.addEventListener('load', equalizeBottomHeight);
    window.addEventListener('resize', equalizeBottomHeight);

    !function() {
    "use strict";
        document.addEventListener('DOMContentLoaded', function () {
            if (window.innerWidth <= 767) {
                const slider = document.querySelector('.multi-items-inner--slider-{{ section.id }}');

                if (slider) {
                    let flkty = window.theme.Flickity.data(slider);

                    if (!flkty) {
                        flkty = new window.theme.Flickity(slider, {
                            cellAlign: 'left',
                            contain: true,
                            pageDots: true,
                            prevNextButtons: false,
                            wrapAround: true
                        });
                    }
                }
            }
        });
    }();
</script>
{% schema %}
{
  "name": "Multicolumn Custom #3",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Multicolumn Custom</p>"
    },
    {
        "type": "range",
        "id": "heading_size",
        "label": "Size",
        "min": 50,
        "max": 300,
        "default": 100,
        "step": 5,
        "unit": "%"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Earning points is easy, the more you engage, the more you earn!</p>"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image Column",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "label": "Title",
          "default": "<p>Create an Account</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text</p>"
        },
        {
          "type": "textarea",
          "id": "accordion",
          "label": "Accordion"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn - Custom #3",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}