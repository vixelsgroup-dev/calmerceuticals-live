<link rel="stylesheet" href="{{ 'product-cards-slider.css' | asset_url }}">

{% liquid
  assign pcs_pt_mobile = section.settings.padding_top_mobile | default: 56
  assign pcs_pb_mobile = section.settings.padding_bottom_mobile | default: 56
  assign pcs_pt_desktop = section.settings.padding_top_desktop | default: 60
  assign pcs_pb_desktop = section.settings.padding_bottom_desktop | default: 64
  assign pcs_container_max = section.settings.max_container_width | default: '1440'
  assign pcs_heading_size_mobile = section.settings.heading_font_size_mobile | default: 36
  assign pcs_heading_size_desktop = section.settings.heading_font_size_desktop | default: 52
  if pcs_container_max == 'full'
    assign pcs_container_max_css = 'none'
  else
    assign pcs_container_max_css = pcs_container_max | append: 'px'
  endif
%}

<style>
  #ProductCardsSlider-{{ section.id }} .product-cards-slider__heading {
    font-size: {{ pcs_heading_size_mobile }}px;
  }
  @media (min-width: 768px) {
    #ProductCardsSlider-{{ section.id }} .product-cards-slider__heading {
      font-size: {{ pcs_heading_size_desktop }}px;
    }
  }
</style>

<section
  id="ProductCardsSlider-{{ section.id }}"
  class="product-cards-slider"
  style="
    --pcs-bg: {{ section.settings.background_color }};
    --pcs-heading-line-1: {{ section.settings.heading_line_1_color }};
    --pcs-heading-line-2: {{ section.settings.heading_line_2_color }};
    --pcs-description-color: {{ section.settings.description_color }};
    --pcs-primary-btn-color: {{ section.settings.primary_button_text_color }};
    --pcs-primary-btn-bg: {{ section.settings.primary_button_background_color }};
    --pcs-primary-btn-border: {{ section.settings.primary_button_border_color }};
    --pcs-secondary-btn-color: {{ section.settings.secondary_button_text_color }};
    --pcs-secondary-btn-bg: {{ section.settings.secondary_button_background_color }};
    --pcs-secondary-btn-border: {{ section.settings.secondary_button_border_color }};
    --pcs-card-bg: {{ section.settings.card_background_color }};
    --pcs-card-title: {{ section.settings.card_title_color }};
    --pcs-card-description: {{ section.settings.card_description_color }};
    --pcs-card-button-color: {{ section.settings.card_button_text_color }};
    --pcs-card-button-bg: {{ section.settings.card_button_background_color }};
    --pcs-card-button-border: {{ section.settings.card_button_border_color }};
    --pcs-card-media-placeholder-bg: {{ section.settings.card_media_placeholder_background }};
    --pcs-container-max: {{ pcs_container_max_css }};
    --pcs-pt-mobile: {{ pcs_pt_mobile }}px;
    --pcs-pb-mobile: {{ pcs_pb_mobile }}px;
    --pcs-pt-desktop: {{ pcs_pt_desktop }}px;
    --pcs-pb-desktop: {{ pcs_pb_desktop }}px;
  "
  data-product-cards-slider
  {{ section.shopify_attributes }}
>
  <div class="product-cards-slider__inner wrapper">
    <header class="product-cards-slider__header">
      <div class="product-cards-slider__headline-wrap">
        {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
          <h2 class="product-cards-slider__heading">
            {% if section.settings.heading_line_1 != blank %}
              <span class="product-cards-slider__heading-line product-cards-slider__heading-line--1">
                {{- section.settings.heading_line_1 | escape -}}
              </span>
            {% endif %}
            {% if section.settings.heading_line_2 != blank %}
              <span class="product-cards-slider__heading-line product-cards-slider__heading-line--2">
                {{- section.settings.heading_line_2 | escape -}}
              </span>
            {% endif %}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="product-cards-slider__description product-cards-slider__description--mobile">{{ section.settings.description | escape }}</p>
        {% endif %}

        <div class="product-cards-slider__cta-row">
          {% if section.settings.quiz_label != blank %}
            <a
              class="product-cards-slider__cta product-cards-slider__cta--solid"
              href="{% if section.settings.quiz_link != blank %}{{ section.settings.quiz_link }}{% else %}#{% endif %}"
            >
              <span class="product-cards-slider__cta-dot" aria-hidden="true">{% render 'icon-dot-4' %}</span>
              <span>{{ section.settings.quiz_label | escape }}</span>
              <span class="product-cards-slider__cta-dot" aria-hidden="true">{% render 'icon-dot-4' %}</span>
            </a>
          {% endif %}

          {% if section.settings.products_label != blank %}
            <a
              class="product-cards-slider__cta product-cards-slider__cta--outline"
              href="{% if section.settings.products_link != blank %}{{ section.settings.products_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
            >
              <span class="product-cards-slider__cta-dot" aria-hidden="true">{% render 'icon-dot-4' %}</span>
              <span>{{ section.settings.products_label | escape }}</span>
              <span class="product-cards-slider__cta-dot" aria-hidden="true">{% render 'icon-dot-4' %}</span>
            </a>
          {% endif %}
        </div>
      </div>

      {% if section.settings.description != blank %}
        <p class="product-cards-slider__description product-cards-slider__description--desktop">{{ section.settings.description | escape }}</p>
      {% endif %}
    </header>

    <div
      class="product-cards-slider__viewport"
      id="ProductCardsSliderViewport-{{ section.id }}"
      data-slider-viewport
      tabindex="0"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.heading_line_1 | default: 'Product cards' | escape }}"
    >
      <div class="product-cards-slider__track" data-slider-track>
        {% for block in section.blocks %}
          {% render 'product-cards-slider-card', block: block %}
        {% endfor %}
      </div>
    </div>

    <div class="product-cards-slider__nav">
      <button
        type="button"
        class="product-cards-slider__nav-btn"
        aria-controls="ProductCardsSliderViewport-{{ section.id }}"
        aria-label="Previous slide"
        data-slider-prev
      >
        {% render 'icon-arrow-line-left' %}
      </button>
      <button
        type="button"
        class="product-cards-slider__nav-btn"
        aria-controls="ProductCardsSliderViewport-{{ section.id }}"
        aria-label="Next slide"
        data-slider-next
      >
        {% render 'icon-arrow-line-right' %}
      </button>
    </div>
  </div>
</section>

<script src="{{ 'product-cards-slider.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product cards slider",
  "tag": "section",
  "class": "section-product-cards-slider",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "The right formula"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "for the right need."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From collagen for skin and hair, to adaptogenic support for energy and focus, to targeted solutions for menopause, scalp health, and daily hydration, each product is built for a specific outcome."
    },
    {
      "type": "text",
      "id": "quiz_label",
      "label": "Primary button label",
      "default": "Take the quiz"
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "products_label",
      "label": "Secondary button label",
      "default": "See all products"
    },
    {
      "type": "url",
      "id": "products_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Heading font size"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Spacing & Layout"
    },
    {
      "type": "select",
      "id": "max_container_width",
      "label": "Max container width",
      "options": [
        { "value": "full", "label": "Full width (no max)" },
        { "value": "1100", "label": "1100px" },
        { "value": "1200", "label": "1200px" },
        { "value": "1280", "label": "1280px" },
        { "value": "1320", "label": "1320px" },
        { "value": "1440", "label": "1440px" },
        { "value": "1536", "label": "1536px" },
        { "value": "1600", "label": "1600px" },
        { "value": "1680", "label": "1680px" },
        { "value": "1920", "label": "1920px" }
      ],
      "default": "1440"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#610c27"
    },
    {
      "type": "color",
      "id": "heading_line_1_color",
      "label": "Heading line 1 color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_line_2_color",
      "label": "Heading line 2 color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#dcdcdc"
    },
    {
      "type": "color",
      "id": "primary_button_text_color",
      "label": "Primary button text color",
      "default": "#404f1d"
    },
    {
      "type": "color",
      "id": "primary_button_background_color",
      "label": "Primary button background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary_button_border_color",
      "label": "Primary button border color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_button_text_color",
      "label": "Secondary button text color",
      "default": "#f4ede6"
    },
    {
      "type": "color",
      "id": "secondary_button_background_color",
      "label": "Secondary button background color",
      "default": "#610c27"
    },
    {
      "type": "color",
      "id": "secondary_button_border_color",
      "label": "Secondary button border color",
      "default": "#f4ede6"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#f9f9fb"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_description_color",
      "label": "Card description color",
      "default": "#4d4d4d"
    },
    {
      "type": "color",
      "id": "card_button_text_color",
      "label": "Card button text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_button_background_color",
      "label": "Card button background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_button_border_color",
      "label": "Card button border color",
      "default": "#51111c"
    },
    {
      "type": "color",
      "id": "card_media_placeholder_background",
      "label": "Card media placeholder background",
      "default": "#5f1027"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title_line_1",
          "label": "Title line 1",
          "default": "PeriCalmTM"
        },
        {
          "type": "text",
          "id": "title_line_2",
          "label": "Title line 2",
          "default": "Perimenopause Relief"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Clinically studied ingredients designed to support hormonal balance, sleep quality, and skin resilience in one daily system."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product cards slider",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "title_line_1": "PeriCalmTM",
            "title_line_2": "Perimenopause Relief"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title_line_1": "Ultra Performance",
            "title_line_2": "For Men"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title_line_1": "VERISOL",
            "title_line_2": "Enhanced Marine Collagen"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title_line_1": "Longevity Starts",
            "title_line_2": "In Your Gut"
          }
        }
      ]
    }
  ]
}
{% endschema %}
