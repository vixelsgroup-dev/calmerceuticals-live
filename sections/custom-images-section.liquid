<div class="section-padding">
    <div class="custom-image-section-main wrapper--full-padded">
        <div class="custom-image-section" data-section-id="{{ section.id }}">
            <h2 class="section-heading">{{ section.settings.heading }}</h2>
            <div class="image-gallery">
            {% assign image_limit = 6 %}
            {% assign image_count = 0 %}
            {% for block in section.blocks %}
                {% if image_count < image_limit %}
                <div class="image-item">
                    {% if block.settings.link_url != blank %}
                    <a href="{{ block.settings.link_url | default: '' }}" class="image-link" target="{{ block.settings.link_target }}">
                    {% endif %}
                    {% if block.settings.image != blank %}
                        {{ block.settings.image | image_url: width: 350 | image_tag: alt: block.settings.image.alt, class: 'image' }}
                    {% endif %}
                    {% if block.settings.link_url != blank %}
                    </a>
                    {% endif %}
                </div>
                {% else %}
                <div class="image-item hidden">
                    {% if block.settings.link_url != blank %}
                    <a href="{{ block.settings.link_url | default: '' }}" class="image-link" target="{{ block.settings.link_target }}">
                    {% endif %}
                    {% if block.settings.image != blank %}
                        {{ block.settings.image | image_url: width: 350 | image_tag: alt: block.settings.image.alt, class: 'image' }}
                    {% endif %}
                    {% if block.settings.link_url != blank %}
                    </a>
                    {% endif %}
                </div>
                {% endif %}
                {% assign image_count = image_count | plus: 1 %}
            {% endfor %}
            </div>
            <button class="load-more-btn btn btn--black btn--solid btn--large btn--advanced btn--advanced-width-height btn--bottom" id="load-more-btn" type="button">LOAD MORE</button>
        </div>
    </div>
</div>

<script>
  let imageLimit = 6; // Number of images to load each time
  let totalImages = document.querySelectorAll('.image-item').length;
  let loadedImages = imageLimit;

  document.getElementById('load-more-btn').addEventListener('click', function() {
    let additionalImages = document.querySelectorAll('.image-gallery .image-item.hidden');
    
    if (additionalImages.length > 0) {
      // Show the next set of images
      for (let i = 0; i < imageLimit && i < additionalImages.length; i++) {
        additionalImages[i].classList.remove('hidden');
      }
      loadedImages += imageLimit;

      // Check if we've reached the end
      if (loadedImages >= totalImages) {
        document.getElementById('load-more-btn').textContent = "End of results";
        document.getElementById('load-more-btn').disabled = true;
      }
    }
  });
</script>

<style>
    #shopify-section-{{ section.id }}{--PT: {{ section.settings.padding_top }}px; --PB: {{ section.settings.padding_bottom }}px;}
  .image-gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .image-item {
    width: calc(16.667% - 10px);
    overflow: hidden;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    aspect-ratio: 1 / 1.5; /* Ensure all images have the same height */
  }

  .image-item img {
    max-width: 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-gallery .image-item.hidden {
    display: none;
  }
  .load-more-btn{width:100%;margin-top:10px;}
  .load-more-btn:disabled {
    background-color: #888;
    cursor: not-allowed;
  }
  .section-heading {
    text-align: center;
    font-weight: bold;
    margin-bottom: 20px;
  }
  @media (max-width: 767px) {
    .image-gallery{flex-wrap:wrap;}
    .image-gallery .image-item{width:calc(33.3333% - 10px);}
  }
</style>

{% schema %}
{
  "name": "Custom Images Section",
  "settings": [
    {
      "type": "text",
      "label": "Section Heading",
      "id": "heading",
      "default": "From Our Community"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "label": "Image",
          "id": "image"
        },
        {
          "type": "url",
          "label": "Link URL (Optional)",
          "id": "link_url"
        },
        {
          "type": "radio",
          "label": "Link Target",
          "id": "link_target",
          "options": [
            {
              "value": "_blank",
              "label": "Open in new window"
            },
            {
              "value": "_self",
              "label": "Open in same window"
            }
          ],
          "default": "_self"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Images",
      "category": "Custom"
    }
  ]
}
{% endschema %}