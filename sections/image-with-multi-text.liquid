{% comment %}
  Section: Image With Multi Text
{% endcomment %}

<div class="image-multi-text-main">
  <div class="wrapper section-padding">
    <section class="image-multi-text-section color-{{ section.settings.color_scheme }}">
      <div class="image-multi-text-left">
        {% if section.settings.badge_image != blank %}
          <div class="image-multi-text-image">
            {{ section.settings.badge_image | image_url: width: '400x' | image_tag: loading: lazy }}
          </div>
        {% endif %}
      </div>
      <div class="image-multi-text-content">
        <h2 class="image-multi-text-title">{{ section.settings.title }}</h2>
        <p class="image-multi-text-subtitle">{{ section.settings.subtitle }}</p>
        {% if section.blocks.size > 0 %}
          <div class="image-multi-text-columns">
            {% for block in section.blocks %}
              <div class="image-multi-text-col" {{ block.shopify_attributes }}>
                <h3>{{ block.settings.benefit_title }}</h3>
                <p>{{ block.settings.benefit_text }}</p>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  </div>
</div>

<style>
    #shopify-section-{{ section.id }} .wrapper{--PT: {{ section.settings.padding_top }}px; --PB: {{ section.settings.padding_bottom }}px;}
    #shopify-section-{{ section.id }} .image-multi-text-main{width:100%;}
    #shopify-section-{{ section.id }} .image-multi-text-section{border-radius:28px;padding:40px 56px;display:flex;align-items:center;gap:48px;}
    #shopify-section-{{ section.id }} .image-multi-text-left{flex-shrink:0;display:flex;align-items:center;justify-content:center;}
    #shopify-section-{{ section.id }} .image-multi-text-image{max-width:210px;}
    #shopify-section-{{ section.id }} .image-multi-text-image img{display:block;width:100%;height:auto;}
    #shopify-section-{{ section.id }} .image-multi-text-content{flex:1;min-width:0;}
    #shopify-section-{{ section.id }} .image-multi-text-title{font-weight:600;margin-bottom:10px;}
    #shopify-section-{{ section.id }} .image-multi-text-subtitle{max-width:620px;margin-bottom:32px;}
    #shopify-section-{{ section.id }} .image-multi-text-columns{display:flex;gap:40px;flex-wrap:wrap;}
    #shopify-section-{{ section.id }} .image-multi-text-col{flex:1;min-width:180px;}
    #shopify-section-{{ section.id }} .image-multi-text-col h3{font-weight:600;margin-bottom:10px;}
    @media (max-width:749px){
        #shopify-section-{{ section.id }} .image-multi-text-section{flex-direction:column;padding:32px 24px;text-align:center;}
        #shopify-section-{{ section.id }} .image-multi-text-columns{gap:20px;}
        #shopify-section-{{ section.id }} .image-multi-text-left{margin-bottom:8px;}
        #shopify-section-{{ section.id }} .image-multi-text-image img{max-width:170px;}
    }
</style>

{% schema %}
{
  "name": "Image With Multi Text",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Left badge image"
    },
    {
      "type": "text",
      "id": "badge_image_alt",
      "label": "Badge image alt text",
      "default": "Money back guarantee badge"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Image With Multi Text"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "If you don’t feel a noticeable improvement in drive, stamina, or focus, we’ll refund your purchase. See Terms & Conditions for details."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "benefit_title",
          "label": "Benefit title",
          "default": "Optimize Your Energy"
        },
        {
          "type": "textarea",
          "id": "benefit_text",
          "label": "Benefit text",
          "default": "Feel energized, driven, and ready to take on anything"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Image With Multi Text",
      "category": "Text",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "benefit_title": "Optimize Your Energy",
            "benefit_text": "Feel energized, driven, and ready to take on anything"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "benefit_title": "Sharper Mind",
            "benefit_text": "Get clarity, focus, and control when it matters most"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "benefit_title": "Stronger Body",
            "benefit_text": "Build resilience, power, and performance that lasts"
          }
        }
      ]
    }
  ]
}
{% endschema %}