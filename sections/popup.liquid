<!-- /sections/popups.liquid -->
{%- unless request.path == '/challenge' -%}
  {%- if section.blocks.size > 0 -%}
    <script src="{{ 'popups-component.js' | asset_url }}" defer></script>

    {% if request.design_mode %}
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          if (window.popupEventHandlersAttached) return;
          window.popupEventHandlersAttached = true;

          if (typeof window.POPUP_CONFIGS === 'undefined') {
            window.POPUP_CONFIGS = {
              'popup-bar': {
                selector: '[data-popup-inner]',
                onSelect: (element, popup) => {
                  element.showPopup();
                  popup.classList.add('popup--expanded');
                  popup.classList.add('selected');
                  popup.parentNode.classList.add('has-block-selected');
                  element.resetScrollUnlock();
                  element.scrollLock();
                },
              },
              'popup-large-promo': {
                selector: '[data-popup-inner]',
                onSelect: (element, popup) => {
                  popup.classList.add('selected');
                  popup.parentNode.classList.add('has-block-selected');
                  element.showPopup();
                },
              },
            };
          }

          function onDeselect(popupElement) {
            const config = window.POPUP_CONFIGS[popupElement.tagName.toLowerCase()];
            if (!config) return;

            const popup = popupElement.querySelector(config.selector);
            if (popup) {
              popup.classList.remove('popup--expanded', 'selected');
              popup.parentNode.classList.remove('has-block-selected');
              if (typeof popupElement.hidePopup === 'function') {
                popupElement.hidePopup();
              }
            }
          }

          function handlePopupSelect(event) {
            const target = event.target;

            for (const [tagName, config] of Object.entries(window.POPUP_CONFIGS)) {
              const popupElement = target.closest(tagName);
              if (!popupElement) continue;

              const popup = popupElement.querySelector(config.selector);
              if (popup && !popup.classList.contains('popup--visible')) {
                config.onSelect(popupElement, popup);
              }
              return;
            }
          }

          function handlePopupDeselect(event) {
            const target = event.target;

            for (const tagName of Object.keys(window.POPUP_CONFIGS)) {
              const popupElement = target.closest(tagName);
              if (popupElement) {
                onDeselect(popupElement);
                return;
              }
            }
          }

          document.addEventListener('shopify:block:select', handlePopupSelect);
          document.addEventListener('shopify:block:deselect', handlePopupDeselect);
          document.addEventListener('shopify:section:deselect', handlePopupDeselect);
        });
      </script>
    {% endif %}

    <div data-section-id="{{ section.id }}" data-section-type="popups">
      {%- for block in section.blocks -%}
        {%- liquid
          assign classes = ''
          assign target_url = block.settings.target_url
          assign target_url_enabled = block.settings.target_url_enabled
          assign target_referrer = block.settings.target_referrer
          assign target_referrer_enabled = block.settings.target_referrer_enabled
          assign target_device = block.settings.target_device
          assign target_device_enabled = block.settings.target_device_enabled
          assign image = block.settings.image
          assign image_aspect_ratio = block.settings.image_aspect_ratio
          assign title = block.settings.title
          assign text = block.settings.text
          assign height = block.settings.height
          assign height_mobile = block.settings.height_mobile
          assign bg_color = block.settings.bg_color
          assign position = block.settings.position
          assign button_text = block.settings.button_text

          if target_device_enabled
            if target_device == 'mobile'
              assign classes = classes | append: ' mobile'
            endif

            if target_device == 'desktop'
              assign classes = classes | append: ' desktop'
            endif
          endif

          assign show_popup = true

          if target_url_enabled or target_referrer_enabled
            assign show_popup = false
          endif

          if target_url_enabled and target_url != blank
            if target_url == request.path
              assign show_popup = true
            endif
          endif
        -%}

        {%- capture style -%}
          {%- if bg_color != blank and bg_color != 'rgba(0,0,0,0)' -%}
            --bg: {{ bg_color }};
          {%- endif -%}
        {%- endcapture -%}

        {%- if target_referrer_enabled and target_referrer != blank -%}
          {%- capture target_referrer_attribute -%}
            data-target-referrer="{{ target_referrer }}"
          {%- endcapture -%}

          {%- assign show_popup = true -%}
        {%- endif -%}

        {%- capture block_attributes -%}
          data-block-id="{{ block.id }}"
          data-popup
          data-popup-delay="{{ block.settings.trigger }}"
          {% if style != blank %}
            style="{{ style }}"
          {% endif %}
          {{ target_referrer_attribute }}
          {% if classes != '' %}
            class="{{ classes }}"
          {% endif %}
          {{ block.shopify_attributes }}
        {%- endcapture -%}

        {%- if show_popup -%}
          {%- case block.type -%}
            {%- when 'promo-popup-overlay' -%}
              <popup-large-promo {{ block_attributes }}>
                <div
                  class="popup popup--large promo-popup popup--{% if block.settings.image_desktop != blank or block.settings.image_mobile != blank %}has-image{% else %}no-image{% endif %}"
                  id="popup--{{ block.id }}"
                  data-popup-inner
                >
                  <div class="popup__wrapper popup__wrapper--{{ position }}">
                    <div class="popup__body" data-popup-body>
                      <div class="popup__container">
                        {%- comment -%}SALE ribbons removed{%- endcomment -%}
                        {%- liquid
                          assign image_desktop = block.settings.image_desktop
                          assign image_mobile = block.settings.image_mobile
                          assign fill = true
                          if height == 'original-height' or height_mobile == 'original-height'
                            assign fill = false
                          endif
                        -%}
                        {%- if image_desktop != blank -%}
                          <div class="popup__image {{ height }} {{ height_mobile }} popup__image--desktop">
                            {%- render 'image-fill',
                              is_background: fill,
                              img_object: image_desktop,
                              classes: 'popup__image__img'
                            -%}
                          </div>
                        {%- endif -%}
                        {%- if image_mobile != blank -%}
                          <div class="popup__image {{ height }} {{ height_mobile }} popup__image--mobile">
                            {%- assign sizes = 'min((100vw - 20px), 480px)' -%}
                            {%- render 'image-fill',
                              is_background: fill,
                              img_object: image_mobile,
                              sizes: sizes,
                              classes: 'popup__image__img'
                            -%}
                          </div>
                        {%- endif -%}

                        <div class="popup__content">
                          <div class="popup__inner">
                            <div class="popup__text">
                              {% if block.settings.pre_title != blank %}
                                <h2 class="h5 pre-title">{{ block.settings.pre_title }}</h2>
                              {% endif %}
                              {% if block.settings.sub_title != blank %}
                                <h2 class="h3 sub-title">{{ block.settings.sub_title }}</h2>
                              {% endif %}
                              {% if block.settings.title != blank %}
                                <h2 class="h2 title">{{ block.settings.title }}</h2>
                              {% endif %}
                              {% if block.settings.custom_liquid != blank %}
                                {{ block.settings.custom_liquid }}
                              {% endif %}
                            </div>
                            <div class="actions">
                              <a href="{{ block.settings.button_url }}" class="btn btn--primary btn--solid btn--large">{{ block.settings.button_text }}</a>
                            </div>
                          </div>
                        </div>
                      </div>

                      <button class="popup__close" type="button" data-popup-close>
                        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
                        {%- render 'icon-close' -%}
                      </button>
                    </div>
                    <div class="popup__underlay" data-popup-underlay></div>
                  </div>
                </div>
              </popup-large-promo>
            {%- when 'popup-with-image' -%}
              <popup-large-promo {{ block_attributes }}>
                <div
                  class="popup popup--large popup--{% if image %}has-image{% else %}no-image{% endif %}"
                  id="popup--{{ block.id }}"
                  data-popup-inner
                >
                  <div class="popup__wrapper popup__wrapper--{{ position }}">
                    <div class="popup__body" data-popup-body>
                      <div class="popup__container">
                        {%- if image -%}
                          {%- liquid
                            assign fill = true
                            if height == 'original-height'
                              assign fill = false
                            endif
                          -%}
                          <div class="popup__image {{ height }}">
                            {%- assign sizes = '(min-width: 768px) 370px, min((100vw - 20px), 480px)' -%}
                            {%- render 'image-fill',
                              is_background: fill,
                              img_object: image,
                              sizes: sizes,
                              classes: 'popup__image__img'
                            -%}
                          </div>
                        {%- endif -%}

                        <div class="popup__content">
                          <div class="popup__inner">
                            {%- if title != blank or text != blank -%}
                              <div class="popup__text">
                                {%- unless title == blank -%}
                                  <h3 class="popup__title">{{ title | strip_html | escape }}</h3>
                                {%- endunless -%}

                                {%- unless text == blank -%}
                                  <div class="popup__description rte">{{ text }}</div>
                                {%- endunless -%}
                              </div>
                            {%- endif -%}

                            {%- if block.settings.show_newsletter_form -%}
                              <div class="popup__form">
                                {%- render 'newsletter-form',
                                  unique: block.id,
                                  extra_fields: block.settings.extra_fields,
                                  button_text: button_text,
                                  is_popup: true
                                -%}
                              </div>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>

                      <button class="popup__close" type="button" data-popup-close>
                        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
                        {%- render 'icon-close' -%}
                      </button>
                    </div>

                    <div class="popup__underlay" data-popup-underlay></div>
                  </div>
                </div>
              </popup-large-promo>
            {%- when 'bar' -%}
              <popup-bar {{ block_attributes }}>
                <div
                  class="popup popup--bar popup--bar--{% if image %}has-image{% else %}no-image{% endif %}"
                  id="popup--{{ block.id }}"
                  data-popup-inner
                  data-prevent-scroll-lock
                >
                  <div class="popup__wrapper">
                    <div class="popup__body" data-popup-body>
                      <button
                        class="popup__toggle"
                        type="button"
                        aria-controls="popup--{{ block.id }}"
                        data-popup-bar-toggle
                      >
                        {%- if title != blank or text != blank -%}
                          <span class="popup__toggle__text">
                            {%- if title != blank -%}
                              <strong>{{ title }}</strong>
                            {%- endif -%}

                            {%- if text != blank -%}
                              {{- text -}}
                            {%- endif -%}
                          </span>
                        {%- endif -%}

                        <div class="popup__toggle__icon">
                          {%- render 'icon-toggle-plus' -%}
                          {%- render 'icon-toggle-minus' -%}
                        </div>
                      </button>

                      <button class="popup__close" type="button" data-popup-close>
                        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
                        {%- render 'icon-close' -%}
                      </button>

                      <div class="popup__container">
                        {%- if image != blank -%}
                          <div class="popup__image">
                            {%- assign sizes = '(min-width: 1440px) 360px, (min-width: 1024px) calc((100vw - 120px) * 0.3333), (min-width: 768px) calc((100vw - 40px) * 0.3333), (min-width: 480px) calc((100vw - 40px) * 0.5), calc(100vw - 40px)' -%}
                            {%- assign image_aspect_ratio = 1 | divided_by: image_aspect_ratio -%}
                            {%- render 'image-fill',
                              is_background: false,
                              img_object: image,
                              aspect_ratio: image_aspect_ratio,
                              sizes: sizes,
                              classes: 'popup__image__img'
                            -%}
                          </div>
                        {%- endif -%}

                        <div class="popup__form">
                          {%- render 'newsletter-form',
                            unique: block.id,
                            extra_fields: block.settings.extra_fields,
                            button_text: button_text,
                            is_popup: true
                          -%}
                        </div>
                      </div>
                    </div>

                    <div class="popup__underlay" data-popup-underlay></div>
                  </div>
                </div>
              </popup-bar>
          {%- endcase -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
{%- endunless -%}

<style>
  /* ============================================
     FIX 1: Prevent layout flash on page load
     Hides popup custom elements until JS defines
     them, eliminating the jump/flicker effect
  ============================================ */
  popup-large-promo,
  popup-bar {
    display: none;
  }

  popup-large-promo:defined,
  popup-bar:defined {
    display: block;
  }

  /* ============================================
     FIX 2: Remove SALE ribbons
  ============================================ */
  .promo-popup .sale-ribbon {
    display: none !important;
  }

  /* ============================================
     PROMO POPUP BASE STYLES
  ============================================ */
  .promo-popup .popup__content {
    display: flex;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    text-align: center;
    justify-content: flex-end;
  }

  .promo-popup .popup__content::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 45%;
    background: linear-gradient(to top, rgba(97, 22, 39, 0.7), rgba(97, 22, 39, 0));
    pointer-events: none;
  }

  .promo-popup .popup__content .popup__inner {
    z-index: 1;
  }

  .promo-popup .popup__content *:not(.brand-color) {
    color: #fff;
  }

  .promo-popup .popup__content .brand-color {
    color: #610c27;
  }

  .promo-popup .popup__content .pre-title {
    font-size: 15px;
    text-transform: uppercase;
    font-weight: 100;
    letter-spacing: 0.5em;
  }

  .promo-popup .popup__content .sub-title {
    font-size: 30px;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.5em;
    margin-bottom: 10px;
  }

  .promo-popup .popup__content .custom-heading {
    font-size: 70px;
    font-weight: 700;
    line-height: 70px;
    text-transform: uppercase;
    margin-bottom: 15px;
  }

  .promo-popup .bottom-line small {
    text-transform: uppercase;
    letter-spacing: 0.3em;
  }

  .promo-popup .popup__body {
    overflow: hidden;
  }

  .promo-popup .actions a {
    font-size: 20px;
    font-weight: 700;
    padding: 10px 20px;
    min-width: 240px;
    border-radius: 30px;
    outline: none;
  }

  .promo-popup .actions a:focus {
    outline: none;
  }

  /* ============================================
     DESKTOP / MOBILE IMAGE SWITCHING
  ============================================ */
  .popup__image--mobile {
    display: none;
  }

  @media (max-width: 767px) {
    .popup__image--desktop {
      display: none;
    }
    .popup__image--mobile {
      display: block;
    }
  }

  /* ============================================
     RESPONSIVE
  ============================================ */
  @media (min-width: 768px) {
    .promo-popup .popup__body {
      max-width: 850px;
    }
  }

  @media (max-width: 767px) {
    .promo-popup .popup__content .popup__inner {
      padding-bottom: 50px;
    }
  }
</style>

