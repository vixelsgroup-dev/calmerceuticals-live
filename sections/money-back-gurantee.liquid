{% comment %}
  SECTION: Money Back Guarantee
  - Card (not full width, rounded corners, gradient bg)
  - Left: badge/stamp image
  - Right: heading + description + 3 feature columns
  - Font: Jost
{% endcomment %}

<style>
  #mbg-{{ section.id }} {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    background: transparent;
  }

  /* ── Card (not full width) ── */
  #mbg-{{ section.id }} .mbg-card {
    background: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_pad_v }}px {{ section.settings.card_pad_h }}px;
    display: flex;
    align-items: center;
    gap: {{ section.settings.badge_gap }}px;
    margin: 0 {{ section.settings.card_margin }}px;
  }

  /* ── Left: Badge image ── */
  #mbg-{{ section.id }} .mbg-badge {
    flex-shrink: 0;
    width: {{ section.settings.badge_size }}px;
    height: {{ section.settings.badge_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #mbg-{{ section.id }} .mbg-badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ── Right: Content ── */
  #mbg-{{ section.id }} .mbg-content {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.content_gap }}px;
    flex: 1;
  }

  /* Top: heading + description */
  #mbg-{{ section.id }} .mbg-top {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: {{ section.settings.top_gap }}px;
  }

  #mbg-{{ section.id }} .mbg-heading {
    font-family: "Jost", sans-serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  #mbg-{{ section.id }} .mbg-desc,
  #mbg-{{ section.id }} .mbg-desc p {
    font-family: "Jost", sans-serif;
    font-size: {{ section.settings.desc_size }}px;
    font-weight: 400;
    color: {{ section.settings.desc_color }};
    line-height: 1.6;
    margin: 0;
  }

  /* Bottom: 3 feature columns */
  #mbg-{{ section.id }} .mbg-features {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: {{ section.settings.feature_gap }}px;
  }

  #mbg-{{ section.id }} .mbg-feature__title {
    font-family: "Jost", sans-serif;
    font-size: {{ section.settings.feature_title_size }}px;
    font-weight: {{ section.settings.feature_title_weight }};
    color: {{ section.settings.feature_title_color }};
    margin: 0 0 8px;
    line-height: 1.2;
  }

  #mbg-{{ section.id }} .mbg-feature__body,
  #mbg-{{ section.id }} .mbg-feature__body p {
    font-family: "Jost", sans-serif;
    font-size: {{ section.settings.feature_body_size }}px;
    font-weight: 400;
    color: {{ section.settings.feature_body_color }};
    line-height: 1.55;
    margin: 0;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 767px) {
    .text-center-mobile{text-align: center;}
    #mbg-{{ section.id }}{padding-top: 36px; padding-bottom : 0;}
    #mbg-{{ section.id }} .mbg-card {
      flex-direction: column;
      align-items: center;
      margin: 0;
      padding: 32px 35px;
      gap: 48px;
    }
    #mbg-{{ section.id }} .mbg-features {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    #mbg-{{ section.id }} .mbg-heading {
      font-size: {{ section.settings.heading_size | times: 0.75 | round }}px;
    }
  }
</style>

<section id="mbg-{{ section.id }}">
  <div class="{% if section.settings.container_width %}wrapper{% endif %}">
    <div class="mbg-card">

      {%- comment -%} ── Badge Image ── {%- endcomment -%}
      {%- if section.settings.badge_image != blank -%}
        <div class="mbg-badge">
          {{ section.settings.badge_image | image_url: width: 300 | image_tag: loading: 'eager', alt: section.settings.badge_image.alt }}
        </div>
      {%- endif -%}

      {%- comment -%} ── Content ── {%- endcomment -%}
      <div class="mbg-content">

        {%- comment -%} Heading + Description ── {%- endcomment -%}
        <div class="mbg-top">
          {%- if section.settings.heading != blank -%}
            <p class="mbg-heading {% if section.settings.text_center_mobile %} text-center-mobile {% endif %}">{{ section.settings.heading }}</p>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <div class="mbg-desc {% if section.settings.text_center_mobile %} text-center-mobile {% endif %}">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>

        {%- comment -%} ── 3 Feature Columns ── {%- endcomment -%}
        <div class="mbg-features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="mbg-feature" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <p class="mbg-feature__title {% if section.settings.text_center_mobile %} text-center-mobile {% endif %}">{{ block.settings.title }}</p>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="mbg-feature__body {% if section.settings.text_center_mobile %} text-center-mobile {% endif %}">{{ block.settings.body }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Money Back Guarantee",
  "tag": "section",
  "class": "section-money-back-guarantee",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "checkbox",
      "id": "container_width",
      "label": "Enable Container (wrapper)",
      "default": true
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Section Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Section Padding Bottom",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_margin",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "label": "Card Side Margin",
      "default": 0
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color_background",
      "id": "card_bg",
      "label": "Card Background",
      "default": "linear-gradient(to right, #3d0a1e 0%, #8b1a3a 100%)"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0, "max": 32, "step": 2, "unit": "px",
      "label": "Card Border Radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_pad_v",
      "min": 16, "max": 80, "step": 4, "unit": "px",
      "label": "Card Padding (Top & Bottom)",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_pad_h",
      "min": 16, "max": 100, "step": 4, "unit": "px",
      "label": "Card Padding (Left & Right)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Badge Image"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge / Stamp Image"
    },
    {
      "type": "range",
      "id": "badge_size",
      "min": 60, "max": 200, "step": 4, "unit": "px",
      "label": "Badge Size",
      "default": 120
    },
    {
      "type": "range",
      "id": "badge_gap",
      "min": 16, "max": 80, "step": 4, "unit": "px",
      "label": "Gap Between Badge & Content",
      "default": 40
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Money Back Guarantee"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16, "max": 48, "step": 1, "unit": "px",
      "label": "Heading Font Size",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Font Weight",
      "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>If you don't feel a noticeable improvement in drive, stamina, or focus, we'll refund your purchase. See Terms & Conditions for details.</p>"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#e8c8d0"
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 11, "max": 18, "step": 1, "unit": "px",
      "label": "Description Font Size",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "text_center_mobile",
      "label": "Content Text Center In Mobile",
      "default" : false
    },
    {
      "type": "range",
      "id": "top_gap",
      "min": 8, "max": 40, "step": 4, "unit": "px",
      "label": "Gap Below Description (before features)",
      "default": 20
    },
    {
      "type": "header",
      "content": "Feature Columns"
    },
    {
      "type": "range",
      "id": "feature_gap",
      "min": 8, "max": 60, "step": 4, "unit": "px",
      "label": "Gap Between Features",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 8, "max": 48, "step": 4, "unit": "px",
      "label": "Gap Between Top & Features",
      "default": 20
    },
    {
      "type": "color",
      "id": "feature_title_color",
      "label": "Feature Title Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "feature_title_size",
      "min": 12, "max": 28, "step": 1, "unit": "px",
      "label": "Feature Title Font Size",
      "default": 16
    },
    {
      "type": "select",
      "id": "feature_title_weight",
      "label": "Feature Title Font Weight",
      "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "color",
      "id": "feature_body_color",
      "label": "Feature Body Color",
      "default": "#e8c8d0"
    },
    {
      "type": "range",
      "id": "feature_body_size",
      "min": 11, "max": 18, "step": 1, "unit": "px",
      "label": "Feature Body Font Size",
      "default": 13
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Optimize Your Energy"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Feature Body",
          "default": "<p>Feel energized, driven, and ready to take on anything</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Money Back Guarantee",
      "blocks": [
        { "type": "feature", "settings": { "title": "Optimize Your Energy", "body": "<p>Feel energized, driven, and ready to take on anything</p>" } },
        { "type": "feature", "settings": { "title": "Sharper Mind", "body": "<p>Get clarity, focus, and control when it matters most</p>" } },
        { "type": "feature", "settings": { "title": "Stronger Body", "body": "<p>Build resilience, power, and performance that lasts</p>" } }
      ]
    }
  ]
}
{% endschema %}
