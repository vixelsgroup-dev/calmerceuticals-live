{% schema %}
{
  "name": "Product pages",
  "class": "shopify-section--product",
  "settings": [
    {
      "type": "header",
      "content": "Product description"
    },
    {
      "type": "checkbox",
      "id": "product_sticky_enable",
      "label": "Enable sticky form",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "addtocart_sticky_enable",
      "label": "Enable addtocart sticky",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_layout",
      "label": "Desktop layout",
      "options": [
        {"value": "grid", "label": "Grid"},
        {"value": "stacked", "label": "Stacked"},
        {"value": "carousel", "label": "Carousel with thumbnails"}
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "options": [
        {"value": "standard", "label": "Standard"},
        {"value": "large", "label": "Large"}
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "product_image_aspect_ratio",
      "label": "Equal image aspect ratio",
      "default": false,
      "info": "Set products in the ‘Grid’ layout to the same aspect ratio"
    },
    {
      "type": "header",
      "content": "Media",
      "info": "Learn more about [media types](https://help.shopify.com/manual/products/product-media)"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Enable video looping",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Page width"}
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "product_video",
      "name": "Product Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Upload Video"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title and price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show price",
          "default": true
        },
        {
          "type": "select",
          "id": "subheading",
          "label": "Navigation",
          "default": "breadcrumbs",
          "options": [
            {"value": "none", "label": "None"},
            {"value": "breadcrumbs", "label": "Breadcrumbs"},
            {"value": "collection", "label": "Collection"},
            {"value": "vendor", "label": "Vendor"}
          ]
        },
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Title size",
          "default": 100,
          "min": 70,
          "max": 150,
          "step": 5,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "price_size",
          "label": "Price size",
          "default": 100,
          "min": 70,
          "max": 150,
          "step": 5,
          "unit": "%"
        },
        {
          "type": "checkbox",
          "id": "bold_price",
          "label": "Bold product price",
          "default": false
        },
        {
          "type": "header",
          "content": "Block spacing"
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 50,
          "step": 2,
          "unit": "px",
          "label": "Padding bottom",
          "default": 20
        }
      ]
    },
    {
      "name": "Form",
      "type": "form",
      "limit": 1,
      "settings": [
        {
          "type": "header",
