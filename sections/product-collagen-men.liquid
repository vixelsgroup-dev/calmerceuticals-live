        },
        {
          "type": "number",
          "id": "limit_text",
          "label": "Limit number of lines (desktop)",
          "default": 10
        },
        {
          "type": "number",
          "id": "limit_text_mobile",
          "label": "Limit number of lines (mobile)",
          "default": 12
        },
        {
          "type": "header",
          "content": "Block spacing"
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 50,
          "step": 2,
          "unit": "px",
          "label": "Padding bottom",
