          "content": "Subscriptions",
          "info": "Learn more about [subscriptions](https://help.shopify.com/en/manual/products/subscriptions)"
        },
        {
          "type": "checkbox",
          "id": "enable_subscriptions_selectors",
          "label": "Enable subscription selectors",
          "info": "Shown on products with subscription options",
          "default": true
        },
        {
          "type": "select",
          "id": "subscriptions_cards_style",
          "label": "Subscription selector styles",
          "options": [
            {
              "label": "Stack",
              "value": "stack"
            },
            {
              "label": "Cards",
              "value": "cards"
            }
          ],
          "default": "stack"
        },
        {
          "type": "header",
          "content": "Block spacing"
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 50,
          "step": 2,
          "unit": "px",
          "label": "Padding bottom",
          "default": 20
        }
      ]
    },
    {
      "name": "Product description",
