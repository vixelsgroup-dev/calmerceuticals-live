{% comment %}
  Section: FAQ – You Probably Have Some Questions
  - Cream bg, left blue border
  - Two columns: left = heading + body + button, right = accordion FAQ
  - Active item: thick burgundy top border + × icon
  - Closed items: thin grey divider + + icon
  - Dynamic blocks for FAQ items
{% endcomment %}

{%- assign uid = section.id -%}

<section
  class="faq-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  "
>
  <div class="faq-section__inner {% if section.settings.container_width %}wrapper{% endif %}">
    <!-- LEFT COLUMN -->
    <div class="faq-section__left">
      {%- if section.settings.heading != blank -%}
        <div class="faq-section__heading">
          {{ section.settings.heading }}
        </div>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <div class="faq-section__body">
          {{ section.settings.body_text }}
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link }}"
          class="faq-section__btn"
          style="background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text_color }};"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <!-- RIGHT COLUMN: Accordion -->
    <div class="faq-section__right" id="faqAccordion--{{ uid }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          {%- assign is_first = false -%}
          {%- if forloop.first -%}{%- assign is_first = true -%}{%- endif -%}
          <div
            class="faq-item{% if is_first %} faq-item--open{% endif %}"
            data-faq-item
            {{ block.shopify_attributes }}
          >
            <button
              class="faq-item__trigger"
              data-faq-trigger
              aria-expanded="{% if is_first %}true{% else %}false{% endif %}"
            >
              <span
                class="faq-item__question"
                style="color: {{ section.settings.question_color }}; font-size: {{ section.settings.question_size }}px;"
              >
                {{ block.settings.question }}
              </span>
              <span class="faq-item__icon" aria-hidden="true">
                <span class="faq-item__icon-plus">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <line x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </span>
                <span class="faq-item__icon-close">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <line x1="2" y1="2" x2="12" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="12" y1="2" x2="2" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </span>
              </span>
            </button>
            <div class="faq-item__answer" data-faq-answer>
              <div class="faq-item__answer-inner">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .faq-section{width:100%;box-sizing:border-box;}
  .faq-section__inner{display:grid;grid-template-columns:1fr 1.85fr;gap:60px;align-items:start;padding:0 32px;margin:0 auto;}
  .faq-section__left{max-width: 300px; display:flex;flex-direction:column;gap:20px;position:sticky;top:40px;}
  .faq-section__heading>*{font-family: "Jost"; font-weight:400;color:{{ section.settings.heading_color }};font-size:{{ section.settings.heading_size }}px;line-height:{{ section.settings.heading_size }}px;margin:0;letter-spacing:-1.2px;}
  .faq-section__heading p{margin:0;}
  .faq-section__body>*{font-weight: 400; font-family: "Jost"; line-height:calc({{ section.settings.body_size }}px + 5px);color:{{ section.settings.body_color }};font-size:{{ section.settings.body_size }}px;}
  .faq-section__body p{margin:0;}
  .faq-section__btn{font-family: "Jost"; display:inline-block;padding:13px 26px;border-radius:100px;font-size:13px;font-weight:600;text-decoration:none;transition:opacity 0.2s ease;align-self:flex-start;}
  .faq-section__btn:hover{opacity:0.85;}
  .faq-section__right{display:flex;flex-direction:column;}
  .faq-item{border-top:1.5px solid {{ section.settings.divider_color }};transition:border-color 0.2s ease;}
  .faq-item--open{border-top:3px solid {{ section.settings.active_border_color }};}
  .faq-item__trigger{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 0;background:none;border:none;cursor:pointer;text-align:left;}
  .faq-item__question{font-weight: 600; font-family: "Jost"; font-weight:400;line-height:1.4;flex:1;}
  .faq-item__icon{width:32px;height:32px;border-radius:50%;border:1.5px solid {{ section.settings.icon_border_color }};display:flex;align-items:center;justify-content:center;flex-shrink:0;color:{{ section.settings.icon_color }};transition:border-color 0.2s;}
  .faq-item__icon-plus,.faq-item__icon-close{display:flex;align-items:center;justify-content:center;line-height:0;}
  .faq-item__icon-close{display:none;}
  .faq-item__icon-plus{display:flex;}
  .faq-item--open .faq-item__icon-close{display:flex;}
  .faq-item--open .faq-item__icon-plus{display:none;}
  .faq-item__answer{overflow:hidden;height:0;transition:height 0.32s cubic-bezier(0.4,0,0.2,1);}
  .faq-item__answer-inner>*{font-weight: 400; font-family: "Jost"; padding-bottom:20px;color:{{ section.settings.answer_color }};font-size:{{ section.settings.answer_size }}px;line-height:calc({{ section.settings.answer_size }}px + 5px);}
  .faq-item__answer-inner p{margin:0 0 10px 0;}
  .faq-item__answer-inner p:last-child{margin:0;}

  @media screen and (max-width:767px){
      .faq-section__inner{grid-template-columns:1fr;gap:36px; padding:0 16px;}
      .faq-section__left{position:static;}
  }
</style>

<script>
  (function () {
    function initFAQ() {
      var accordion = document.getElementById('faqAccordion--{{ uid }}');
      if (!accordion) return;

      var items = accordion.querySelectorAll('[data-faq-item]');

      function setHeight(answer, inner) {
        answer.style.height = inner.scrollHeight + 'px';
      }

      function openItem(item) {
        var answer = item.querySelector('[data-faq-answer]');
        var inner = item.querySelector('.faq-item__answer-inner');
        var trigger = item.querySelector('[data-faq-trigger]');
        item.classList.add('faq-item--open');
        trigger.setAttribute('aria-expanded', 'true');
        setHeight(answer, inner);
      }

      function closeItem(item) {
        var answer = item.querySelector('[data-faq-answer]');
        var trigger = item.querySelector('[data-faq-trigger]');
        answer.style.height = answer.scrollHeight + 'px';
        item.classList.remove('faq-item--open');
        trigger.setAttribute('aria-expanded', 'false');
        // Force reflow then animate to 0
        answer.getBoundingClientRect();
        answer.style.height = '0px';
      }

      // Init first item — use scrollHeight, no rAF needed
      items.forEach(function (item) {
        if (item.classList.contains('faq-item--open')) {
          var inner = item.querySelector('.faq-item__answer-inner');
          var answer = item.querySelector('[data-faq-answer]');
          answer.style.height = inner.scrollHeight + 'px';
        }
      });

      items.forEach(function (item) {
        var trigger = item.querySelector('[data-faq-trigger]');
        if (!trigger) return;

        trigger.addEventListener('click', function () {
          var isOpen = item.classList.contains('faq-item--open');
          items.forEach(function (el) { closeItem(el); });
          if (!isOpen) { openItem(item); }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFAQ);
    } else {
      initFAQ();
    }
  })();
</script>
{% schema %}
{
  "name": "FAQ Section",
  "tag": "section",
