{% comment %}
  SECTION: Ultra Ingredient Reveal
  - Full-width top: eyebrow + heading + body
  - Two columns: left = product image (desktop) / mobile image, right = ingredient accordion
  - Each block: icon + name + +/- toggle | expands description below
  - Button has separate mobile label
{% endcomment %}

<style>
  #uir-{{ section.id }} { background: {{ section.settings.section_bg }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; font-family: "Jost", sans-serif; }
  #uir-{{ section.id }} .uir-inner { display: flex; flex-direction: column; }

  /* ── Header ── */
  #uir-{{ section.id }} .uir-header { display: flex; flex-direction: column; gap: 26px; margin-bottom: 96px; }
  #uir-{{ section.id }} .uir-eyebrow { display: flex; align-items: center; gap: 10px; }
  #uir-{{ section.id }} .it-section__eyebrow-dash { color: {{ section.settings.eyebrow_color }}; font-size: 24px; }
  #uir-{{ section.id }} .uir-eyebrow .eyebrow-text { font-family: "Jost", sans-serif; font-size: {{ section.settings.eyebrow_size }}px; font-weight: 500; color: {{ section.settings.eyebrow_color }}; margin: 0; line-height: 1.4; }
  #uir-{{ section.id }} .uir-heading, #uir-{{ section.id }} .uir-heading p { font-family: "Jost", sans-serif; font-size: {{ section.settings.heading_size }}px; font-weight: {{ section.settings.heading_weight }}; color: {{ section.settings.heading_color }}; line-height: 1.15; margin: 0;  }
  #uir-{{ section.id }} .uir-heading strong, #uir-{{ section.id }} .uir-heading b { font-weight: 700; color: {{ section.settings.heading_color }}; }
  #uir-{{ section.id }} .uir-body, #uir-{{ section.id }} .uir-body p { font-family: "Jost", sans-serif; font-size: {{ section.settings.body_size }}px; font-weight: 400; color: {{ section.settings.body_color }}; line-height: 1.7; margin: 0; max-width: 680px; }
  #uir-{{ section.id }} .uir-body p + p { margin-top: 10px; }

  /* ── Two Columns ── */
  #uir-{{ section.id }} .uir-cols { display: grid; grid-template-columns: 1fr 1fr; gap: {{ section.settings.col_gap }}px; align-items: start; }

  /* ── Left: Image ── */
  #uir-{{ section.id }} .uir-image-col { width: 100%; height: 100%; }
  #uir-{{ section.id }} .uir-image-wrap { border-radius: {{ section.settings.image_radius }}px; overflow: hidden; width: 100%; height: 100%; }
  #uir-{{ section.id }} .uir-image-wrap img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center; }
  #uir-{{ section.id }} .uir-image-placeholder { width: 100%; aspect-ratio: 3 / 4; background: #ddd; display: flex; align-items: center; justify-content: center; border-radius: {{ section.settings.image_radius }}px; }
  #uir-{{ section.id }} .uir-img-desktop { display: block; }
  #uir-{{ section.id }} .uir-img-mobile { display: none; }

  /* ── Right: Ingredient List ── */
  #uir-{{ section.id }} .uir-list-col { display: flex; flex-direction: column; }

  /* ── Badge ── */
  #uir-{{ section.id }} .uir-badge { font-family: "Jost", sans-serif; display: inline-block; padding: 6px 16px; border-radius: 8px; font-size: {{ section.settings.badge_size }}px; font-weight: 500; letter-spacing: 0.5px; color: {{ section.settings.badge_text_color }}; background: {{ section.settings.badge_bg }}; border: 1px solid {{ section.settings.badge_border_color }}; align-self: flex-start; margin-bottom: {{ section.settings.badge_gap }}px; }

  /* ── Divider ── */
  #uir-{{ section.id }} .uir-divider { height: 1px; width: 100%; background: {{ section.settings.divider_color }}; }

  /* ── Accordion Item ── */
  #uir-{{ section.id }} .uir-ingredient { display: flex; align-items: center; gap: {{ section.settings.row_gap }}px; padding: {{ section.settings.row_padding }}px 0; cursor: pointer; user-select: none; }
  #uir-{{ section.id }} .uir-ingredient__icon { flex-shrink: 0; width: 58px; height: 42px; display: flex; align-items: center; justify-content: center; }
  #uir-{{ section.id }} .uir-ingredient__icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #uir-{{ section.id }} .uir-ingredient__name { font-family: "Jost", sans-serif; font-size: {{ section.settings.ingredient_name_size }}px; font-weight: {{ section.settings.ingredient_name_weight }}; color: {{ section.settings.ingredient_name_color }}; line-height: 1.3; flex: 1; }
  #uir-{{ section.id }} .uir-ingredient__toggle { flex-shrink: 0; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 300; color: {{ section.settings.ingredient_name_color }}; line-height: 1; transition: transform 0.25s ease; }

  /* ── Accordion body ── */
  #uir-{{ section.id }} .uir-accordion-body { overflow: hidden; max-height: 0; transition: max-height 0.35s ease, padding 0.25s ease; padding-bottom: 0; }
  #uir-{{ section.id }} .uir-accordion-body.is-open { max-height: 400px; padding-bottom: {{ section.settings.row_padding }}px; }
  #uir-{{ section.id }} .uir-accordion-desc, #uir-{{ section.id }} .uir-accordion-body p { font-family: "Jost", sans-serif; font-size: {{ section.settings.ingredient_sub_size }}px; font-weight: 400; color: {{ section.settings.ingredient_sub_color }}; line-height: 1.65; margin: 0; }

  /* ── Button ── */
  #uir-{{ section.id }} .uir-btn { margin-top: {{ section.settings.btn_gap }}px; font-family: "Jost", sans-serif; display: inline-flex; align-items: center; justify-content: center; width: 100%; border-radius: 6px; font-size: {{ section.settings.btn_font_size }}px; font-weight: 400; letter-spacing: 1.3px; text-transform: uppercase; text-decoration: none; color: {{ section.settings.btn_text_color }}; background: {{ section.settings.btn_bg }}; min-width: 414px; max-width: 414px; height: 53px; }
  #uir-{{ section.id }} .uir-btn-mobile { display: none; }
  #uir-{{ section.id }} .uir-btn-desktop { display: inline; }
  .button__bottom_text { color: {{ section.settings.bottom_text_color }}; font-size: 18px; font-weight: 500; margin-top: 24px; font-family: "Jost", sans-serif; }

  /* ── Responsive ── */
  @media screen and (max-width: 767px) {
    #uir-{{ section.id }} { padding-top: {{ section.settings.padding_top | divided_by: 2 }}px; padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px; }
    #uir-{{ section.id }} .uir-header { margin-bottom: 32px; }
    #uir-{{ section.id }} .uir-heading, #uir-{{ section.id }} .uir-heading p { font-size: 48px; letter-spacing: 0; }
    #uir-{{ section.id }} .uir-body{display: none;}
    #uir-{{ section.id }} .uir-cols { grid-template-columns: 1fr; gap: 32px; }
    #uir-{{ section.id }} .uir-image-col { max-width: 360px; margin: 0 auto; }
    #uir-{{ section.id }} .uir-img-desktop { display: none; }
    #uir-{{ section.id }} .uir-img-mobile { display: block; }
    #uir-{{ section.id }} .uir-btn { min-width: unset; max-width: 100%; letter-spacing: 0; }
    #uir-{{ section.id }} .uir-btn-desktop { display: none; }
    #uir-{{ section.id }} .uir-btn-mobile { display: inline; }
  }
</style>

<section id="uir-{{ section.id }}">
  <div class="uir-inner {% if section.settings.container_width %}wrapper{% endif %}">

    {%- comment -%} ── Header ── {%- endcomment -%}
    <div class="uir-header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="uir-eyebrow">
          <span class="it-section__eyebrow-dash">—</span>
          <span class="eyebrow-text">{{ section.settings.eyebrow }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <div class="uir-heading">{{ section.settings.heading }}</div>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <div class="uir-body">{{ section.settings.body_text }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Two Columns ── {%- endcomment -%}
    <div class="uir-cols">

      {%- comment -%} ── Left: Product Image (desktop + mobile) ── {%- endcomment -%}
      <div class="uir-image-col">
        <div class="uir-image-wrap">
          {%- if section.settings.product_image != blank -%}
            <span class="uir-img-desktop">
              {{ section.settings.product_image | image_url: width: 800 | image_tag: loading: 'eager', alt: section.settings.product_image.alt }}
            </span>
          {%- endif -%}
          {%- if section.settings.mobile_image != blank -%}
            <span class="uir-img-mobile">
              {{ section.settings.mobile_image | image_url: width: 800 | image_tag: loading: 'eager', alt: section.settings.mobile_image.alt }}
            </span>
          {%- elsif section.settings.product_image != blank -%}
            <span class="uir-img-mobile">
              {{ section.settings.product_image | image_url: width: 800 | image_tag: loading: 'eager', alt: section.settings.product_image.alt }}
            </span>
          {%- else -%}
            <div class="uir-image-placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ── Right: Accordion Ingredient List ── {%- endcomment -%}
      <div class="uir-list-col">

        {%- if section.settings.badge_label != blank -%}
          <div class="uir-badge">{{ section.settings.badge_label }}</div>
        {%- endif -%}

        {%- assign ingredient_blocks = section.blocks | where: 'type', 'ingredient' -%}

        {%- if ingredient_blocks.size > 0 -%}
          <div class="uir-divider"></div>

          {%- for block in ingredient_blocks -%}
            {%- assign has_desc = false -%}
            {%- if block.settings.subtitle != blank -%}
              {%- assign has_desc = true -%}
            {%- endif -%}

            <div class="uir-accordion-item" {{ block.shopify_attributes }}>
              <div class="uir-ingredient" {% if has_desc %}data-accordion-trigger aria-expanded="false"{% endif %}>
                {%- if block.settings.icon != blank -%}
                  <div class="uir-ingredient__icon">
                    {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.icon.alt }}
                  </div>
                {%- elsif section.settings.show_icon_placeholder -%}
                  <div class="uir-ingredient__icon" style="background: #eee; border-radius: 4px;"></div>
                {%- endif -%}
                <div class="uir-ingredient__name">{{ block.settings.name }}</div>
                {%- if has_desc -%}
                  <div class="uir-ingredient__toggle">+</div>
                {%- endif -%}
              </div>

              {%- if has_desc -%}
                <div class="uir-accordion-body">
                  <div class="uir-accordion-desc">{{ block.settings.subtitle }}</div>
                </div>
              {%- endif -%}
            </div>

            <div class="uir-divider"></div>
          {%- endfor -%}
        {%- endif -%}

        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link }}" class="uir-btn">
            <span class="uir-btn-desktop">{{ section.settings.btn_label }}</span>
            <span class="uir-btn-mobile">{{ section.settings.btn_label_mobile | default: section.settings.btn_label }}</span>
          </a>
        {%- endif -%}

        {%- if section.settings.button_bottom_text != blank -%}
          <div class="button__bottom-text">
            <p class="button__bottom_text">{{ section.settings.button_bottom_text }}</p>
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    var section = document.getElementById('uir-{{ section.id }}');
    if (!section) return;
    var triggers = section.querySelectorAll('[data-accordion-trigger]');
    triggers.forEach(function(trigger) {
      trigger.addEventListener('click', function() {
        var item = trigger.closest('.uir-accordion-item');
        var body = item.querySelector('.uir-accordion-body');
        var toggleIcon = trigger.querySelector('.uir-ingredient__toggle');
        var isOpen = body.classList.contains('is-open');
        section.querySelectorAll('.uir-accordion-body.is-open').forEach(function(openBody) { openBody.classList.remove('is-open'); });
        section.querySelectorAll('[data-accordion-trigger]').forEach(function(t) {
          var icon = t.querySelector('.uir-ingredient__toggle');
          if (icon) icon.textContent = '+';
          t.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          body.classList.add('is-open');
          toggleIcon.textContent = '−';
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Ultra Ingredient Reveal",
  "tag": "section",
  "class": "section-ultra-ingredient-reveal",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    { "type": "checkbox", "id": "container_width", "label": "Enable Container (wrapper)", "default": true },
    { "type": "color", "id": "section_bg", "label": "Section Background", "default": "#f4f3f1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "header_gap", "min": 16, "max": 100, "step": 4, "unit": "px", "label": "Gap Between Header & Columns", "default": 56 },
    { "type": "range", "id": "col_gap", "min": 16, "max": 100, "step": 4, "unit": "px", "label": "Gap Between Image & List", "default": 56 },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "Radical Transparency" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow Color", "default": "#7a5060" },
    { "type": "range", "id": "eyebrow_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Eyebrow Font Size", "default": 13 },
    {
      "type": "header",
      "content": "Heading"
    },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Simple ingredients,<br><strong>powerful results.</strong></p>" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#1a0d10" },
    { "type": "range", "id": "heading_size", "min": 24, "max": 72, "step": 2, "unit": "px", "label": "Heading Font Size", "default": 48 },
    { "type": "select", "id": "heading_weight", "label": "Heading Font Weight", "default": "500", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi Bold" }, { "value": "700", "label": "Bold" }] },
    {
      "type": "header",
      "content": "Body Text"
    },
    { "type": "richtext", "id": "body_text", "label": "Body Text", "default": "<p>We believe you deserve to see the exact strains, doses, and clinical trial matches behind every sachet. No proprietary blends. No hiding.</p>" },
    { "type": "color", "id": "body_color", "label": "Body Text Color", "default": "#4a3a3e" },
    { "type": "range", "id": "body_size", "min": 11, "max": 20, "step": 1, "unit": "px", "label": "Body Font Size", "default": 15 },
    {
      "type": "header",
      "content": "Product Image"
    },
    { "type": "image_picker", "id": "product_image", "label": "Product Image (Desktop)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Product Image (Mobile)", "info": "If left empty, the desktop image will be used on mobile too" },
    { "type": "range", "id": "image_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Image Border Radius", "default": 12 },
    {
      "type": "header",
      "content": "Ingredient List Badge"
    },
    { "type": "text", "id": "badge_label", "label": "Badge Label", "default": "Active Ingredients" },
    { "type": "color", "id": "badge_bg", "label": "Badge Background", "default": "#D4DCCF" },
    { "type": "color", "id": "badge_text_color", "label": "Badge Text Color", "default": "#3A3D38" },
    { "type": "color", "id": "badge_border_color", "label": "Badge Border Color", "default": "#b8c4b2" },
    { "type": "range", "id": "badge_size", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Badge Font Size", "default": 12 },
    { "type": "range", "id": "badge_gap", "min": 8, "max": 40, "step": 4, "unit": "px", "label": "Gap Below Badge", "default": 16 },
    {
      "type": "header",
      "content": "Ingredient Rows"
    },
    { "type": "color", "id": "divider_color", "label": "Divider Color", "default": "#d4c5c9" },
    { "type": "range", "id": "row_padding", "min": 8, "max": 32, "step": 2, "unit": "px", "label": "Row Vertical Padding", "default": 16 },
    { "type": "range", "id": "row_gap", "min": 8, "max": 32, "step": 2, "unit": "px", "label": "Gap Between Icon & Name", "default": 16 },
    { "type": "checkbox", "id": "show_icon_placeholder", "label": "Show Placeholder if No Icon", "default": true },
    { "type": "color", "id": "ingredient_name_color", "label": "Ingredient Name Color", "default": "#1a0d10" },
    { "type": "range", "id": "ingredient_name_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Ingredient Name Font Size", "default": 15 },
    { "type": "select", "id": "ingredient_name_weight", "label": "Ingredient Name Font Weight", "default": "500", "options": [{ "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi Bold" }] },
    { "type": "color", "id": "ingredient_sub_color", "label": "Description Text Color", "default": "#4a3a3e" },
    { "type": "range", "id": "ingredient_sub_size", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Description Font Size", "default": 14 },
    {
      "type": "header",
      "content": "Button"
    },
    { "type": "text", "id": "btn_label", "label": "Button Label (Desktop)", "default": "START YOUR REJUVENATION" },
    { "type": "text", "id": "btn_label_mobile", "label": "Button Label (Mobile)", "info": "Leave blank to use the desktop label" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "color_background", "id": "btn_bg", "label": "Button Background", "default": "radial-gradient(93.96% 93.96% at 54.14% 82.02%, #8A4C5B 0%, #170D0F 100%)" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#ffffff" },
    { "type": "range", "id": "btn_font_size", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Button Font Size", "default": 14 },
    { "type": "range", "id": "btn_gap", "min": 8, "max": 48, "step": 4, "unit": "px", "label": "Gap Above Button", "default": 24 },
    { "type": "text", "id": "button_bottom_text", "label": "Bottom Text" },
    { "type": "color", "id": "bottom_text_color", "label": "Bottom Text Color", "default": "#545454" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Ingredient Icon Image" },
        { "type": "text", "id": "name", "label": "Ingredient Name", "default": "Fermented Shilajit" },
        { "type": "textarea", "id": "subtitle", "label": "Description (accordion content)", "info": "If filled, a +/- toggle appears and this text expands on click" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ultra Ingredient Reveal",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Fermented Shilajit", "subtitle": "Traditionally used for vitality and general wellness, Shilajit provides natural minerals and adaptogenic compounds that support everyday energy and resilience." } },
        { "type": "ingredient", "settings": { "name": "Nettle Leaf" } },
        { "type": "ingredient", "settings": { "name": "L-Theanine", "subtitle": "An amino acid found naturally in green tea that promotes calm, focused energy without drowsiness." } },
        { "type": "ingredient", "settings": { "name": "Theobroma Cacao" } },
        { "type": "ingredient", "settings": { "name": "Cultavit® B-Complex Vitamins" } },
        { "type": "ingredient", "settings": { "name": "Maca Root" } },
        { "type": "ingredient", "settings": { "name": "VERISOL® Bovine Collagen with Hydrolysed Marine Collagen (Types I, II & III)" } },
        { "type": "ingredient", "settings": { "name": "Zinc & Vitamin D3" } },
        { "type": "ingredient", "settings": { "name": "Punica Granatum (Pomegranate)" } }
      ]
    }
  ]
}
{% endschema %}
