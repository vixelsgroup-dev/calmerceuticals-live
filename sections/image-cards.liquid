{% comment %}
  Section: Image Cards - with mobile slider
  Desktop: grid (unchanged)
  Mobile: Flickity slider, 1 card at a time, prev/next arrows below
{% endcomment %}

{%- assign section_uid = section.id -%}

<section class="wis-section" style="
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.background_color }};
">
<div class="inner {% if section.settings.container_width %}wrapper {% endif %}">
  <div class="wis-section__header">

    {%- if section.settings.heading != blank -%}
      <h2 class="wis-section__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <div class="wis-section__subtext">
        {{ section.settings.subtext }}
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} Image Grid (desktop) / Slider (mobile) {%- endcomment -%}
  <div class="wis-section__grid" id="wisSlider--{{ section_uid }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'image_card' -%}
        <div class="wis-section__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | img_url: '600x700', crop: 'center' }}"
              alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
              class="wis-section__card-img"
              loading="lazy"
              width="600"
              height="700"
            >
          {%- else -%}
            <div class="wis-section__card-placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          {%- if block.settings.label != blank -%}
            <div class="wis-section__card-label {% if section.settings.text_alignment %} text-center {% endif %}" style="color: {{ section.settings.label_text_color }};">
              {{ block.settings.label }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Mobile-only prev/next arrows {%- endcomment -%}
  <div class="wis-section__mobile-arrows" id="wisArrows--{{ section_uid }}">
    <button class="wis-section__arrow wis-section__arrow--prev" aria-label="Previous" data-slider="{{ section_uid }}">
      <img src="{{ 'left-arrow.png' | file_url }}" alt="Previous" width="40" height="40" loading="lazy" >
    </button>
    <button class="wis-section__arrow wis-section__arrow--next" aria-label="Next" data-slider="{{ section_uid }}">
      <img src="{{ 'right-arrow.png' | file_url }}" alt="Previous" width="40" height="40" loading="lazy" >
    </button>
  </div>

  {%- comment -%} CTA + footnote {%- endcomment -%}
  <div class="wis-section__footer">
    <div class="wis_section-btn-group">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="wis-section__btn wis-section__main-btn">
          <span class="wis-btn-desktop">{{ section.settings.button_label }}</span>
          <span class="wis-btn-mobile">
            {%- if section.settings.mobile_button_label != blank -%}
              {{ section.settings.mobile_button_label }}
            {%- else -%}
              {{ section.settings.button_label }}
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}

      {%- if section.settings.secondary_button_label != blank -%}
        <a
          href="{{ section.settings.secondary_button_link }}"
          class="wis-section__secondary_btn wis-section__main-btn"
        >
          {{ section.settings.secondary_button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="wis-section__footnote" style="color: {{ section.settings.subtext_color }};">
        {{ section.settings.footnote }}
      </p>
    {%- endif -%}
  </div>
  </div>
</section>

<style>
.wis-section{width:100%;box-sizing:border-box;}
.wis-section__header{margin:0 auto;padding:0 24px;text-align:center;margin-bottom:28px;}
.wis-section__heading{margin:0 0 14px 0;}
.wis-section__heading>*{font-family: "Jost"; margin: 0; color:{{ section.settings.heading_color }};font-size:{{ section.settings.heading_size }}px;font-weight:500;line-height:120%;letter-spacing:-0.5px;}
.wis-section__heading strong,.wis-section__heading b{font-weight:500;}
.wis-section__subtext > *{font-family: "Jost"; font-size:20px;line-height:120%;margin:0;font-weight:400;color:{{ section.settings.subtext_color }};}
.wis-section__grid{display:grid;grid-template-columns:repeat({{ section.blocks | map: 'type' | where: 'image_card' | size | default: 4 }},1fr);gap:15px;width:100%;padding: 0 var(--gutter);}
.wis-section__card{position:relative;overflow:hidden;border-radius:8px; min-height: 480px;}
.wis-section__card-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.4s ease;}
.wis-section__card:hover .wis-section__card-img{transform:scale(1.03);}
.wis-section__card-placeholder{width:100%;height:100%;background:#e0dcd8;display:flex;align-items:center;justify-content:center;}
.wis-section__card-placeholder svg{width:60%;height:60%;opacity:0.3;}
.wis-section__card-label{z-index:1; position:absolute;bottom:16px;left:12px;background:rgba(255,255,255,0.30);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-radius:8px;padding:10px 15px;max-width:90%;width:100%;border:1px solid rgba(255,255,255,0.25);}
.wis-section__card-label>*{font-size:22px;font-weight:500;line-height:1.3;margin:15px 0; font-family: "Jost";}
.wis-section__card-label.text-center > *{text-align:center;}
.wis-section__footer{margin:0 auto;padding:32px 24px 0;display:flex;flex-direction:column;align-items:center;gap:34px;}
.wis_section-btn-group{flex-wrap:wrap;display: flex; justify-content: center; align-items: center; gap: 10px;}
.wis-section__main-btn{min-width: 410px; text-align: center; height: 53px; display: flex; justify-content: center; align-items: center;}
.wis-section__btn{font-family: "Jost"; border-radius:100px;font-size:16px;letter-spacing:0%;text-transform:uppercase;font-weight:400;text-decoration:none;transition:opacity 0.2s ease;background:{{ section.settings.button_bg }};color:{{ section.settings.button_text_color }};}
.wis-section__secondary_btn{font-family: "Jost";  border-radius:100px;font-size:16px;letter-spacing:0%;text-transform:uppercase;font-weight:400;text-decoration:none;transition:opacity 0.2s ease;background: transparent ;color:#8A4C5B; border: 1px solid #610C27;}
.wis-section__footnote{font-size:17px;text-align:center;margin:0;line-height:1.5;}
.wis-section__mobile-arrows{display:none;}
.wis-section__card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 60%; background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.40) 100%); border-radius: 16px; }
.wis-btn-mobile { display: none; }
.wis-btn-desktop { display: inline; }
@media screen and (max-width:767px){
  .wis-btn-desktop { display: none; }
  .wis-btn-mobile { display: inline; }
  .wis-section__grid{display:block;overflow:hidden; padding: 0 var(--gutter-mobile);}
  .wis-section__card{width:100%;aspect-ratio:3/4;border-radius:8px;margin-right:15px;}
  .wis-section__card-label>*{font-size:20px;}
  .wis-section__heading>*{font-size:30px;line-height:30px;}
  .wis-section__heading br{display: none;}
  .wis-section__heading strong{margin-left: 10px;}
  .wis-section__mobile-arrows{display:flex;justify-content:center;align-items:center;gap:12px;margin-top:20px;}
  .wis-section__arrow{width:44px;height:44px;border-radius:50%;border:1.5px solid rgba(0,0,0,0.18);background:rgba(255,255,255,0.9);display:flex;align-items:center;justify-content:center;cursor:pointer;color:#333;transition:background 0.2s,border-color 0.2s;}
  .wis-section__arrow:hover{background:#fff;border-color:rgba(0,0,0,0.35);}
  .wis-section__arrow:disabled{opacity:0.3;cursor:default;}
  #wisSlider--{{ section_uid }} 
  .flickity-page-dots,#wisSlider--{{ section_uid }} 
  .flickity-prev-next-button{display:none !important;}}
  .wis-section__main-btn{min-width: 350px;}
</style>

<script>
(function() {
  function initWisSlider() {
    if (window.innerWidth > 767) return;

    var slider = document.getElementById('wisSlider--{{ section_uid }}');
    var prevBtn = document.querySelector('#wisArrows--{{ section_uid }} .wis-section__arrow--prev');
    var nextBtn = document.querySelector('#wisArrows--{{ section_uid }} .wis-section__arrow--next');

    if (!slider) return;

    // Check if Flickity is available (from theme)
    var Flickity = window.theme && window.theme.Flickity ? window.theme.Flickity : (window.Flickity || null);

    if (Flickity) {
      // Use Flickity
      var flkty = new Flickity(slider, {
        cellAlign: 'left',
        contain: true,
        pageDots: false,
        prevNextButtons: false,
        wrapAround: false,
        draggable: true
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function() { flkty.previous(); });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function() { flkty.next(); });
      }

    } else {
      // Fallback: custom drag slider (no Flickity needed)
      var cards = slider.querySelectorAll('.wis-section__card');
      var total = cards.length;
      var currentIndex = 0;
      var startX = 0;
      var isDragging = false;
      var didDrag = false;

      slider.style.display = 'flex';
      slider.style.transition = 'transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94)';
      slider.style.willChange = 'transform';

      function getCardWidth() {
        return cards[0] ? cards[0].offsetWidth + 15 : slider.offsetWidth;
      }

      function goTo(index) {
        currentIndex = Math.max(0, Math.min(total - 1, index));
        slider.style.transform = 'translateX(-' + (currentIndex * getCardWidth()) + 'px)';
      }

      // Touch swipe
      slider.addEventListener('touchstart', function(e) {
        startX = e.touches[0].pageX;
        didDrag = false;
      }, { passive: true });

      slider.addEventListener('touchend', function(e) {
        var dx = e.changedTouches[0].pageX - startX;
        if (Math.abs(dx) > 40) {
          if (dx < 0) goTo(currentIndex + 1);
          else goTo(currentIndex - 1);
        }
      }, { passive: true });

      if (prevBtn) {
        prevBtn.addEventListener('click', function() { goTo(currentIndex - 1); });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function() { goTo(currentIndex + 1); });
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWisSlider);
  } else {
    initWisSlider();
  }
})();
</script>

{% schema %}
{
  "name": "Image Cards",
  "tag": "section",
  "class": "section-wis",
  "settings": [
    {
      "type": "header",
      "content": "Spacing & Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "container_width",
      "label": "Max Container Width",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f2f0ee"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#5c1a2e"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext & Footnote Color",
      "default": "#6b6060"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Image Label Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "button_bg",
      "label": "Button Background",
      "default": "linear-gradient(135deg, #3d1020, #6b1f2e)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading (use <strong> for bold word)",
      "default": "<p>When inflammation stays<br><strong>elevated</strong></p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 40
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext (below heading)",
      "default": "<p>cellular repair declines, metabolic balance falters, and biological ageing accelerates </p>"
    },
    {
      "type": "header",
      "content": "Button & Footnote"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "START YOUR REJUVENATION"
    },
    {
      "type": "text",
      "id": "mobile_button_label",
      "label": "Button Label (Mobile)",
      "info": "Leave blank to use the same label as desktop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
     {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote Text",
      "default": "Formulated with clinically researched bio-fermented polyphenols and triple-biotic synergy."
    },
    {
      "type": "checkbox",
      "id": "text_alignment",
      "default": false,
      "label": "Text Center"
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "label",
          "label": "Label Text",
          "default": "<p>Repair slows</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Cards",
      "blocks": [
        {
          "type": "image_card",
          "settings": { "label": "<p>Repair slows</p>" }
        },
        {
          "type": "image_card",
          "settings": { "label": "<p>Metabolic efficiency drops</p>" }
        },
        {
          "type": "image_card",
          "settings": { "label": "<p>Cognitive clarity declines</p>" }
        },
        {
          "type": "image_card",
          "settings": { "label": "<p>Ageing accelerates</p>" }
        }
      ]
    }
  ]
}
{% endschema %}
