{% comment %}
  Section: Available Flavours
  - Light bg, optional left accent border
  - Heading top-left
  - Dynamic image cards in a row, each with white label bottom-left
  - Uses checkbox wrapper approach for container width
{% endcomment %}

<section class="af-section" style="
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.background_color }};
">
  <div class="af-section__inner {% if section.settings.container_width %}wrapper{% endif %}">

    <!-- Heading -->
    {%- if section.settings.heading != blank -%}
      <h2 class="af-section__heading" style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_size }}px;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <!-- Cards Grid -->
    <div class="af-section__grid" style="gap: {{ section.settings.card_gap }}px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'flavour_card' -%}
          <div class="af-section__card" style="border-radius: {{ section.settings.card_radius }}px;" {{ block.shopify_attributes }}>

            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | img_url: '900x700', crop: 'center' }}"
                alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
                class="af-section__card-img"
                loading="lazy"
                width="900"
                height="700"
              >
            {%- else -%}
              <div class="af-section__card-placeholder"></div>
            {%- endif -%}
            <!-- Label -->
            {%- if block.settings.label != blank -%}
              <div class="af-section__card-label" style="color: {{ section.settings.label_color }}; font-size: {{ section.settings.label_size }}px;">
                {{ block.settings.label }}
              </div>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
.af-section{width:100%;box-sizing:border-box;}
.af-section__inner{display:flex;flex-direction:column;gap:44px;}
.af-section__heading{font-family:"Jost" ; font-weight:500;line-height:1.2;margin:0;letter-spacing:-0.3px;}
.af-section__heading p{margin:0;}
.af-section__grid{display:grid;grid-template-columns:repeat({{ section.blocks | size | default: 2 }},1fr);width:100%;}
.af-section__card{position:relative;overflow:hidden; min-height: 630px;}
.af-section__card-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.4s ease;}
.af-section__card:hover .af-section__card-img{transform:scale(1.03);}
.af-section__card-placeholder{width:100%;height:100%;background:linear-gradient(135deg,#c8d0e0,#a0b0c8);}
.af-section__card-label{font-family:"Jost" ; position:absolute;font-weight:500;line-height:1.2;letter-spacing:-0.2px;z-index:2;padding:24px 18px;overflow:hidden;width:100%;left:0;padding-left:36px;bottom:0;background: rgba(0, 0, 0, 0.3); backdrop-filter: blur(6px);-webkit-backdrop-filter:blur(6px);}

@media screen and (max-width:767px){
  .af-section__grid{grid-template-columns:repeat(2,1fr);}
  .af-section__card{height: 350px; min-height: 350px;}
  .af-section__heading{font-size: 34px !important; line-height: 34px;}
  .af-section__card-label{font-size: 20px !important; padding: 9px 30px !important;}
}
</style>

{% schema %}
{
  "name": "Available Flavours",
  "tag": "section",
  "class": "section-af",
  "settings": [
    {
      "type": "header",
      "content": "Spacing & Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "container_width",
      "label": "Enable Max Container Width",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f0ede8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a0d10"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Card Label Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 28
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Card Label Font Size",
      "default": 22
    },
    {
      "type": "header",
      "content": "Cards"
    },
    
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Cards",
      "default": 16
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Available Flavours"
    }
  ],
  "blocks": [
    {
      "type": "flavour_card",
      "name": "Flavour Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Flavour Label",
          "default": "Watermelon Crush"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Available Flavours",
      "blocks": [
        {
          "type": "flavour_card",
          "settings": {
            "label": "Watermelon Crush"
          }
        },
        {
          "type": "flavour_card",
          "settings": {
            "label": "Pink Lemonade"
          }
        }
      ]
    }
  ]
}
{% endschema %}