{% comment %}
  Section: Three Column Steps (Nourish / Replenish / Repair)
  - White bg, blue dotted top + bottom border
  - 3 equal columns: icon top, title + number on same row with line, body text
  - Fully dynamic blocks
{% endcomment %}

<section class="tcs-section" style="
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.background_color }};
">
  <div class="tcs-section__inner {% if section.settings.container_width %}wrapper {% endif %}">
    <div class="tcs-section__grid">

      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <div class="tcs-section__col" {{ block.shopify_attributes }}>

            <!-- Icon -->
            <div class="tcs-section__icon">
             {%- if block.settings.icon_image != blank -%}
                <img src="{{ block.settings.icon_image | img_url: '100x100' }}" alt="Icon" />
            {%- else -%}
                <!-- Default placeholder icon -->
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {%- endif -%}
            </div>

            <!-- Title row: title left, number right, line between -->
            <div class="tcs-section__title-row">
              <span class="tcs-section__title" style="color: {{ section.settings.title_color }}; font-size: {{ section.settings.title_size }}px;">
                {{ block.settings.title }}
              </span>
              <span class="tcs-section__number" style="color: {{ section.settings.number_color }}; font-size: {{ section.settings.number_size }}px;">
                {{ block.settings.number }}
              </span>
            </div>

            <!-- Body -->
            {%- if block.settings.body != blank -%}
              <div class="tcs-section__body" >
                {{ block.settings.body }}
              </div>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>
</section>

<style>
.tcs-section { width: 100%; box-sizing: border-box; }

.tcs-section__inner { margin: 0 auto; }

.tcs-section__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: {{ section.settings.col_gap }}px; }

/* COLUMN */
.tcs-section__col { display: flex; flex-direction: column; gap: 14px; }

/* ICON */
.tcs-section__icon { display: flex; align-items: center; height: 32px; }

.tcs-section__icon img { display: block; }

/* TITLE ROW */
.tcs-section__title-row { display: flex; align-items: center; gap: 12px; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid rgba(184, 184, 184, 1); }

.tcs-section__title {font-family:"Jost" ; font-weight: 500; white-space: nowrap; flex-shrink: 0; line-height: 1; }

.tcs-section__title-line { flex: 1; height: 1px; opacity: 0.2; }

.tcs-section__number { font-weight: 400; white-space: nowrap; flex-shrink: 0; opacity: 0.5; line-height: 1; }

/* BODY */
.tcs-section__body > * {width: 350px; font-family: "Jost"; margin: 0; line-height: 1.65; font-weight: 500;color: {{ section.settings.body_color }}; font-size: {{ section.settings.body_size }}px;  }

/* RESPONSIVE */
@media screen and (max-width: 768px) {
.tcs-section__grid { grid-template-columns: 1fr; gap: 36px; }
.tcs-section__inner { padding: 0 20px; }
}
</style>

{% schema %}
{
  "name": "Three Column Steps",
  "tag": "section",
  "class": "section-tcs",
  "settings": [
    {
      "type": "header",
      "content": "Spacing & Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "container_width",
      "label": "Max Container Width",
      "default": true
    },

    {
      "type": "range",
      "id": "col_gap",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap Between Columns",
      "default": 56
    },
    {
      "type": "header",
      "content": "Colors & Typography"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a0d10"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number Color",
      "default": "#1a0d10"
    },
    {
      "type": "range",
      "id": "number_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Number Font Size",
      "default": 13
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#4a3a3e"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Body Font Size",
      "default": 13
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Column",
      "settings": [
        {
        "type": "image_picker",
        "id": "icon_image",
        "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Nourish"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body Text",
          "default": "<p>Biofermented polyphenols from olives, tea, and cocoa create the precise gut environment for centenarian strains to thrive and proliferate.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three Column Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Nourish",
            "number": "01",
            "body": "<p>Biofermented polyphenols from olives, tea, and cocoa create the precise gut environment for centenarian strains to thrive and proliferate.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Replenish",
            "number": "02",
            "body": "<p>Centenarian-sourced strains—Akkermansia, Lactobacillus longevitas, and Faecalibacterium—delivered via ViaCap™ to ensure 95% colon survivability.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Repair",
            "number": "03",
            "body": "<p>Fermentation-derived metabolites including short-chain fatty acids and urolithins reinforce the gut barrier and trigger mitophagy for cellular renewal.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
